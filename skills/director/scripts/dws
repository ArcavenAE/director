    rn.add_argument("seat")
    rn.add_argument("note", choices=RING_NOTES)
    rn.add_argument("--text")
    rn.set_defaults(fn=cmd_ring_note)

    rs2 = sub.add_parser("rings", help="read rings.jsonl per seat (K14)")
    rs2.add_argument("--json", action="store_true")
    rs2.set_defaults(fn=cmd_rings)

    gc = sub.add_parser("grant-card", help="render the Desk card that shows a draft grant's bounds (K10)")
    gc.add_argument("id")
    gc.add_argument("--out")
    gc.set_defaults(fn=cmd_grant_card)

    gf = sub.add_parser("grant-confirm", help="record a grant as confirmed once its card is answered (K10)")
