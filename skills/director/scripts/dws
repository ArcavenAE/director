    rc2.add_argument("--json", action="store_true")
    rc2.add_argument("--out", help="the proposals file (default $DIRECTOR_STATE/reconcile-proposals.json)")
    rc2.set_defaults(fn=cmd_reconcile)

    dc = sub.add_parser("decision", help="record a seat decision and its answer (D1); actor director")
    ds = dc.add_subparsers(dest="op", required=True)
    da = ds.add_parser("add", help="parse one seat-decision@1 block and append it as decided-by-seat")
    da.add_argument("--from", dest="from_", required=True, metavar="FILE")
    da.set_defaults(fn=cmd_decision_add)
    dh = ds.add_parser("actual", help="record the actual seat-hours and where the figure came from")
    dh.add_argument("id")
    dh.add_argument("--hours", required=True)
    dh.add_argument("--source", required=True)
    dh.set_defaults(fn=cmd_decision_actual)
    for op, fn in (("confirm", cmd_decision_confirm), ("override", cmd_decision_override)):
        dm = ds.add_parser(op, help=f"record the operator's {op} of a decided-by-seat decision")
        dm.add_argument("id")
        dm.add_argument("--words", required=True, help="the operator's words, stored as given")
        dm.add_argument("--ref", required=True, help="the relay id the answer came in")
        if op == "override":
            dm.add_argument("--instead", required=True, help="what the operator chose instead")
        dm.set_defaults(fn=fn)
    dr = ds.add_parser("rework", help="mark an overridden decision reworked")
    dr.add_argument("id")
    dr.set_defaults(fn=cmd_decision_rework)

    dp = ds.add_parser("paths", help="record two paths at once for a card that waits on the operator (card 6)")
    dp.add_argument("id")
    dp.add_argument("--card", required=True)
    dp.add_argument("--evidence", required=True)
    dp.add_argument("--why-waiting", dest="why_waiting", required=True)
    for k in ("a", "b"):
        dp.add_argument(f"--row-{k}", dest=f"row_{k}", required=True)
        dp.add_argument(f"--estimate-{k}", dest=f"estimate_{k}", required=True)
        dp.add_argument(f"--test-{k}", dest=f"test_{k}", required=True)
    dp.set_defaults(fn=cmd_decision_paths)
    dk = ds.add_parser("pick", help="the evidence picked a path: paths-open to decided-by-seat")
    dk.add_argument("id")
    dk.add_argument("--winner", required=True)
    dk.add_argument("--result", required=True, help="where the loser's lessons went in the winner's PR notes")
    dk.set_defaults(fn=cmd_decision_pick)
    dw = ds.add_parser("withdraw", help="the operator ruled for neither path: paths-open to withdrawn")
    dw.add_argument("id")
    dw.add_argument("--words", required=True)
    dw.add_argument("--ref", required=True)
    dw.set_defaults(fn=cmd_decision_withdraw)

    dl = sub.add_parser("decisions", help="list seat decisions; --daily prints the daily line; writes nothing (D1)")
    dl.add_argument("--json", action="store_true")
    dl.add_argument("--unconfirmed", action="store_true", help="decided-by-seat only, in card 4's order")
    dl.add_argument("--daily", action="store_true", help="the trial's daily line and the unconfirmed list")
    dl.add_argument("--trial-start", dest="trial_start", metavar="YYYY-MM-DD", help="the trial's first day, for --daily")
    dl.set_defaults(fn=cmd_decisions)

    mg = sub.add_parser("migrate-blocked-none", help="clear the stored blocked values of none; one marked set per row, last moved untouched; --dry-run writes nothing")
    mg.add_argument("--dry-run", action="store_true")
    mg.set_defaults(fn=cmd_migrate_blocked_none)

    pg = sub.add_parser("page", help="render the ledger as a self-contained HTML page to stdout or --out; reads the ledger and the Desk snapshot, writes only --out (W3)")
    pg.add_argument("--out", help="write the page here (temp file and rename) instead of stdout")
    pg.add_argument("--theme", help="file inserted verbatim at the top of the body (default $DIRECTOR_STATE/page-theme.css.html)")
    pg.add_argument("--nav", help="file inserted verbatim after the theme (default $DIRECTOR_STATE/page-nav.html)")
    pg.add_argument("--desk-url", help="file holding the Desk page address that a card id links to (default $DIRECTOR_STATE/page-desk-url); {id} in it is replaced, else #id is added")
    pg.set_defaults(fn=cmd_page)

    pk = sub.add_parser("picks", help="print the ready picks from a page export that were not reported before, and record them in picks-seen.jsonl (W3)")
    pk.add_argument("--file", required=True, help="JSON list of the picks docs, as the Artifact data tool returns them")
    pk.set_defaults(fn=cmd_picks)

    mh = sub.add_parser("merge-hold", help="exit 1 with the reason when a row linking the PR waits on an unconfirmed decision; read only (D2)")
    mh.add_argument("pr", metavar="OWNER/REPO#N")
    mh.set_defaults(fn=cmd_merge_hold)

    a, extra = p.parse_known_args(argv)
    if extra and not (a.cmd == "record" and a.kind == "exclusion"):
        p.error("unrecognized arguments: " + " ".join(extra))
    try:
        a.fn(a)
    except Refused as err:
        print(f"dws: refused: {err}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
