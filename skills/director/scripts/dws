    o.add_argument("--stage", default="idea")
    o.add_argument("--repos", nargs="+")
    o.add_argument("--next")
    o.add_argument("--blocked")
    o.add_argument("--ask")
    o.add_argument("--link", nargs="+")
    o.set_defaults(fn=cmd_open)

    s = sub.add_parser("stage")
    s.add_argument("slug")
    s.add_argument("to")
    s.add_argument("--from", dest="from_", required=True)
    s.set_defaults(fn=cmd_stage)

    k = sub.add_parser("park")
    k.add_argument("slug")
    k.add_argument("--from", dest="from_", required=True)
    k.set_defaults(fn=cmd_park)

    t = sub.add_parser("set")
    t.add_argument("slug")
    t.add_argument("--owner")
    t.add_argument("--next")
    t.add_argument("--blocked")
    t.add_argument("--ask")
    t.add_argument("--repos", nargs="+")
    t.add_argument("--waits", action="append", metavar="decision:ID|ask:CARD", help="the row waits on a seat decision (D2, held to the window) or an open Desk card (K13)")
    t.add_argument("--unwait", action="append", metavar="decision:ID", help="drop a decision edge; refused before the decision is answered (D2)")
    t.set_defaults(fn=cmd_set)

    ik = sub.add_parser("intake", help="record an operator ask and print its ask id (I-<n>)")
    ik.add_argument("--text-file", required=True, help="the ask text, verbatim: a path, or - for stdin")
