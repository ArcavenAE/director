#!/usr/bin/env python3
"""dws - director workstreams: the board's current-state ledger.

One row per workstream (an issue, a design and its builds), folded on read
from an append-only event file. Part W1 of the workstream ledger design
(sim/design/board-workstream-ledger.md): the store, the fold, the lock, the
CLI and the instance-id refusal; W2 adds refresh. The page (W3) comes later.

  $DIRECTOR_STATE/workstreams.jsonl   append-only events
  $DIRECTOR_STATE/workstreams.lock    one flock around fold, check, append

  dws [--actor A] open <slug> --title T [--owner O] [--stage S] [--repos R..]
                                       [--next N] [--blocked B [--ask ID]] [--link L..]
  dws [--actor A] stage <slug> <to> --from <current>
  dws [--actor A] set <slug> [--owner O] [--next N] [--blocked B [--ask ID]] [--repos R..]
  dws [--actor A] link <slug> [--remove] <link>...
  dws [--actor A] park <slug> --from <current>
  dws refresh [<slug>...]
  dws show [--json]

Links are typed: pr:<owner>/<repo>#<n>, issue:<owner>/<repo>#<n>, bd:<id>
and ask:<id>. refresh (W2) reads the first three; ask ids wait for W5, and an
untyped link is shown but never read. refresh names every link it does not
read on stderr, so nothing is skipped silently.

K13: `--blocked operator` needs `--ask <card id>`, and refuses unless that card is
open in a Desk snapshot no older than THRESHOLD_HOURS["desk snapshot"] hours. A
session reads the Desk and runs `desk-snapshot write`; without a usable snapshot
dws refuses and says UNREAD, and never takes the id on faith. The card goes on the
row as an ask: link.

K8: every new event carries "tag", set by dws from the actor and never by a caller:
mirror for refresh (a cited outside fact), judgment for director. proposal is
defined for the reconciler (K11) and refused on append to workstreams.jsonl until it has a
writer (a draft grant in rulings.jsonl carries it). A line
with no tag, or a value that is not a tag, folds as untagged and is never repaired.
show --json counts events by tag per row (since the row was last opened) and ledger-wide
(every event line, including one for a slug with no row); nothing gates on it.

K9: `record ruling|grant|term` appends to rulings.jsonl (the file merge-guard reads for
exclusions; MERGE_GUARD_RULINGS names it, default $DIRECTOR_STATE/rulings.jsonl), under
its own rulings.lock beside it. It never creates the file, refuses the exclusion kind
(the operator's, R-153) and any actor but director, and stores text as given.
`records [--json]` folds the file: replaces is an explicit id pointer; a target is marked
replaced_by, and a pointer to a missing id or another kind is counted, never guessed.

The actor is a claim, not an identity: the writer table is an allowlist over
--actor, and a caller that passes --actor refresh is believed (section 6).
"""
import argparse, datetime, fcntl, json, os, re, subprocess, sys, time, unicodedata

HOME = os.path.expanduser("~")
STATE = os.environ.get("DIRECTOR_STATE") or f"{HOME}/.director/state"
LEDGER = os.path.join(STATE, "workstreams.jsonl")
LOCK = os.path.join(STATE, "workstreams.lock")
LOCK_TIMEOUT = 5.0
SNAPSHOT = os.path.join(STATE, "desk-snapshot.json")

# K13: hours a Desk snapshot may age before dws reads it as UNREAD (finding-
# director-glst; the table of the automation boundary, ADR-007). A diagnostic
# bound, not a gate on anything else. The operator changes it here.
THRESHOLD_HOURS = {"desk snapshot": 24}

# Section 3. The order is the sort order; parked sorts last.
STAGES = ["idea", "defined", "designed", "building", "in review", "merged",
          "released", "deployed", "accepted", "parked"]

# Section 6, the writer table. refresh may append observe events and the two
# factual stage moves of section 5; anything not listed may append nothing.
REFRESH_MOVES = {("building", "in review"), ("in review", "merged")}
ACTORS = {"director", "refresh"}

# K8: every new event carries a tag that dws sets itself from the actor; no
# caller passes one. mirror is a cited outside fact (refresh), judgment is
# director's own call. proposal (needs a confirm) is defined for K11, which has
# no writer yet, so dws refuses to append it. A line with no tag, or with a
# value that is not one of these, folds as "untagged" and is never repaired.
TAGS = ("mirror", "proposal", "judgment")
APPENDABLE_TAGS = ("mirror", "judgment")
ACTOR_TAG = {"refresh": "mirror", "director": "judgment"}
UNTAGGED = "untagged"

SLUG = re.compile(r"^[a-z0-9][a-z0-9._-]*$")
# Section 2: a token like g9-9 anywhere in a value's match key is an instance
# id. Instance ids change at every respawn; a role does not.
INSTANCE_ID = re.compile(r"(^|[^a-z0-9])(g[0-9]+ ?- ?[0-9]+)")


class Refused(Exception):
    pass


def now():
    """The clock, as the ledger writes it. DWS_NOW overrides it only when
    DWS_TEST_CLOCK=1 is also set (the verify scripts, which need a fixed now
    on either side of their fixtures), so a stray DWS_NOW cannot pin the
    ledger's timestamps."""
    fixed = os.environ.get("DWS_NOW") if os.environ.get("DWS_TEST_CLOCK") == "1" else None
    if fixed:
        return fixed
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def stored_form(value):
    """What dws writes (two-form rule, re-ruled 2026-10-02, director#195):
    NFKC; every whitespace run, Cc whitespace included, to one space, trimmed;
    the remaining Cc stripped. Nothing else is removed or mapped, so marks,
    selectors, joiners and dashes in real text are stored as typed."""
    v = unicodedata.normalize("NFKC", value)
    v = re.sub(r"\s+", " ", v).strip()
    return "".join(ch for ch in v if unicodedata.category(ch) != "Cc")


def match_keys(stored):
    """The keys the instance-id refusal matches on, computed from the stored
    form and never stored. U+00AD is taken both ways, mapped to '-' and
    removed, since either reading can be the one that hides an id; then
    NFKD, so a mark composed onto a letter comes apart; Cf, Mn, Mc and Me
    stripped; Pd and U+2212 to '-'; whitespace runs collapsed again, since a
    stripped character between two spaces leaves two; lower case."""
    keys = []
    for shy in ("-", ""):
        v = unicodedata.normalize("NFKD", stored.replace("\u00ad", shy))
        v = "".join(ch for ch in v if unicodedata.category(ch) not in ("Cf", "Mn", "Mc", "Me"))
        v = "".join("-" if unicodedata.category(ch) == "Pd" or ch == "\u2212" else ch for ch in v)
        keys.append(re.sub(r"\s+", " ", v).lower())
    return keys


def checked(field, value):
    """The stored form, or Refused when either match key carries an instance id."""
    stored = stored_form(value)
    for key in match_keys(stored):
        m = INSTANCE_ID.search(key)
        if m:
            raise Refused(f"{field} {value!r} carries instance id {m.group(2)!r}; "
                          "name the seat or role, never an instance id (they change at "
                          "every respawn). Reword the value if the token is not an id.")
    return stored


def parse_time(ts):
    return datetime.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)


def operator_blocked(value):
    """True when a blocked value is the operator, in any form dws stores alike."""
    return stored_form(value).lower() == "operator"


def desk_card_open(card_id):
    """K13: the card id must be open in a fresh Desk snapshot. Returns the
    snapshot's age text, or raises Refused. Without a usable snapshot it
    refuses and says UNREAD; it never takes the id on faith."""
    hint = "a session must read the Desk and run desk-snapshot write"
    try:
        with open(SNAPSHOT, encoding="utf-8") as f:
            snap = json.load(f)
        read_at = parse_time(snap["read_at"])
        open_ids = snap["open"]
        if not isinstance(open_ids, list) or not all(isinstance(i, str) for i in open_ids):
            raise ValueError("open is not a list of ids")
    except FileNotFoundError:
        raise Refused(f"the Desk snapshot is UNREAD: {SNAPSHOT} does not exist; {hint}")
    except (OSError, ValueError, KeyError, TypeError) as err:
        raise Refused(f"the Desk snapshot is UNREAD: {SNAPSHOT} cannot be read ({type(err).__name__}); {hint}")
    age = parse_time(now()) - read_at
    hours = age.total_seconds() / 3600
    limit = THRESHOLD_HOURS["desk snapshot"]
    if hours < 0:
        raise Refused(f"the Desk snapshot is UNREAD: it was read at {snap['read_at']}, which is in the future; {hint}")
    if hours > limit:
        raise Refused(f"the Desk snapshot is UNREAD: it was read {int(hours)}h ago and the limit is {limit}h; {hint}")
    if card_id not in open_ids:
        raise Refused(f"card {card_id!r} is not open in the Desk snapshot read at {snap['read_at']}; "
                      "name an open card, or open one first")
    return f"card {card_id} is open in the Desk snapshot read {int(hours)}h ago ({snap['read_at']})"


def blocked_on_operator(blocked, ask):
    """Applies K13 to one write. Returns the ask link to add, or None."""
    if ask is not None and (blocked is None or not operator_blocked(blocked)):
        raise Refused("--ask goes with --blocked operator only")
    if blocked is None or not operator_blocked(blocked):
        return None
    if ask is None:
        raise Refused("--blocked operator needs --ask <card id>, an open card on the Desk (K13)")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._:-]*", ask):
        raise Refused(f"--ask {ask!r} is not a card id")
    print(f"dws: {desk_card_open(ask)}")
    return f"ask:{ask}"


def fold(path=LEDGER, tally=None):
    """Rows by slug, and how many lines could not be read. A torn line is
    skipped and counted, never repaired. A tally dict, when given, counts every
    event line by tag, whatever became of it: a line for a slug with no row and
    a re-open that resets a row are both in it (K8)."""
    rows, torn = {}, 0
    try:
        f = open(path, encoding="utf-8")
    except FileNotFoundError:
        return rows, 0
    with f:
        for line in f:
            if not line.strip():
                continue
            try:
                e = json.loads(line)
            except ValueError:
                torn += 1
                continue
            if not isinstance(e, dict):
                torn += 1
                continue
            if tally is not None:
                name = tag_name(e)
                tally[name] = tally.get(name, 0) + 1
            apply(rows, e)
    return rows, torn


def tag_name(e):
    """A line with no tag, or with a value that is not a tag, is untagged and is
    never read as judgment."""
    t = e.get("tag")
    return t if isinstance(t, str) and t in TAGS else UNTAGGED


def count_tag(row, e):
    """K8: the events applied to the row since it was last opened, by tag."""
    name = tag_name(e)
    row["tags"][name] = row["tags"].get(name, 0) + 1


def apply(rows, e):
    slug, ev, ts = e.get("ws"), e.get("event"), e.get("ts", "")
    if ev == "open":
        rows[slug] = {
            "slug": slug, "title": e.get("title", ""), "repos": e.get("repos", []),
            "owner": e.get("owner", ""), "stage": e.get("stage", "idea"),
            "last_moved": ts, "next": e.get("next", ""), "blocked": e.get("blocked", ""),
            "links": list(e.get("links", [])), "opened": ts,
            "hints": [], "observed": {}, "facts": [], "tags": {}, "consumed": [],
        }
        count_tag(rows[slug], e)
        return
    r = rows.get(slug)
    if r is None:
        return
    count_tag(r, e)
    if ev in ("stage", "park"):
        r["stage"] = e.get("to", "parked" if ev == "park" else r["stage"])
        r["last_moved"] = max(r["last_moved"], ts)
        if e.get("actor") == "refresh" and e.get("fact"):
            r["facts"].append(e["fact"])
    elif ev == "set":
        for k in ("owner", "next", "blocked", "repos"):
            if k in e:
                r[k] = e[k]
        # R-197: an authored update counts as movement. It never moves the clock back.
        r["last_moved"] = max(r["last_moved"], ts)
    elif ev == "link":
        for link in e.get("add", []):
            if link not in r["links"]:
                r["links"].append(link)
        r["links"] = [x for x in r["links"] if x not in e.get("remove", [])]
    elif ev == "observe":
        # A src names the fact an event consumed (ledger fill, section 6); the fill
        # skips any src already here, so replaying a source writes nothing.
        src = e.get("src")
        if isinstance(src, str) and src not in r["consumed"]:
            r["consumed"] = sorted(r["consumed"] + [src])
        # refresh records what it saw; a linked artifact that moved moves the
        # row's last-moved time (section 5). A row-level observe (no link)
        # carries the hints from that refresh.
        if e.get("moved_at"):
            r["last_moved"] = max(r["last_moved"], e["moved_at"])
        if e.get("link"):
            r["observed"][e["link"]] = {"seen": e.get("seen", {}), "checked_at": e.get("checked_at", ts)}
        elif "hints" in e:
            r["hints"] = list(e["hints"])


def sorted_rows(rows):
    return sorted(rows.values(), key=lambda r: (STAGES.index(r["stage"]) if r["stage"] in STAGES else len(STAGES), r["last_moved"], r["slug"]))


class Locked:
    """One exclusive flock around fold, check and append. A holder that does
    not let go within LOCK_TIMEOUT is a loud failure, not a wait forever."""

    def __init__(self, path=None):
        self.path = path

    def __enter__(self):
        if self.path is None:
            os.makedirs(STATE, exist_ok=True)
        lock = self.path or LOCK
        self.f = open(lock, "a")
        deadline = time.monotonic() + LOCK_TIMEOUT
        while True:
            try:
                fcntl.flock(self.f, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if time.monotonic() >= deadline:
                    self.f.close()
                    raise Refused(f"ledger lock {lock} held for more than {LOCK_TIMEOUT:.0f}s; nothing written")
                time.sleep(0.05)

    def __exit__(self, *exc):
        fcntl.flock(self.f, fcntl.LOCK_UN)
        self.f.close()


def append(event, path=None):
    """Append one whole line. A torn last line is left as it is; the new event
    starts on its own line so it is not glued to the torn one."""
    path = path or LEDGER
    line = json.dumps(event, ensure_ascii=False, separators=(",", ":")) + "\n"
    with open(path, "ab") as f:
        if f.tell() > 0:
            with open(path, "rb") as r:
                r.seek(-1, os.SEEK_END)
                if r.read(1) != b"\n":
                    line = "\n" + line
        f.write(line.encode("utf-8"))
        f.flush()
        os.fsync(f.fileno())


def allowed(actor, event):
    if actor not in ACTORS:
        raise Refused(f"actor {actor!r} may append nothing; writers are {sorted(ACTORS)} (section 6)")
    if actor == "refresh":
        ev = event["event"]
        if ev == "observe":
            return
        if ev == "stage" and (event.get("from"), event.get("to")) in REFRESH_MOVES:
            return
        raise Refused("refresh may append observe events and the two factual stage moves only "
                      "(building to in review, in review to merged); director makes every other move")


def check_tag(tag):
    if tag not in TAGS:
        raise Refused(f"tag {tag!r} is not one of {', '.join(TAGS)}")
    if tag not in APPENDABLE_TAGS:
        raise Refused(f"the {tag} tag is defined and not appended yet; K11 gives it a writer")


def stamp(actor, event):
    """The event as it is written: ts, actor and the tag dws sets from the
    actor, then the fields. A tag the caller put in the event is dropped."""
    fields = {k: v for k, v in event.items() if k != "tag"}
    allowed(actor, fields)
    tag = ACTOR_TAG[actor]
    check_tag(tag)
    return {"ts": now(), "actor": actor, "tag": tag, **fields}


def write(actor, event, check):
    """Fold, check, append under the lock. check(rows) raises Refused."""
    event = stamp(actor, event)
    with Locked():
        rows, _ = fold()
        check(rows)
        append(event)
    rerender()


def write_many(actor, plan):
    """Fold, then let plan(rows) return the events to append, all under one
    lock, so the stage each move is checked against is the current one."""
    with Locked():
        rows, _ = fold()
        events = [stamp(actor, e) for e in plan(rows)]
        for e in events:
            append(e)
    if events:
        rerender()
    return events


def rerender():
    """After a write, re-render the page when board.html exists (opt-in by
    existence, the rule the renderer already follows)."""
    if not os.path.exists(os.path.join(STATE, "board.html")):
        return
    renderer = os.path.join(os.path.dirname(os.path.abspath(__file__)), "board-html")
    try:
        subprocess.run([renderer], check=True, capture_output=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as err:
        print(f"dws: written; board-html re-render failed: {err}", file=sys.stderr)


def need(rows, slug):
    if slug not in rows:
        raise Refused(f"no workstream {slug!r}; open it first")
    return rows[slug]


def stage_name(s):
    if s not in STAGES:
        raise Refused(f"unknown stage {s!r}; stages are: {', '.join(STAGES)}")
    return s


def cmd_open(a):
    if not SLUG.match(a.slug):
        raise Refused(f"slug {a.slug!r} must be lower case letters, digits, '.', '_' or '-'")
    ev = {"event": "open", "ws": a.slug, "title": a.title, "stage": stage_name(a.stage)}
    for field in ("owner", "next", "blocked"):
        v = getattr(a, field)
        if v is not None:
            ev[field] = checked(field, v)
    if a.repos:
        ev["repos"] = a.repos
    ask_link = blocked_on_operator(a.blocked, a.ask)
    if ask_link:
        ev["blocked"] = "operator"
    if a.link or ask_link:
        ev["links"] = list(a.link or []) + ([ask_link] if ask_link and ask_link not in (a.link or []) else [])

    def check(rows):
        if a.slug in rows:
            raise Refused(f"workstream {a.slug!r} is already open; use set, stage or link")
    write(a.actor, ev, check)


def move(a, event, to):
    ev = {"event": event, "ws": a.slug, "from": stage_name(a.from_), "to": stage_name(to)}

    def check(rows):
        cur = need(rows, a.slug)["stage"]
        if cur != a.from_:
            raise Refused(f"stale move: {a.slug!r} is in {cur!r}, not {a.from_!r}; re-read and retry")
    write(a.actor, ev, check)


def cmd_stage(a):
    move(a, "stage", a.to)


def cmd_park(a):
    move(a, "park", "parked")


def cmd_set(a):
    ev = {"event": "set", "ws": a.slug}
    for field in ("owner", "next", "blocked"):
        v = getattr(a, field)
        if v is not None:
            ev[field] = checked(field, v)
    if a.repos is not None:
        ev["repos"] = a.repos
    ask_link = blocked_on_operator(a.blocked, a.ask)
    if ask_link:
        ev["blocked"] = "operator"
    if len(ev) == 2 and not ask_link:
        raise Refused("set needs at least one of --owner, --next, --blocked, --repos")
    if not ask_link:
        write(a.actor, ev, lambda rows: need(rows, a.slug))
        return

    def plan(rows):
        r = need(rows, a.slug)
        events = [ev]
        if ask_link not in r["links"]:
            events.append({"event": "link", "ws": a.slug, "add": [ask_link]})
        return events
    write_many(a.actor, plan)


RELAY_LINK = re.compile(r"^relay:R-[0-9]+$")
MSG_LINK = re.compile(r"^msg:[A-Za-z0-9][A-Za-z0-9._:-]*$")


def typed_link(link):
    """relay: and msg: links are typed (ledger fill): a malformed one is refused, so a
    typo cannot sit on a row looking like a join key. Other links are untouched."""
    if link.startswith("relay:") and not RELAY_LINK.match(link):
        raise Refused(f"link {link!r} is not relay:R-<n>")
    if link.startswith("msg:") and not MSG_LINK.match(link):
        raise Refused(f"link {link!r} is not msg:<message id>")
    return link


def cmd_link(a):
    for link in a.links:
        typed_link(link)
    ev = {"event": "link", "ws": a.slug, ("remove" if a.remove else "add"): a.links}
    write(a.actor, ev, lambda rows: need(rows, a.slug))


# The links refresh reads. A bd id must start with a letter or digit, so it can
# never reach bd as an option. ask: is typed but not read until W5; any other
# link is untyped. refresh names every link it does not read.
LINK = re.compile(r"^(pr|issue):([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([0-9]+)$|^(bd):([A-Za-z0-9][A-Za-z0-9._-]*)$")
ASK = re.compile(r"^ask:\S+$")


def refresh_skip():
    return float(os.environ.get("DWS_REFRESH_SKIP_SECONDS", "600"))


def parse_ts(ts):
    try:
        return datetime.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
    except (TypeError, ValueError):
        return None


def run_json(cmd):
    out = subprocess.run(cmd, capture_output=True, text=True, timeout=60)
    if out.returncode != 0:
        raise RuntimeError((out.stderr or out.stdout).strip() or f"exit {out.returncode}")
    return out.stdout


def pr_state(d):
    if d.get("mergedAt") or d.get("state") == "MERGED":
        return "merged"
    if d.get("state") == "CLOSED":
        return "closed"
    return "draft" if d.get("isDraft") else "ready"


def release_containing(repo, commit):
    """The latest stable release tag of repo (GitHub's releases/latest, which
    leaves out drafts and pre-releases) when its history contains commit, or
    None. A repo with no stable release answers 404, which is None, not a
    failure. A hint only: refresh never moves a row to released (section 5)."""
    if not commit:
        return None
    try:
        tag = run_json(["gh", "api", f"repos/{repo}/releases/latest", "--jq", ".tag_name"]).strip()
    except RuntimeError as err:
        if "HTTP 404" in str(err):
            return None
        raise
    if not tag:
        return None
    status = run_json(["gh", "api", f"repos/{repo}/compare/{commit}...{tag}", "--jq", ".status"]).strip()
    return tag if status in ("ahead", "identical") else None


def pr_moved_at(d):
    """When the PR last moved in the sense of the section 5 table: its latest
    commit, review or merge. A comment changes updatedAt and is not a move. A
    ready event carries no time here; refresh dates it by the state change."""
    times = [c.get("committedDate") for c in d.get("commits") or []]
    times += [r.get("submittedAt") for r in d.get("reviews") or []]
    times.append(d.get("mergedAt"))
    times = [t for t in times if t]
    return max(times) if times else None


def fetch(link, last_seen=None):
    """What the source says now: (seen, moved_at). Reads only."""
    m = LINK.match(link)
    kind = m.group(1) or m.group(4)
    if kind == "pr":
        repo, num = m.group(2), m.group(3)
        d = json.loads(run_json(["gh", "pr", "view", num, "-R", repo, "--json",
                                 "state,isDraft,reviewDecision,updatedAt,mergedAt,mergeCommit,commits,reviews"]))
        seen = {"kind": "pr", "state": pr_state(d)}
        moved = pr_moved_at(d)
        if last_seen and last_seen.get("state") and last_seen["state"] != seen["state"]:
            moved = max(filter(None, [moved, now()]))  # ready, merge or close seen now
        if seen["state"] == "merged":
            # A hint only (section 5): a release check that fails is a hint
            # too, and never costs the PR its observation or its move.
            commit = (d.get("mergeCommit") or {}).get("oid")
            try:
                tag = release_containing(repo, commit)
            except (RuntimeError, ValueError, OSError, subprocess.SubprocessError, KeyError) as err:
                seen["release_error"] = str(err).splitlines()[0][:200] if str(err) else type(err).__name__
            else:
                if tag:
                    seen["release"] = tag
        return seen, moved
    if kind == "issue":
        repo, num = m.group(2), m.group(3)
        d = json.loads(run_json(["gh", "issue", "view", num, "-R", repo, "--json", "state,updatedAt"]))
        return {"kind": "issue", "state": d.get("state", "").lower()}, d.get("updatedAt")
    d = json.loads(run_json(["bd", "show", m.group(5), "--json"]))
    d = d[0] if isinstance(d, list) and d else d
    moved = d.get("updated_at")
    if moved and not moved.endswith("Z"):
        t = datetime.datetime.fromisoformat(moved)
        moved = t.astimezone(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return {"kind": "bd", "state": d.get("status", "")}, moved


def decide(row, seen_by_link):
    """The factual moves and the hints for one row (section 5). A PR closed
    unmerged is left out of the agreement and shown. A fact is the set of the
    row's PRs with their states, never a time; a fact already recorded on an
    earlier refresh move is never applied again, so a revert holds until a PR
    reaches a state not acted on before."""
    prs = sorted((link, s["state"]) for link, s in seen_by_link.items() if s.get("kind") == "pr")
    hints = [f"PR {link[3:]} closed unmerged" for link, st in prs if st == "closed"]
    active = [(link, st) for link, st in prs if st != "closed"]
    for link, s in seen_by_link.items():
        if s.get("release"):
            hints.append(f"release {s['release']} contains {link[3:]}; moving to released is director's call")
        if s.get("release_error"):
            hints.append(f"release check for {link[3:]} failed ({s['release_error']}); no release hint")
    if not active:
        return [], hints
    fact = ", ".join(f"{link[3:]} {st}" for link, st in prs)
    states = {st for _, st in active}
    moves, stage = [], row["stage"]
    if fact not in row["facts"]:
        if stage == "building" and states <= {"ready", "merged"}:
            moves.append(("building", "in review"))
            stage = "in review"
        if stage == "in review" and states == {"merged"}:
            moves.append(("in review", "merged"))
            stage = "merged"
    if not moves and stage in ("building", "in review") and len(states) > 1:
        hints.append("linked PRs disagree (" + ", ".join(f"{link[3:]} {st}" for link, st in active) + "); stage left as is")
    return [{"event": "stage", "ws": row["slug"], "from": f, "to": t, "fact": fact} for f, t in moves], hints


def cmd_refresh(a):
    """Read each row's linked sources and record what they say (W2). Network
    reads happen outside the lock; the moves are decided under it, against
    the stage as it is then. Appends as actor refresh whatever --actor says."""
    rows, _ = fold()
    slugs = a.slugs or [r["slug"] for r in sorted_rows(rows)]
    for slug in slugs:
        need(rows, slug)
    t_now = parse_ts(now())
    observed, warnings = {}, []
    for slug in slugs:
        row = rows[slug]
        for link in row["links"]:
            if not LINK.match(link):
                why = "ask ids are read in W5" if ASK.match(link) else "untyped; use pr:, issue: or bd:<id>"
                warnings.append(f"{slug}: {link} not read ({why})")
                continue
            last = row["observed"].get(link)
            checked = parse_ts(last["checked_at"]) if last else None
            if checked and (t_now - checked).total_seconds() < refresh_skip():
                continue
            try:
                seen, moved = fetch(link, last["seen"] if last else None)
            except (RuntimeError, ValueError, OSError, subprocess.SubprocessError, KeyError) as err:
                warnings.append(f"{slug}: {link} unreadable: {err}")
                continue
            observed[(slug, link)] = (seen, moved)

    def plan(current):
        events = []
        for slug in slugs:
            row = current.get(slug)
            if row is None:
                continue
            seen_by_link = {link: v["seen"] for link, v in row["observed"].items() if link in row["links"]}
            for (s, link), (seen, moved) in observed.items():
                if s != slug:
                    continue
                ev = {"event": "observe", "ws": slug, "link": link, "seen": seen, "checked_at": now()}
                if moved:
                    # A source time ahead of now (a skewed or forged commit
                    # date) would sort as freshest forever; clamp it.
                    ev["moved_at"] = min(moved, now())
                events.append(ev)
                seen_by_link[link] = seen
            moves, hints = decide(row, seen_by_link)
            events.extend(moves)
            if hints != row["hints"]:
                events.append({"event": "observe", "ws": slug, "hints": hints, "checked_at": now()})
        return events

    events = write_many("refresh", plan)
    for e in events:
        if e["event"] == "stage":
            print(f"{e['ws']}: {e['from']} -> {e['to']} ({e['fact']})")
        elif "hints" in e:
            for h in e["hints"]:
                print(f"{e['ws']}: hint: {h}")
    for w in warnings:
        print(f"dws refresh: {w}", file=sys.stderr)


def cmd_show(a):
    total = {}
    rows, torn = fold(tally=total)
    ordered = sorted_rows(rows)
    if a.json:
        json.dump({"ledger": LEDGER, "torn": torn, "tags": total, "rows": ordered}, sys.stdout, indent=2, ensure_ascii=False)
        print()
    else:
        cols = ("stage", "workstream", "owner", "last moved", "blocked on", "next action", "links")
        table = [cols] + [(r["stage"], r["slug"], r["owner"], r["last_moved"], r["blocked"], r["next"], " ".join(r["links"])) for r in ordered]
        widths = [max(len(str(row[i])) for row in table) for i in range(len(cols))]
        for row in table:
            print("  ".join(str(c).ljust(w) for c, w in zip(row, widths)).rstrip())
    if torn:
        print(f"dws: {torn} unreadable line(s) in {LEDGER} skipped, not repaired", file=sys.stderr)

# K9: rulings.jsonl, the store of rulings, grants and terms (R-201, R-204, R-184).
# The file is the one merge-guard reads for exclusions (R-153); exclusions stay
# the operator's and dws never writes one. The operator creates the file, so dws
# refuses when it is missing and never creates it. Its lock is its own file beside it.
RECORD_KINDS = ("ruling", "grant", "exclusion", "term")
RECORD_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._:-]*")
RECORD_DATE = re.compile(r"\d{4}-\d\d-\d\d(T\d\d:\d\d:\d\dZ)?")


def rulings_path():
    return os.environ.get("MERGE_GUARD_RULINGS") or os.path.join(STATE, "rulings.jsonl")


def need_file(path):
    if not os.path.exists(path):
        raise Refused(f"no rulings file at {path}; the guard cannot tell no exclusions declared from a record that "
                      "is gone (R-153). The operator creates the file and enters their exclusions (an empty file "
                      "means none declared); a seat reports this and does not create the file")
    if not os.path.isfile(path):
        raise Refused(f"the rulings path {path} exists and is not a file")


def fold_records(path):
    """The records in file order, each with replaced_by (the ids whose replaces
    names it), how many lines could not be read, and the replaces pointers that
    resolve to nothing or to another kind. A pointer is never guessed at."""
    records, torn = [], 0
    try:
        f = open(path, encoding="utf-8")
    except FileNotFoundError:
        return records, 0, []
    with f:
        for line in f:
            if not line.strip():
                continue
            try:
                e = json.loads(line)
            except ValueError:
                torn += 1
                continue
            if not isinstance(e, dict):
                torn += 1
                continue
            records.append({**e, "replaced_by": []})
    by_id = {}
    for r in records:
        if isinstance(r.get("id"), str):
            by_id.setdefault(r["id"], r)
    unresolved = []
    for r in records:
        ptr = r.get("replaces")
        if ptr is None:
            continue
        target = by_id.get(ptr) if isinstance(ptr, str) else None
        if target is None:
            unresolved.append({"id": r.get("id"), "replaces": ptr, "why": "missing"})
        elif target.get("kind") != r.get("kind"):
            unresolved.append({"id": r.get("id"), "replaces": ptr, "why": "other kind"})
        else:
            target["replaced_by"].append(r.get("id"))
    return records, torn, unresolved


def nonblank(field, value):
    if value is None or not value.strip():
        raise Refused(f"--{field.replace('_', '-')} is required and may not be blank")
    return value


def record_date(field, value):
    m = RECORD_DATE.fullmatch(value)
    try:
        if not m:
            raise ValueError
        datetime.datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ" if m.group(1) else "%Y-%m-%d")
    except ValueError:
        raise Refused(f"{field} {value!r} is not a date (YYYY-MM-DD or YYYY-MM-DDTHH:MM:SSZ)")
    return value


def record_id(field, value):
    if not RECORD_ID.fullmatch(value):
        raise Refused(f"{field} {value!r} is not an id")
    return value


def cmd_record(a):
    if a.kind == "exclusion":
        raise Refused("exclusions stay the operator's (R-153): the operator enters them in the rulings file; "
                      "dws writes ruling, grant and term only")
    if a.actor != "director":
        raise Refused(f"actor {a.actor!r} may not write a record; only director does")
    # The text is the operator's words and is stored as given, never normalized (R-186).
    fields = {"source": stored_form(nonblank("source", a.source))}
    if a.kind == "ruling":
        fields.update(subject=stored_form(nonblank("subject", a.subject)), text=nonblank("text", a.text),
                      by=checked("by", nonblank("by", a.by)), ruled_at=record_date("ruled_at", nonblank("ruled_at", a.ruled_at)))
    elif a.kind == "grant":
        if a.state not in ("draft", "confirmed"):
            raise Refused(f"--state {a.state!r} must be draft or confirmed")
        fields.update(subject=stored_form(nonblank("subject", a.subject)), scope=stored_form(nonblank("scope", a.scope)),
                      to=checked("to", nonblank("to", a.to)), state=a.state, text=nonblank("text", a.text))
        if a.expires is not None:
            fields["expires"] = record_date("expires", a.expires)
    else:
        fields.update(role=checked("role", nonblank("role", a.role)), subject=stored_form(nonblank("subject", a.subject)),
                      text=nonblank("text", a.text), set_by=checked("set_by", nonblank("set_by", a.set_by)))
    if getattr(a, "card", None) is not None:
        fields["card"] = record_id("card", a.card)
    if getattr(a, "link", None):
        fields["links"] = [stored_form(x) for x in a.link]
    if a.replaces is not None:
        fields["replaces"] = record_id("replaces", a.replaces)
    tag = "proposal" if a.kind == "grant" and a.state == "draft" else "mirror"
    path = rulings_path()
    need_file(path)
    with Locked(os.path.join(os.path.dirname(path) or ".", "rulings.lock")):
        records, _, _ = fold_records(path)
        ts = now()
        taken = {r.get("id") for r in records}
        if a.id is not None:
            rid = record_id("id", a.id)
        else:
            # The default is <kind>-<UTC ts>; a second record of the same kind in the
            # same second takes -2, -3 and so on, so the id stays unique.
            rid, n = f"{a.kind}-{ts}", 1
            while rid in taken:
                n += 1
                rid = f"{a.kind}-{ts}-{n}"
        if a.replaces is not None and a.replaces == rid:
            raise Refused(f"id {rid!r} replaces itself; nothing written")
        if rid in taken:
            raise Refused(f"id {rid!r} is already in {path}; nothing written")
        append({"kind": a.kind, "id": rid, "ts": ts, "actor": a.actor, "tag": tag, **fields}, path)
    print(f"dws: wrote {a.kind} {rid}")


def cmd_records(a):
    path = rulings_path()
    need_file(path)
    records, torn, unresolved = fold_records(path)
    counts = {}
    for r in records:
        k = r.get("kind") if r.get("kind") in RECORD_KINDS else "unknown"
        counts[k] = counts.get(k, 0) + 1
    if a.kind:
        records = [r for r in records if r.get("kind") == a.kind]
    if a.json:
        json.dump({"file": path, "torn": torn, "counts": counts, "records": records,
                   "unresolved_replaces": unresolved}, sys.stdout, indent=2, ensure_ascii=False)
        print()
    else:
        for r in records:
            mark = f"  replaced by {', '.join(map(str, r['replaced_by']))}" if r["replaced_by"] else ""
            print(f"{r.get('kind', '?')}  {r.get('id', '-')}  {r.get('subject', r.get('repo', ''))}{mark}")
        for u in unresolved:
            print(f"unresolved replaces: {u['id']} -> {u['replaces']} ({u['why']})")
    if torn:
        print(f"dws: {torn} unreadable line(s) in {path} skipped, not repaired", file=sys.stderr)


def main(argv):
    p = argparse.ArgumentParser(prog="dws", description="director workstream ledger (W1)")
    p.add_argument("--actor", default="director", help="the writer, a claim checked against the writer table")
    sub = p.add_subparsers(dest="cmd", required=True)

    o = sub.add_parser("open")
    o.add_argument("slug")
    o.add_argument("--title", required=True)
    o.add_argument("--owner")
    o.add_argument("--stage", default="idea")
    o.add_argument("--repos", nargs="+")
    o.add_argument("--next")
    o.add_argument("--blocked")
    o.add_argument("--ask")
    o.add_argument("--link", nargs="+")
    o.set_defaults(fn=cmd_open)

    s = sub.add_parser("stage")
    s.add_argument("slug")
    s.add_argument("to")
    s.add_argument("--from", dest="from_", required=True)
    s.set_defaults(fn=cmd_stage)

    k = sub.add_parser("park")
    k.add_argument("slug")
    k.add_argument("--from", dest="from_", required=True)
    k.set_defaults(fn=cmd_park)

    t = sub.add_parser("set")
    t.add_argument("slug")
    t.add_argument("--owner")
    t.add_argument("--next")
    t.add_argument("--blocked")
    t.add_argument("--ask")
    t.add_argument("--repos", nargs="+")
    t.set_defaults(fn=cmd_set)

    n = sub.add_parser("link")
    n.add_argument("slug")
    n.add_argument("--remove", action="store_true")
    n.add_argument("links", nargs="+")
    n.set_defaults(fn=cmd_link)

    f = sub.add_parser("refresh")
    f.add_argument("slugs", nargs="*")
    f.set_defaults(fn=cmd_refresh)

    w = sub.add_parser("show")
    w.add_argument("--json", action="store_true")
    w.set_defaults(fn=cmd_show)

    rc = sub.add_parser("record", help="write a ruling, grant or term to rulings.jsonl (K9)")
    rs = rc.add_subparsers(dest="kind", required=True)
    for kind in ("ruling", "grant", "term"):
        k = rs.add_parser(kind)
        k.add_argument("--source", required=True)
        k.add_argument("--id")
        k.add_argument("--replaces")
        k.add_argument("--subject", required=True)
        k.add_argument("--text", required=True)
        if kind == "ruling":
            k.add_argument("--by", required=True)
            k.add_argument("--ruled-at", dest="ruled_at", required=True)
            k.add_argument("--card")
            k.add_argument("--link", nargs="+")
        elif kind == "grant":
            k.add_argument("--scope", required=True)
            k.add_argument("--to", required=True)
            k.add_argument("--state", required=True)
            k.add_argument("--card")
            k.add_argument("--expires")
        else:
            k.add_argument("--role", required=True)
            k.add_argument("--set-by", dest="set_by", required=True)
    rs.add_parser("exclusion", add_help=False)
    rc.set_defaults(fn=cmd_record)

    rr = sub.add_parser("records", help="read rulings.jsonl with replaced marks (K9)")
    rr.add_argument("--json", action="store_true")
    rr.add_argument("--kind", choices=RECORD_KINDS)
    rr.set_defaults(fn=cmd_records)

    a, extra = p.parse_known_args(argv)
    if extra and not (a.cmd == "record" and a.kind == "exclusion"):
        p.error("unrecognized arguments: " + " ".join(extra))
    try:
        a.fn(a)
    except Refused as err:
        print(f"dws: refused: {err}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
