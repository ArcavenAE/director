PAGE_JS = """
(function(){
  var PAGE="%s", state={db:null,canWrite:true,by:null,picks:{}}, timers={};
  function $(s,r){return (r||document).querySelector(s)}
  function all(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))}
  function notice(t){var n=$("#notice"); if(n){n.textContent=t; n.hidden=!t}}
  function rowId(li){return li.getAttribute("data-section")+"--"+li.getAttribute("data-slug")}
  function rowOf(el){return el.closest("li.row")}
  function paint(li){
    var p=state.picks[rowId(li)]||{}, note=$(".note",li), rdy=$(".ready",li);
    all(".act",li).forEach(function(b){
      b.setAttribute("aria-pressed",String(b.getAttribute("data-action")===p.action));
      b.disabled=!state.canWrite;
    });
    if(note&&document.activeElement!==note){note.value=p.note||""}
    if(note){note.disabled=!state.canWrite}
    if(rdy){rdy.checked=!!p.ready; rdy.disabled=!state.canWrite||!p.action}
  }
  function paintAll(){all("li.row").forEach(paint)}
  function status(li,t){var s=$(".st",li); if(s){s.textContent=t}}
  function save(li){
    if(!state.db){return}
    var id=rowId(li); clearTimeout(timers[id]);
    var t=setTimeout(function(){
      function settled(){if(timers[id]===t){delete timers[id]}}
      var p=state.picks[id]||{}, ref=state.db.doc("picks/"+id), act=$(".act[data-action=\\""+(p.action||"")+"\\"]",li);
      if(!p.action&&!p.note){
        status(li,"Saving");
        ref.delete().then(function(){status(li,"Cleared");settled()}).catch(function(){status(li,"Not saved, try again");settled()});
        return;
      }
      var body={action:p.action||null,action_label:act?act.textContent:null,note:p.note||"",
        ready:!!(p.ready&&p.action),section:li.getAttribute("data-section"),title:li.getAttribute("data-title"),
        page:PAGE,at:new Date().toISOString(),by:state.by};
      status(li,"Saving");
      ref.set(body).then(function(){status(li,"Saved");settled()}).catch(function(e){
        if(e&&e.code==="invalid_argument"){state.canWrite=false; notice("Read-only: you can see the calls here, but not save them."); paintAll(); status(li,"You can't save here")}
        else{status(li,"Not saved, try again")}
        settled();
      });
    },500);
    timers[id]=t;
  }
  function edit(li,fn){
    var id=rowId(li); state.picks[id]=Object.assign({},state.picks[id]||{}); fn(state.picks[id]); paint(li); save(li);
  }
  document.addEventListener("click",function(ev){
    var b=ev.target.closest&&ev.target.closest("button.act"); if(!b||!state.canWrite){return}
    var li=rowOf(b), a=b.getAttribute("data-action");
    edit(li,function(p){if(p.action===a){p.action=null;p.ready=false}else{p.action=a}});
  });
  document.addEventListener("change",function(ev){
    var t=ev.target; if(!t.classList||!t.classList.contains("ready")){return}
    edit(rowOf(t),function(p){p.ready=t.checked});
  });
  document.addEventListener("input",function(ev){
    var t=ev.target; if(!t.classList||!t.classList.contains("note")){return}
    var li=rowOf(t), id=rowId(li); state.picks[id]=Object.assign({},state.picks[id]||{},{note:t.value}); save(li);
  });
  if(!window.claude||!window.claude.use){notice("The Your call controls are not available in this view."); return}
  claude.use("db").then(function(db){
    if(!db){notice("The Your call controls are not available in this view. Open the page signed in to claude.ai."); return}
    state.db=db;
    all(".call").forEach(function(c){c.hidden=false});
    claude.use("user").then(function(u){
      if(!u){return}
      if(u.id){u.id().then(function(id){state.by=id}).catch(function(){})}
      if(u.can){u.can("data.write").then(function(v){
        if(v===false){state.canWrite=false; notice("Read-only: you can see the calls here, but not save them."); paintAll()}
      }).catch(function(){})}
    }).catch(function(){});
    db.collection("picks").onSnapshot(function(snap){
      var m={}; snap.docs.forEach(function(d){m[d.id]=d.data()});
      Object.keys(state.picks).forEach(function(k){if(timers[k]){m[k]=state.picks[k]}});
      state.picks=m; paintAll();
    },function(){notice("Calls stopped updating. Reload the page.")});
  }).catch(function(){notice("The Your call controls are not available in this view.")});
})();
""" % PAGE_ID


def page_age(r, t_now):
    """Seconds since the row last moved, or None when the stored time cannot be read."""
    try:
        return (t_now - parse_time(r["last_moved"])).total_seconds()
    except (ValueError, TypeError):
        return None


def page_section(r, t_now):
    """The section key a row belongs in, or None (see the table above)."""
    stage, blocked = r["stage"], str(r.get("blocked") or "").strip()
    if blocked.lower() == "none":
        blocked = ""
    age, week = page_age(r, t_now), PAGE_DAYS * 86400
    if stage not in CLOSED_STAGES and blocked and operator_blocked(blocked):
        return "blocked"
    if r["slug"].startswith("adhoc-"):
        if stage in CLOSED_STAGES and not (age is not None and age < week):
            return None
        return "adhoc"
    if stage in DONE_STAGES:
        return "done" if age is not None and age < week else None
    if stage == "parked":
        return None
    if blocked:
        return "waiting"
    if age is not None and age < week:
        return "motion"
    return "quiet"


def page_link(link):
    esc = htmlmod.escape
    m = re.fullmatch(r"(pr|issue):([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([0-9]+)", link)
    if m:
        path = "pull" if m.group(1) == "pr" else "issues"
        return f'<a class="link" href="https://github.com/{esc(m.group(2))}/{path}/{m.group(3)}" rel="noopener">{esc(link)}</a>'
    return f'<span class="link">{esc(link)}</span>'


def page_none():
    return '<span class="none">none</span>'


def page_count(n):
    return "none" if n == 0 else ("1 row" if n == 1 else f"{n} rows")


def page_desk_link(card, desk_url):
    esc = htmlmod.escape
    if not desk_url:
        return f"<code>{esc(card)}</code>"
    if "{id}" in desk_url:
        href = desk_url.replace("{id}", card)
    else:
        href = desk_url if "#" in desk_url else f"{desk_url}#{card}"
    return f'<a href="{esc(href)}" rel="noopener"><code>{esc(card)}</code></a>'


def page_row(r, key, calls, snap, desk_url):
    esc = htmlmod.escape
    cells = [
        ("Owner", esc(r["owner"]) if r["owner"] else page_none()),
        ("Stage", esc(r["stage"])),
        ("Next action", esc(r["next"]) if r["next"] else page_none()),
        ("Last moved", esc(r["last_moved"][:10]) if r["last_moved"] else page_none()),
        ("Links", " ".join(page_link(l) for l in r["links"]) or page_none()),
    ]
    if key == "blocked":
        cards = [l[4:] for l in r["links"] if l.startswith("ask:")]
        parts = []
        for c in cards:
            st = card_status(snap, c) if snap is not None else None
            tag = "" if st == "open" else (' <span class="none">(Desk UNREAD)</span>' if snap is None
                                           else ' <span class="none">(not open in the Desk snapshot)</span>')
            parts.append(page_desk_link(c, desk_url) + tag)
        cells.insert(2, ("Answer on Desk", " ".join(parts) or '<span class="none">no card linked</span>'))
    out = [f'<li class="row" data-section="{key}" data-slug="{esc(r["slug"])}" data-title="{esc(r["title"])}">',
           f'<div><span class="title">{esc(r["title"])}</span> <code>{esc(r["slug"])}</code></div>', '<dl class="f">']
    out += [f"<div><dt>{k}</dt><dd>{v}</dd></div>" for k, v in cells]
    out.append("</dl>")
    if calls:
        out.append('<div class="call" hidden><div class="acts">')
        out += [f'<button type="button" class="act" data-action="{a}" aria-pressed="false">{esc(label)}</button>' for a, label in calls]
        out.append('</div><textarea class="note" rows="2" aria-label="Note" placeholder="Note"></textarea>')
        out.append('<label><input type="checkbox" class="ready" disabled> Ready for director</label><span class="st" role="status"></span></div>')
    out.append("</li>")
    return "".join(out)


def page_instance_file(flag_value, default_name, label):
    """The text of an instance file. An explicit path that cannot be read is refused; a
    default that is simply absent is skipped."""
    path = flag_value or os.path.join(STATE, default_name)
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except FileNotFoundError:
        if flag_value:
            raise Refused(f"{label} file {path} does not exist")
        return ""
    except (OSError, UnicodeDecodeError) as err:
        raise Refused(f"{label} file {path} cannot be read ({type(err).__name__})")


def page_render(theme, nav, desk_url):
    esc = htmlmod.escape
    t_now = parse_time(now())
    rows, torn = fold()
    snap, why = desk_snapshot()
    ledger_read = os.path.exists(LEDGER)
    buckets = {s[0]: [] for s in PAGE_SECTIONS}
    unplaced = 0
    for r in sorted(rows.values(), key=lambda r: r["slug"]):
        key = page_section(r, t_now)
        if key is None:
            unplaced += 1
        else:
            buckets[key].append(r)
    out = ["<!doctype html>\n"
           "<!-- Director Work Ledger page. director publishes it as an Artifact with capabilities\n"
           '     {"db":{},"user":{}}. Each row\'s "Your call" control writes a doc to the picks collection,\n'
           "     which `dws picks` reads back. With no db the page renders in full and the controls stay hidden. -->\n"
           '<html lang="en"><head><meta charset="utf-8">',
           '<meta name="viewport" content="width=device-width,initial-scale=1">',
           f"<title>{esc(PAGE_TITLE)}</title><style>{PAGE_CSS}</style></head><body>\n"]
    out.append(theme)
    out.append(nav)
    out.append(f"<main><h1>{esc(PAGE_TITLE)}</h1>")
    ledger = (f"Ledger: {len(rows)} workstream(s)" + (f", {torn} unreadable line(s) skipped" if torn else "")
              if ledger_read else f"Ledger UNREAD: {esc(os.path.basename(LEDGER))} does not exist")
    desk = f"Desk snapshot read {esc(snap['read_at'])}" if snap is not None else f"Desk {esc(why)}"
    out.append(f'<p class="src">{ledger}. {desk}.</p>')
    out.append('<div id="notice" class="notice" role="status" hidden></div>')
    for key, heading, desc, calls in PAGE_SECTIONS:
        rs = sorted(buckets[key], key=lambda r: r["slug"])
        rs.sort(key=lambda r: r["last_moved"], reverse=key not in PAGE_OLDEST_FIRST)
        out.append(f'<section id="s-{key}"><h2>{esc(heading)}</h2><p class="desc">{esc(desc)}</p><p class="count">{page_count(len(rs))}</p>')
        if rs:
            out.append('<ul class="rows">' + "".join(page_row(r, key, calls, snap, desk_url) for r in rs) + "</ul>")
        out.append("</section>")
    out.append(f'<p class="foot">Not shown: {unplaced} row(s), parked or finished more than {PAGE_DAYS} days ago '
               f"(an adhoc- row that is parked or finished stays in Ad hoc for {PAGE_DAYS} days after it last moved).</p></main>")
    out.append(f"<script>{PAGE_JS}</script></body></html>\n")
    return "".join(out)


def cmd_page(a):
    theme = page_instance_file(a.theme, "page-theme.css.html", "theme")
    nav = page_instance_file(a.nav, "page-nav.html", "nav")
    desk_url = page_instance_file(a.desk_url, "page-desk-url", "desk url").strip()
    if desk_url and not desk_url.startswith("https://"):
        raise Refused("the Desk url must start with https://")
    text = page_render(theme, nav, desk_url)
    if not a.out:
        sys.stdout.buffer.write(text.encode("utf-8"))
        return
    d = os.path.dirname(os.path.abspath(a.out))
    fd, tmp = tempfile.mkstemp(prefix=".page-", dir=d)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(text.encode("utf-8"))
        os.replace(tmp, a.out)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def cmd_migrate_blocked_none(a):
    def hits(rows):
        return sorted(r["slug"] for r in rows.values() if stored_form(str(r.get("blocked") or "")).lower() == "none")
    if a.dry_run:
        rows, _ = fold()
        slugs = hits(rows)
        print(f"dws: would clear blocked none on {len(slugs)} row(s)" + "".join(f"\n  {s}" for s in slugs))
        return
    events = write_plan(a.actor, lambda rows, decisions: [
        {"event": "set", "ws": s, "blocked": "", "migrate": "blocked-none"} for s in hits(rows)])
    print(f"dws: cleared blocked none on {len(events)} row(s)")


# W3: `picks` reads an export of the page's picks collection (the doc list the Artifact data
# tool returns) and prints one line per pick with ready true that dws has not reported, then
# records what it reported in $DIRECTOR_STATE/picks-seen.jsonl, so a pick is reported once.
# A pick the operator changes afterwards (a new action, note or time) is a new pick. It
# writes nothing else and never reads the ledger.
def picks_seen_path():
    return os.path.join(STATE, "picks-seen.jsonl")


def pick_docs(raw):
    """(list of (doc id, fields), count of entries that were not a doc)."""
    if isinstance(raw, dict):
        for k in ("docs", "documents", "items", "results"):
            if isinstance(raw.get(k), list):
                raw = raw[k]
                break
        else:
            raise Refused("the picks file is an object with no docs list")
    if not isinstance(raw, list):
        raise Refused("the picks file is not a list of docs")
    docs, bad = [], 0
    for d in raw:
        if not isinstance(d, dict):
            bad += 1
            continue
        fields = d["data"] if isinstance(d.get("data"), dict) else d
        did = next((d[k] for k in ("doc_id", "id", "_id", "name") if isinstance(d.get(k), str) and d[k]), None)
        if did is None:
            bad += 1
            continue
        docs.append((did, fields))
    return docs, bad


def pick_key(did, f):
    blob = json.dumps([did, f.get("action"), f.get("note"), f.get("at")], ensure_ascii=False, separators=(",", ":"))
    return hashlib.sha256(blob.encode("utf-8")).hexdigest()


def pick_text(value):
    return printable(" ".join(str(value).split()))


def cmd_picks(a):
    try:
        with open(a.file, encoding="utf-8") as f:
            raw = json.load(f)
    except FileNotFoundError:
        raise Refused(f"picks file {a.file} does not exist")
    except (OSError, ValueError) as err:
        raise Refused(f"picks file {a.file} cannot be read ({type(err).__name__})")
    docs, bad = pick_docs(raw)
    path = picks_seen_path()
    os.makedirs(STATE, exist_ok=True)
    reported = already = unready = 0
    with open(path, "a+", encoding="utf-8") as seen_f:
        fcntl.flock(seen_f, fcntl.LOCK_EX)
        seen_f.seek(0)
        seen, torn = set(), 0
        for line in seen_f:
            if not line.strip():
                continue
            try:
                seen.add(json.loads(line)["key"])
            except (ValueError, KeyError, TypeError):
                torn += 1
        for did, f in sorted(docs, key=lambda x: (str(x[1].get("at")), x[0])):
            if f.get("ready") is not True:
                unready += 1
                continue
            key = pick_key(did, f)
            if key in seen:
                already += 1
                continue
            label = f.get("action_label") or f.get("action") or "no action"
            print(f"pick {pick_text(did)}  {pick_text(f.get('section', ''))}  {pick_text(label)}  "
                  f"title: {pick_text(f.get('title', ''))}  note: {pick_text(f.get('note', '')) or 'none'}  "
                  f"by {pick_text(f.get('by', '')) or 'unknown'}  at {pick_text(f.get('at', '')) or 'unknown'}")
            sys.stdout.flush()
            append({"pick": did, "key": key, "seen_at": now()}, path=path)
            seen.add(key)
            reported += 1
    print(f"dws: {reported} new, {already} already reported, {unready} not ready"
          + (f", {bad} entr(ies) that were not a doc" if bad else "")
          + (f", {torn} unreadable line(s) in {path} skipped" if torn else ""), file=sys.stderr)


def main(argv):
    p = argparse.ArgumentParser(prog="dws", description="director workstream ledger (W1)")
    p.add_argument("--actor", default="director", help="the writer, a claim checked against the writer table")
