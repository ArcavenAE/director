#!/usr/bin/env bash
# merge-guard - the fail-closed read before any merge (R-152).
#
#   merge-guard <owner/repo> <number>
#
# Prints one line and exits:
#   PROCEED <repo>#<n> @<head sha>: ...   exit 0. Merge with
#                                         gh pr merge <n> -R <repo> --match-head-commit <sha>
#   STOP <repo>#<n>: <reason>              exit 1. Stop the merge run and report it.
#                                         Never downgrade a STOP to a skip.
#   usage error                            exit 2.
#
# It proceeds only when every read succeeds and says yes: the PR is OPEN (read
# first, since a merged PR reports an UNKNOWN merge state, R-157), not a draft
# (R-148), its merge state is CLEAN, every reported check passed, a non-author
# approved the current head after it reached GitHub and no reviewer's latest
# review, on any commit, requests changes (director#159), and no open PR is
# based on its head branch (stacked-pr-merge-order). A read that errors,
# times out, comes back empty or unparseable, or lacks a field stops, with its
# output. UNKNOWN is GitHub still computing mergeability, so it is re-read
# MERGE_GUARD_RETRIES times (default 3), MERGE_GUARD_DELAY seconds apart
# (default 5), and stops if it never resolves.
#
# An empty check list after a successful read is an answer, not a failed read:
# the repo reports no checks, and CLEAN already covers any required ones.
#
# Operator merge exclusions (R-153) are checked first. The exclusion records are
# read before gh is asked anything, from rulings.jsonl (MERGE_GUARD_RULINGS,
# default $DIRECTOR_STATE/rulings.jsonl, DIRECTOR_STATE default
# ~/.director/state): one JSON object per line, and only the lines whose kind is
# "exclusion" are read here. An exclusion is {"kind":"exclusion","repo":R,
# "label":L}; R and L compare without case and may be shell patterns (acu.*). A
# PR in a matching repo that carries a matching label STOPs, whatever its review
# or check state, before any other check. A rulings file that exists and cannot
# be read, a line that is not a JSON object, and an exclusion without a repo and
# a label all STOP: a record that might be an exclusion is never skipped. So
# does a missing rulings file, since a missing record cannot be told from none
# declared; create it, and empty means none declared. The labels come from the same gh pr view; a view with no label list STOPs. Like the rest
# of the guard this holds only for merges made through it; a merge made outside
# it stays honor-only.
#
# Read-only: it runs gh pr view, gh pr list and gh api (check suites), reads the
# rulings file, and never merges anything.
set -uo pipefail

[[ $# -eq 2 ]] || { sed -n '4,10p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }
repo="$1" num="$2"
retries="${MERGE_GUARD_RETRIES:-3}"
delay="${MERGE_GUARD_DELAY:-5}"

stop() { echo "STOP $repo#$num: $*"; exit 1; }
command -v jq >/dev/null || stop "jq not found; cannot read gh output"
command -v gh >/dev/null || stop "gh not found"

err="$(mktemp)"; trap 'rm -f "$err"' EXIT

# Exclusion records (R-153), read before any gh call. $excl holds one
# "repo<TAB>label" line per exclusion; $excl_note says what was read.
rulings="${MERGE_GUARD_RULINGS:-${DIRECTOR_STATE:-$HOME/.director/state}/rulings.jsonl}"
excl=""; excl_note="no exclusion records"
[[ -e "$rulings" ]] || stop "no rulings file at $rulings; the guard cannot tell no exclusions declared from a record that is gone (R-153). The operator creates the file and enters their exclusions (an empty file means none declared); a seat reports this STOP and does not create the file"
[[ -f "$rulings" ]] || stop "the rulings path $rulings exists and is not a file; cannot read the exclusion records (R-153)"
records="$(cat -- "$rulings" 2>"$err")" || stop "the rulings file $rulings cannot be read: $(tr '\n' ' ' <"$err")"
parsed="$(jq -R -c 'select(length > 0) | (fromjson? // error("a rulings line is not JSON: " + .))' <<<"$records" 2>"$err")" \
  || stop "the rulings file $rulings has a line that is not JSON: $(head -c 200 "$err" | tr '\n' ' ')"
excl="$(jq -r 'if type != "object" then error("a rulings line is not an object: " + tojson)
    elif .kind != "exclusion" then empty
    elif ((.repo | type) == "string" and (.repo | length) > 0 and (.label | type) == "string" and (.label | length) > 0)
      then "\(.repo)\t\(.label)"
    else error("an exclusion needs a repo and a label, both non-empty strings: " + tojson) end' <<<"$parsed" 2>"$err")" \
  || stop "the rulings file $rulings has an unreadable exclusion: $(head -c 200 "$err" | tr '\n' ' ')"
if [[ -n "$excl" ]]; then
  excl_note="$(grep -c . <<<"$excl") exclusion record(s), none matching"
fi

# read_json LABEL ARGS...: run gh, leave parseable output in $json, or STOP.
json=""
read_json() {
  local label="$1"; shift
  if ! json="$(gh "$@" 2>"$err")"; then
    stop "$label failed: $(tr '\n' ' ' <"$err")"
  fi
  [[ -n "${json//[[:space:]]/}" ]] || stop "$label returned nothing: $(tr '\n' ' ' <"$err")"
  jq -e . >/dev/null 2>&1 <<<"$json" || stop "$label returned something that is not JSON: $(head -c 160 <<<"$json" | tr '\n' ' ')"
}
field() { jq -r --arg f "$1" 'if has($f) then .[$f] | tostring else "__missing__" end' <<<"$json"; }

view() {
  read_json "gh pr view" pr view "$num" -R "$repo" \
    --json state,isDraft,mergeStateStatus,headRefName,headRefOid,statusCheckRollup,author,commits,reviews,labels
}

view

# Exclusions first, before the state or any other check. The labels must be a
# list of named labels; anything else is a view the guard cannot read.
jq -e '(.labels | type == "array") and all(.labels[]; (.name | type == "string") and (.name | length) > 0)' >/dev/null <<<"$json" \
  || stop "the view has no readable label list (labels missing, not a list, or a label with no name); cannot tell whether an operator exclusion applies (R-153)"
if [[ -n "$excl" ]]; then
  shopt -s nocasematch
  hits=""
  while IFS=$'\t' read -r xrepo xlabel; do
    [[ -n "$xrepo" ]] || continue
    # shellcheck disable=SC2053 # the right side is a pattern on purpose
    [[ "$repo" == $xrepo ]] || continue
    while IFS= read -r lname; do
      # shellcheck disable=SC2053
      [[ -n "$lname" && "$lname" == $xlabel ]] && hits="${hits:+$hits; }label $lname matches exclusion $xrepo $xlabel"
    done < <(jq -r '.labels[].name' <<<"$json")
  done <<<"$excl"
  shopt -u nocasematch
  [[ -z "$hits" ]] || stop "excluded by an operator merge exclusion (R-153): $hits; no seat merges this, whatever its review or check state"
fi

state="$(field state)"
[[ "$state" == OPEN ]] || stop "state is $state, not OPEN; nothing to merge (terminal state read first, R-157)"

draft="$(field isDraft)"
case "$draft" in
  false) ;;
  true) stop "it is a draft; a draft GATE is not merge-ready (R-148)" ;;
  *) stop "the view has no isDraft field; cannot tell a draft from a ready PR" ;;
esac

ms="$(field mergeStateStatus)"
tries=0
while [[ "$ms" == UNKNOWN && $tries -lt $retries ]]; do
  tries=$((tries + 1))
  sleep "$delay"
  view
  ms="$(field mergeStateStatus)"
done
case "$ms" in
  CLEAN) ;;
  UNKNOWN) stop "merge state is still UNKNOWN after $tries re-read(s); fail closed (R-152)" ;;
  ''|__missing__|null) stop "merge state is empty or missing; fail closed (R-152)" ;;
  *) stop "merge state is $ms, not CLEAN" ;;
esac

head_ref="$(field headRefName)"
head_sha="$(field headRefOid)"
[[ -n "$head_ref" && "$head_ref" != __missing__ && -n "$head_sha" && "$head_sha" != __missing__ ]] \
  || stop "the view has no head branch or head sha"

# Checks: a CheckRun passes on SUCCESS, NEUTRAL or SKIPPED; a StatusContext on
# SUCCESS. Anything else, including a run still going, stops.
jq -e '.statusCheckRollup | type == "array"' >/dev/null <<<"$json" \
  || stop "the check rollup is not a list; cannot read the checks"
not_passing="$(jq -r '.statusCheckRollup[]
  | if .__typename == "StatusContext" then
      select(.state != "SUCCESS") | "\(.context) \(.state)"
    else
      select((.conclusion // "") as $c | ["SUCCESS","NEUTRAL","SKIPPED"] | index($c) | not)
      | "\(.name) \(.conclusion // .status)"
    end' <<<"$json")"
[[ -z "$not_passing" ]] || stop "checks not passing: $(tr '\n' ';' <<<"$not_passing" | sed 's/;$//')"
nchecks="$(jq '.statusCheckRollup | length' <<<"$json")"

# Approval at the current head (director#159). A merge proceeds only on a
# non-author approval of the commit being merged, given after that commit
# reached GitHub. The sha alone is not enough: GitHub re-pins an approval to a
# head pushed after it (director#149), so the review must also postdate an
# anchor. The anchor is the later of the head's committer date and the earliest
# check suite GitHub created for the head sha. The committer date alone is a
# lower bound a past-dated or late-pushed commit slips under; the check suite
# is created when the sha is pushed. Neither is the time the sha joined this
# PR, which GitHub does not expose, so with no check suite at all the anchor is
# the committer date and the PROCEED line says so.
# A reviewer's latest review on ANY commit counts: a change request on earlier
# code stands until that reviewer re-reviews or it is dismissed, as GitHub
# keeps it. A missing field is a failed read, not a pass.
jq -e '(.reviews | type == "array") and (.commits | type == "array")' >/dev/null <<<"$json" \
  || stop "the view has no reviews or commits list; cannot tell whether the head is approved"
author="$(jq -r '.author.login // empty' <<<"$json")"
[[ -n "$author" ]] || stop "the view has no author; cannot tell an approval from a self-approval"
head_at="$(jq -r --arg h "$head_sha" '[.commits[] | select(.oid == $h)] | last | .committedDate // empty' <<<"$json")"
[[ -n "$head_at" ]] || stop "the head commit $head_sha is not in the view's commit list; cannot date it"
# Latest non-comment review per reviewer, on any commit, from anyone but the author.
latest="$(jq -c --arg a "$author" '
  [.reviews[]
   | select((.author.login // "") != $a)
   | select(.state == "APPROVED" or .state == "CHANGES_REQUESTED" or .state == "DISMISSED")]
  | group_by(.author.login) | map(max_by(.submittedAt))' <<<"$json")"
blocking="$(jq -r '.[] | select(.state == "CHANGES_REQUESTED") | "\(.author.login) at \((.commit.oid // "?")[:7])"' <<<"$latest" | tr '\n' ';')"
[[ -z "$blocking" ]] || stop "changes requested by ${blocking%;}; a change request stands until that reviewer re-reviews"

# The anchor: the earliest check suite at the head, when later than the commit.
read_json "gh api (check suites)" api "repos/$repo/commits/$head_sha/check-suites?per_page=100"
jq -e '(.check_suites | type == "array") and (.total_count | type == "number")' >/dev/null <<<"$json" \
  || stop "the check-suite read has no check_suites list; cannot date the push of $head_sha"
[[ "$(jq '.total_count <= (.check_suites | length)' <<<"$json")" == true ]] \
  || stop "the check-suite read is paged; cannot see the earliest suite at $head_sha"
suite_at="$(jq -r '[.check_suites[].created_at // empty] | min // empty' <<<"$json")"
anchor="$head_at"; anchor_note="its commit ($head_at)"
if [[ -z "$suite_at" ]]; then
  anchor_note="its commit ($head_at); no check suite, so the push time is unknown"
elif [[ "$suite_at" > "$head_at" ]]; then
  anchor="$suite_at"; anchor_note="its first check suite ($suite_at)"
fi
fresh="$(jq -r --arg h "$head_sha" --arg t "$anchor" '.[] | select(.state == "APPROVED" and (.commit.oid // "") == $h and .submittedAt > $t) | .author.login' <<<"$latest" | head -1)"
if [[ -z "$fresh" ]]; then
  stale="$(jq -r --arg h "$head_sha" --arg t "$anchor" '.[] | select(.state == "APPROVED" and (.commit.oid // "") == $h and .submittedAt <= $t) | "\(.author.login) at \(.submittedAt)"' <<<"$latest" | tr '\n' ';')"
  [[ -z "$stale" ]] || stop "the only approval at $head_sha was submitted before the head reached GitHub, anchored on $anchor_note: ${stale%;}; it approved earlier code"
  stop "no approval by a non-author at the head $head_sha after $anchor_note"
fi

# Stacked children: an open PR based on this head would be closed by merging
# with --delete-branch. An error or an empty read is not "no children".
read_json "gh pr list (stacked children)" pr list -R "$repo" --base "$head_ref" --state open --json number
jq -e 'type == "array"' >/dev/null <<<"$json" || stop "the stacked-child read is not a list"
children="$(jq -r '.[].number | "#\(.)"' <<<"$json" | tr '\n' ' ')"
[[ -z "$children" ]] || stop "open PR(s) based on $head_ref: ${children% }; merge the base without --delete-branch first (stacked-pr-merge-order)"

echo "PROCEED $repo#$num @$head_sha: OPEN, not draft, CLEAN, $nchecks check(s) passing, approved at head by $fresh after $anchor_note, no stacked child, $excl_note"
