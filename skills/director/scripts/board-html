#!/usr/bin/env python3
"""Render the director board (board.md) as a self-contained reactive HTML page.

Reads  $DIRECTOR_STATE/board.md   (default ~/.director/state/board.md)
Writes $DIRECTOR_STATE/board.html

Everything is inline: no CDN, no fetch, nothing leaves the machine. Rerun after
the board changes. A file:// page cannot see its own rebuild, so the page offers
an auto-refresh toggle that reloads on an interval and keeps scroll position,
search text and open sections across the reload.

Harness-neutral: plain Python 3 and file timestamps, no hooks. The board is
authored by whichever session holds the director role, so the writer rebuilds:
after editing board.md, run this if board.html already exists (opt-in by
existence; a director that never made the page pays nothing).
"""
import datetime
import html as htmlmod
import json
import os
import pathlib
import sys
import tempfile

HOME = pathlib.Path.home()
STATE = pathlib.Path(os.environ.get("DIRECTOR_STATE", HOME / ".director" / "state"))
SRC = STATE / "board.md"
OUT = STATE / "board.html"

TEMPLATE = r'''<!doctype html>
