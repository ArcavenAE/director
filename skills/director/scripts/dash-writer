#!/usr/bin/env python3
"""dash-writer - shape the operations dashboard's documents for the Desk's second tab.

ghxv2, sim/design/ops-dashboard.md sections 3 and 4 (the field list approved by the operator
2026-10-20, with dash_meta.checks added). One added step in director's sweep, in a session: a
script cannot write artifact data (finding-director-glst), so this script reads the sources and
prints the batch, and the session applies it with one ArtifactData batch of at most 50 writes.

  dash-writer run [--force] [--versions FILE]   print {"writes": [...], ...}; nothing is written but the output.
                               FILE is a JSON object {"collection/doc_id": version} of the dash_panels, dash_daily
                               and dash_meta documents that exist; the writes carry `op` and, for a document in the
                               map, `if_version`. Without the map, or with one that cannot be read, no writes print
  dash-writer ack --at T [--deleted D,D]   the batch was applied: record the run (the 30-minute floor, the run
                               count); T and D are the run's own `ack` field, so the clock at ack time never matters
  dash-writer --help

The fifth panel, `health`, is the fleet-health record (sim/design/fleet-health.md): it reads
$DIRECTOR_STATE/freebusy/health.jsonl, which freebusy writes, and keeps counts, never captured text. Its counts
are {blocked, not_reached, mail_open, versions, drift, level}, where level is red (a blocked seat or an unreached
cluster), amber (an open mail episode or version drift) or green, and the Fleet health row of the director's
Fleet Metrics page reads exactly this counts object from dash_panels/health. A record that is absent, unreadable
or more than an hour old refuses the panel (health:unread, health:stale) and shows no level, never green.

Sources, read only: `dws show --json` (the ledger folded by dws's own fold, so the page cannot fold
differently), `marvel --cluster C get sessions --columns team,role,name,state,health,last-active`
once for each cluster `marvel config list` names (command: $DASH_MARVEL, default marvel, waited for DASH_MARVEL_TIMEOUT seconds, 1 to 60, default 20), and
$DIRECTOR_STATE/desk-snapshot.json. The list is read as freebusy reads it: the NAME column only, so this script
gets the cluster names and nothing else, no other column is kept or emitted, and the command's own messages are
dropped. marvel holds `clusters:` as a list, so no key of the config file is read. A list that cannot be read,
names no cluster, or holds an unusable name refuses the sessions panel, never an empty one, and the refusal
carries its reason as clusters:unavailable, timeout, failed, empty or bad-name. The Desk's
area labels are the `areas` list the snapshot records; no snapshot, or no list, labels nothing.
Two local files, one entry per line, because no canonical source holds them: the director session keeps
`dash-withhold.txt` and `dash-area-map.tsv` in its own state, 0600:
  dash-area-map.tsv    <workstream slug><TAB><area label>; a ledger row carries no area, so this maps
                       the slug to a Desk area; a row with no entry (or an unlisted area) is `unlabelled`
  dash-withhold.txt    private names, whole words, any case. Absent, unreadable, not UTF-8, not a plain file, or
                       wider than 0600: the waiting, in-flight and sessions panels are refused (no rows, no counts),
                       since a title, an id and a session name can all carry one; no list is never read as no filter

It writes exactly the fields of section 3 and nothing else:
  dash_panels/<panel>  panel, as_of, writer, rows, counts, refusal
  dash_daily/<panel>-<day>  panel, day, counts   (kept 14 days: the batch deletes every recorded day 14 or more
                       days back, and the day exactly 14 back; a batch is 2 writes per panel plus the meta write,
                       11 with the five panels, plus 5 per day deleted, at most 50)
  dash_meta/writer     last_run, runs, reader, checks
A row holds only id, stage, age_h, area, title (ledger rows), id, stage, health, last_active,
cluster (session rows) or kind, id, class, since, cluster (health rows). Never a token, key, socket path, settings value, message body, note text,
`next`, `repos`, or a person's name. Every failure is counted in the panel's `refusal` by field and
reason, never by value; a placeholder is a fixed word, so nothing from a failed value reaches a document.

A panel over 256 KiB is not written cut short: its rows are dropped and its refusal says so.
Exit 0 on every reading; exit 2 for a usage error. DWS_NOW overrides the clock only with DWS_TEST_CLOCK=1.
"""
import datetime
import json
import os
import re
import stat
import subprocess
import sys
import tempfile

HOME = os.path.expanduser("~")
STATE = os.environ.get("DIRECTOR_STATE") or f"{HOME}/.director/state"
HERE = os.path.dirname(os.path.realpath(__file__))
STAGES = ["idea", "defined", "designed", "building", "in review", "merged", "released", "deployed", "accepted", "parked"]
FLIGHT = ("defined", "designed", "building", "in review")
DOC_CAP = 256 * 1024
MAX_WRITES = 50
FLOOR_MIN = 30
KEEP_DAYS = 14
TITLE_MAX = 120
COLUMNS = "team,role,name,state,health,last-active"
HEADER = ["TEAM", "ROLE", "AGENT NAME", "STATE", "HEALTH", "LAST-ACTIVE"]
PANELS = ("waiting", "where-work-sits", "in-flight", "sessions", "health")
HEALTH_CLASSES = ("auth-expired", "consent-dialog", "automode-menu", "other-dialog")
HEALTH_MAX_AGE_S = 3600
READER = "dws show --json; marvel get sessions; freebusy health.jsonl"

ID_RE = re.compile(r"[a-z0-9.-]{1,80}")
STATE_RE = re.compile(r"(pending|running|limited|succeeded|failed|crashloop-backoff|crashed)(?: \((.*)\))?", re.S)
HEALTH_RE = re.compile(r"(alive|healthy|unhealthy|unknown)( \(stalled\))?(?: (\(logged-out\)|\(parked(?:: .*)?\)))?", re.S)
AGE_WORD = r"(?:[0-9]{1,4}[smhd]|[0-9]{1,3}h[0-9]{1,2}m)"
ACTIVE_RE = re.compile(r"(?:[-\u2013\u2014]|" + AGE_WORD + r"|stale(?: " + AGE_WORD + r")?)\*?")
PATH_RE = re.compile(r"(~/|/Users/|/home/|/private/|/tmp/|/var/|(?:^|\s)/[^\s/]*/)")
TOKEN_RE = re.compile(r"(ghp_|gho_|ghs_|github_pat_|xox|sk-|AKIA|[A-Za-z0-9+/]{24,})")
TOKEN_PREFIX = ("ghp_", "gho_", "ghs_", "github_pat_", "xox", "sk-", "AKIA")
CLUSTER_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}")


class Usage(Exception):
    pass


def now():
    fixed = os.environ.get("DWS_NOW") if os.environ.get("DWS_TEST_CLOCK") == "1" else None
    t = fixed or datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    return t, datetime.datetime.strptime(t, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)


def parse_ts(s):
    try:
        return datetime.datetime.strptime(str(s), "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
    except ValueError:
        return None


def read_list(name):
    path = os.path.join(STATE, name)
    try:
        with open(path, encoding="utf-8") as f:
            return [l.strip() for l in f if l.strip() and not l.lstrip().startswith("#")], path
    except (OSError, UnicodeDecodeError):
        return None, path


def load_withhold():
    """(names, why): why is None, "absent", "mode" or "unreadable". A file that is absent, unreadable, not a regular
    file, not UTF-8, or wider than 0600 is a refusal, never no list: it fails closed, on one branch."""
    path = os.path.join(STATE, "dash-withhold.txt")
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)  # a FIFO must not hang the open
    except FileNotFoundError:
        return None, "absent"
    except OSError:
        return None, "unreadable"
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, "unreadable"
        if st.st_mode & 0o077:
            return None, "mode"
        with os.fdopen(fd, "rb", closefd=False) as f:
            text = f.read().decode("utf-8")
    except (OSError, UnicodeDecodeError):
        return None, "unreadable"
    finally:
        os.close(fd)
    return [l.strip() for l in text.splitlines() if l.strip() and not l.lstrip().startswith("#")], None


def config_timeout():
    """Seconds to wait for `marvel config list`: DASH_MARVEL_TIMEOUT when it is a number from 1 to 60, else 20."""
    try:
        v = float(os.environ.get("DASH_MARVEL_TIMEOUT", "20"))
    except ValueError:
        return 20.0
    return v if 1 <= v <= 60 else 20.0


def cluster_names():
    """(names, reason): the cluster names `marvel config list` prints, or (None, why) when they cannot be read.

    Only the NAME column is kept: the first word of each line, or the second after a lone "*" (the marker
    for the current cluster, which is not a name). Every other column is dropped as the line is split, so no
    value from the config is held, and nothing the command prints to stderr is kept. The reason is a fixed
    word, never a value: unavailable (the command cannot be run), timeout, failed (a nonzero exit, whatever it
    printed), empty (no name) or bad-name (a name that is not a plain cluster name). Any of them refuses the
    sessions panel and shows nothing from the config.
    """
    marvel = os.environ.get("DASH_MARVEL", "marvel")
    try:
        p = subprocess.run([marvel, "config", "list"], capture_output=True, timeout=config_timeout(), stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return None, "timeout"
    except OSError:
        return None, "unavailable"
    if p.returncode != 0:
        return None, "failed"
    names = []
    for line in p.stdout.decode("utf-8", "replace").splitlines():
        words = line.split()
        if not words or words[0] == "NAME":
            continue
        name = words[0]
        if name == "*":
            name = words[1] if len(words) > 1 else ""
        elif name.startswith("*"):
            name = name[1:]
        del words
        if not CLUSTER_RE.fullmatch(name):
            return None, "bad-name"  # anything that is not a plain cluster name: no value can pass as one
        names.append(name)
    return (names, None) if names else (None, "empty")


def snapshot_areas():
    """The area labels the Desk snapshot records, or [] when it has none."""
    try:
        with open(os.path.join(STATE, "desk-snapshot.json"), encoding="utf-8") as f:
            a = json.load(f).get("areas")
    except (OSError, ValueError, AttributeError):
        return []
    return [x for x in a if isinstance(x, str) and x and x.isprintable()] if isinstance(a, list) else []


class Refusals:
    def __init__(self):
        self.c = {}

    def add(self, field, reason):
        k = f"{field}:{reason}"
        self.c[k] = self.c.get(k, 0) + 1


def free_text_reason(value, withhold):
    """Why a free-text value (id, title, last_active) is refused, or None. The reason is a fixed word."""
    if not isinstance(value, str) or not value or not all(c.isprintable() for c in value):
        return "control"
    if PATH_RE.search(value):
        return "path"
    if "://" in value or "@" in value:
        return "url"
    if TOKEN_RE.search(value) or value.startswith(TOKEN_PREFIX):
        return "token"
    for name in withhold:
        if re.search(r"(?<![A-Za-z0-9])" + re.escape(name) + r"(?![A-Za-z0-9])", value, re.I):
            return "withheld-name"
    return None


# ----------------------------------------------------------------------------------- sources
def ledger():
    exe = os.path.join(HERE, "dws")
    try:
        p = subprocess.run([sys.executable, exe, "show", "--json"], capture_output=True, timeout=60, stdin=subprocess.DEVNULL, env=os.environ.copy())
        if p.returncode != 0:
            return None, "dws show failed"
        return json.loads(p.stdout.decode("utf-8")), None
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None, "dws show could not be read"


def parse_table(text):
    """(rows of six cells, refusal reasons). Refuses the whole table on a header mismatch and a row alone
    when it cannot be cut cleanly; never draws a shifted value."""
    lines = text.split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    if not lines:
        return None, ["header"]
    head = lines[0].rstrip("\n")
    offs, pos = [], 0
    for i, lab in enumerate(HEADER):
        if not head.startswith(lab, pos):
            return None, ["header"]
        offs.append(pos)
        pos += len(lab)
        if i < len(HEADER) - 1:
            spaces = len(head[pos:]) - len(head[pos:].lstrip(" "))
            if spaces < 2:
                return None, ["header"]
            pos += spaces
    if head[pos:].strip():
        return None, ["header"]
    rows, bad = [], []
    for ln in lines[1:]:
        if not ln.strip():
            break
        if any(ord(c) < 32 or ord(c) == 127 for c in ln):
            bad.append("row")
            continue
        if len(ln) <= offs[-1]:
            bad.append("row")
            continue
        cells, ok = [], True
        for i, o in enumerate(offs):
            if ln[o] == " ":
                ok = False
                break
            if i > 0 and ln[o - 2:o] != "  ":
                ok = False
                break
            end = offs[i + 1] if i + 1 < len(offs) else len(ln)
            cells.append(ln[o:end].rstrip())
        if not ok or any(not c for c in cells):
            bad.append("row")
            continue
        rows.append(cells)
    return rows, bad


def sessions_for(cluster, refusal):
    marvel = os.environ.get("DASH_MARVEL", "marvel")
    try:
        p = subprocess.run([marvel, "--cluster", cluster, "get", "sessions", "--columns", COLUMNS], capture_output=True,
                           timeout=60, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if p.returncode != 0:
        return None
    return p.stdout.decode("utf-8", "replace")


def clean_state(cell):
    m = STATE_RE.fullmatch(cell)
    if not m:
        return None
    base, suffix = m.group(1), m.group(2)
    if suffix is None:
        return base
    if base == "failed":
        return "failed (terminal)"
    if base in ("succeeded", "crashed") and re.fullmatch(r"exit [0-9]{1,3}", suffix):
        return f"{base} ({suffix})"
    return None


def clean_health(cell):
    if re.search(r"\(parked.*\(stalled\)", cell, re.S) or "\n" in cell:
        return None
    m = HEALTH_RE.fullmatch(cell)
    if not m:
        return None
    base, stalled, tail = m.group(1), m.group(2) or "", m.group(3) or ""
    if tail.startswith("(parked"):
        tail = " (parked)"
    elif tail:
        tail = " " + tail
    return base + stalled + tail


# ----------------------------------------------------------------------------------- panels
def hours_since(ts_s, t_now):
    t = parse_ts(ts_s)
    if t is None:
        return None
    return max(0.0, round((t_now - t).total_seconds() / 3600.0, 1))


def ledger_row(r, t_now, areas, area_map, withhold, refusal, with_title=True):
    slug = r.get("slug", "")
    stage = r.get("stage")
    if not isinstance(slug, str) or not ID_RE.fullmatch(slug):
        refusal.add("id", "charset")
        return None
    why = free_text_reason(slug, withhold)
    if why:
        refusal.add("id", why)
        return None
    if stage not in STAGES:
        refusal.add("stage", "unknown")
        return None
    row = {"id": slug, "stage": stage}
    age = hours_since(r.get("last_moved"), t_now)
    if age is None:
        refusal.add("age_h", "not-a-number")
        row["age_h"] = ""
    else:
        row["age_h"] = age
    label = area_map.get(slug)
    if label is not None and label in areas:
        row["area"] = label
    else:
        refusal.add("area", "unlabelled")
        row["area"] = "unlabelled"
    if with_title:
        title = r.get("title", "")
        if not isinstance(title, str) or len(title) > TITLE_MAX:
            row["title"] = "(title withheld: length)"
            refusal.add("title", "length")
        else:
            why = free_text_reason(title, withhold)
            if why:
                row["title"] = f"(title withheld: {why})"
                refusal.add("title", why)
            else:
                row["title"] = title
    return row


def session_rows(clusters, withhold, refusal, t_text):
    rows, counts, not_reached = [], {}, []
    for cluster in clusters:
        if not CLUSTER_RE.fullmatch(cluster):
            refusal.add("cluster", "charset")
            continue
        text = sessions_for(cluster, refusal)
        if text is None:
            not_reached.append(f"{cluster}: not reached at {t_text}")
            continue
        cells, bad = parse_table(text)
        if cells is None:
            refusal.add("table", "header")
            continue
        for _ in bad:
            refusal.add("row", "unreadable")
        n = 0
        for team, role, name, state, health, active in cells:
            why = None if ID_RE.fullmatch(name) else "charset"
            why = why or free_text_reason(name, withhold)
            if why:
                refusal.add("id", why)
                continue
            st = clean_state(state)
            if st is None:
                refusal.add("stage", "grammar")
                continue
            hl = clean_health(health)
            if hl is None:
                refusal.add("health", "grammar")
                hl = "unreadable"
            la = active
            if len(la) > 40 or not ACTIVE_RE.fullmatch(la) or free_text_reason(la, withhold):
                refusal.add("last_active", "unreadable")
                la = "unreadable"
            rows.append({"id": name, "stage": st, "health": hl, "last_active": la, "cluster": cluster})
            n += 1
        counts[cluster] = n
    return rows, counts, not_reached


def health_rows(t_now, withhold, refusal):
    """(rows, counts) from freebusy's health.jsonl, or ([], {}) with a fixed-word refusal. Only the class, the seat,
    the cluster and the times are read from it; nothing else in a row is carried into the document."""
    path = os.path.join(STATE, "freebusy", "health.jsonl")
    try:
        with open(path, encoding="utf-8") as f:
            recs = [json.loads(l) for l in f if l.strip()]
    except (OSError, ValueError, UnicodeDecodeError):
        refusal.add("health", "unread")
        return [], {}
    stamps = [parse_ts(r.get("at")) for r in recs if isinstance(r, dict)]
    stamps = [t for t in stamps if t is not None]
    if not recs or not stamps or any(not isinstance(r, dict) for r in recs):
        refusal.add("health", "unread")
        return [], {}
    if (t_now - min(stamps)).total_seconds() > HEALTH_MAX_AGE_S:
        refusal.add("health", "stale")
        return [], {}
    rows = []
    blocked = unreached = mail = 0
    versions = set()
    for r in recs:
        kind = r.get("kind")
        if kind == "seat":
            seat, cluster, cls, since = r.get("seat"), r.get("cluster"), r.get("class"), r.get("since")
            why = None if isinstance(seat, str) and ID_RE.fullmatch(seat) else "charset"
            why = why or free_text_reason(seat, withhold)
            if why:
                refusal.add("id", why)
                continue
            if not isinstance(cluster, str) or not CLUSTER_RE.fullmatch(cluster):
                refusal.add("cluster", "charset")
                continue
            if cls not in HEALTH_CLASSES or parse_ts(since) is None:
                refusal.add("class", "grammar")
                continue
            blocked += 1
            rows.append({"kind": "blocked", "id": seat, "class": cls, "since": since, "cluster": cluster})
        elif kind == "cluster" and r.get("state") == "not_reached":
            cluster, since = r.get("cluster"), r.get("first_failed")
            if not isinstance(cluster, str) or not CLUSTER_RE.fullmatch(cluster) or parse_ts(since) is None:
                refusal.add("cluster", "charset")
                continue
            unreached += 1
            rows.append({"kind": "unreached", "id": cluster, "class": "not_reached", "since": since, "cluster": cluster})
        elif kind == "mail":
            seat, since = r.get("seat"), r.get("since")
            why = None if isinstance(seat, str) and ID_RE.fullmatch(seat) else "charset"
            why = why or free_text_reason(seat, withhold)
            if why:
                refusal.add("id", why)
                continue
            if parse_ts(since) is None:
                refusal.add("class", "grammar")
                continue
            mail += 1
            rows.append({"kind": "mail", "id": seat, "class": "unacked-mail", "since": since, "cluster": ""})
        elif kind == "version" and isinstance(r.get("version"), str) and re.fullmatch(r"[A-Za-z0-9._+-]{1,80}", r["version"]):
            versions.add(r["version"])
    drift = 1 if len(versions) > 1 else 0
    level = "red" if blocked or unreached else ("amber" if mail or drift else "green")
    rows.sort(key=lambda x: (x["since"], x["id"]))
    return rows, {"blocked": blocked, "not_reached": unreached, "mail_open": mail, "versions": len(versions), "drift": drift, "level": level}


def build(t_text, t_now):
    withhold, wwhy = load_withhold()
    areas = snapshot_areas()
    area_map = {}
    amap, _ = read_list("dash-area-map.tsv")
    for line in amap or []:
        if "\t" in line:
            k, v = line.split("\t", 1)
            area_map[k.strip()] = v.strip()
    clusters, clusters_why = cluster_names()
    data, why = ledger()
    panels = {p: {"rows": [], "counts": {}, "refusal": Refusals()} for p in PANELS}
    ledger_rows = data.get("rows", []) if data else []
    wl = withhold or []

    def lrow(r, refusal):
        return ledger_row(r, t_now, areas, area_map, wl, refusal)

    if data is None:
        for p in ("waiting", "where-work-sits", "in-flight"):
            panels[p]["refusal"].add("ledger", "unread")
    else:
        ref = panels["waiting"]["refusal"]
        for r in ledger_rows:
            blocked = r.get("blocked")
            if isinstance(blocked, str) and blocked.strip().lower() == "operator" and r.get("stage") != "parked":
                row = lrow(r, ref)
                if row:
                    panels["waiting"]["rows"].append(row)
        panels["waiting"]["rows"].sort(key=lambda x: -(x["age_h"] if isinstance(x["age_h"], (int, float)) else 0))
        panels["waiting"]["counts"] = {"blocked_on_operator": len(panels["waiting"]["rows"])}
        by = {}
        ideas_opened = []
        for r in ledger_rows:
            st = r.get("stage")
            if st in STAGES:
                by[st] = by.get(st, 0) + 1
            if st == "idea" and isinstance(r.get("opened"), str):
                ideas_opened.append(r["opened"][:10])
        c = {st: by.get(st, 0) for st in STAGES}
        c["ideas_oldest_opened"] = min(ideas_opened) if ideas_opened else ""
        panels["where-work-sits"]["counts"] = c
        fl = []
        for r in ledger_rows:
            if r.get("stage") in FLIGHT:
                row = lrow(r, panels["in-flight"]["refusal"])
                if row:
                    fl.append(row)
        fl.sort(key=lambda x: (-(x["age_h"] if isinstance(x["age_h"], (int, float)) else 0), x["id"]))
        panels["in-flight"]["rows"] = fl
        panels["in-flight"]["counts"] = {"in_flight": len(fl)}
    sref = panels["sessions"]["refusal"]
    if wwhy:
        pass  # every panel the withhold list filters is refused below, so marvel is not asked
    elif not clusters:
        sref.add("clusters", clusters_why)
        panels["sessions"]["counts"] = {"not_reached": []}
    else:
        rows, counts, nr = session_rows(clusters, wl, sref, t_text)
        panels["sessions"]["rows"] = rows
        panels["sessions"]["counts"] = dict(counts, not_reached=nr)
    if not wwhy:
        panels["health"]["rows"], panels["health"]["counts"] = health_rows(t_now, wl, panels["health"]["refusal"])
    if wwhy:
        # the list cannot be trusted: no title, id or session name goes out from any panel it filters
        for name in ("waiting", "in-flight", "sessions", "health"):
            panels[name] = {"rows": [], "counts": {}, "refusal": Refusals()}
            panels[name]["refusal"].add("withhold-file", wwhy)
    return panels, data


def checks_of(data, t_now):
    out = []
    last = (data or {}).get("last_refresh") if data else None
    at = parse_ts(last["at"]) if isinstance(last, dict) else None
    if at is None:
        out.append({"name": "refresh-ran-today", "holds": False, "observed": "never"})
    else:
        age = (t_now - at).total_seconds()
        out.append({"name": "refresh-ran-today", "holds": 0 <= age <= 86400, "observed": last["at"]})
    snap = os.path.join(STATE, "desk-snapshot.json")
    state_word = "missing"
    if os.path.isfile(snap):
        try:
            json.load(open(snap, encoding="utf-8"))
            state_word = "exists"
        except (OSError, ValueError):
            state_word = "unreadable"
    out.append({"name": "desk-snapshot-exists", "holds": state_word == "exists", "observed": state_word})
    n = 0
    for r in (data or {}).get("rows", []) if data else []:
        st = r.get("stage")
        if st in STAGES and STAGES.index(st) > 0 and not r.get("links"):
            n += 1
    out.append({"name": "rows-past-idea-linked", "holds": data is not None and n == 0, "observed": f"{n} rows past idea with no link" if data is not None else "ledger unread"})
    return out


def state_path():
    return os.path.join(STATE, "dash-writer.json")


def read_state():
    try:
        d = json.load(open(state_path(), encoding="utf-8"))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def expired_days(st, t_now):
    """The days whose daily docs are to be deleted in this batch: every recorded day 14 or more days back, and
    the day exactly 14 back (the only one a state with no record can name), oldest first. The batch is a panel
    write and a daily write for each panel plus the meta write, and one delete per panel for each expired day,
    so at most (MAX_WRITES - base_writes()) // len(PANELS) days go in one batch and the rest wait."""
    cutoff = (t_now - datetime.timedelta(days=KEEP_DAYS)).strftime("%Y-%m-%d")
    days = {d for d in st.get("days", []) if isinstance(d, str) and re.fullmatch(r"\d{4}-\d\d-\d\d", d) and d <= cutoff}
    days.add(cutoff)
    return sorted(days)


def base_writes():
    """Writes in a batch that deletes nothing: a panel and a daily document per panel, and the meta document."""
    return 2 * len(PANELS) + 1


def batch_days(st, t_now, versions):
    """The expired days this batch deletes: oldest first, only days with a document in the map (a delete of a
    document that is not there has nothing to remove), at most (MAX_WRITES - base_writes()) // len(PANELS) of them."""
    live = [d for d in expired_days(st, t_now)
            if any(f"dash_daily/{name}-{d}" in versions for name in PANELS)]
    return live[:(MAX_WRITES - base_writes()) // len(PANELS)]


def load_versions(path):
    """({"collection/doc_id": version}, None), or (None, why) with a fixed word. A version is an integer or a
    non-empty string, as the documents show it; anything else refuses the map, so no write carries a guess."""
    try:
        with open(path, encoding="utf-8") as f:
            m = json.load(f)
    except (OSError, ValueError):
        return None, "unreadable"
    if not isinstance(m, dict):
        return None, "not-an-object"
    for k, v in m.items():
        if not isinstance(k, str) or k.count("/") != 1 or not all(k.split("/")):
            return None, "bad-key"
        if isinstance(v, bool) or not (isinstance(v, int) or (isinstance(v, str) and v)):
            return None, "bad-version"
    return m, None


def size_of(doc):
    return len(json.dumps(doc, ensure_ascii=False, separators=(",", ":")).encode("utf-8"))


def put(op, collection, doc_id, versions, data=None):
    w = {"op": op, "collection": collection, "doc_id": doc_id}
    v = versions.get(f"{collection}/{doc_id}")
    if v is not None:
        w["if_version"] = v
    if data is not None:
        w["data"] = data
    return w


def cmd_run(force, versions_path):
    t_text, t_now = now()
    st = read_state()
    last = parse_ts(st.get("last_run"))
    if last and not force and 0 <= (t_now - last).total_seconds() < FLOOR_MIN * 60:
        print(json.dumps({"skipped": f"last run {st['last_run']}, under the {FLOOR_MIN}-minute floor", "writes": []}))
        return
    if versions_path is None:
        print(json.dumps({"writes": [], "needs": "versions", "hint": "list dash_panels, dash_daily and dash_meta, write {collection/doc_id: version} to a file, and run again with --versions FILE"}))
        return
    versions, vwhy = load_versions(versions_path)
    if versions is None:
        print(json.dumps({"writes": [], "refused": f"versions:{vwhy}"}))
        return
    panels, data = build(t_text, t_now)
    today = t_now.strftime("%Y-%m-%d")
    expired = batch_days(st, t_now, versions)
    writes = []
    for name in PANELS:
        p = panels[name]
        doc = {"panel": name, "as_of": t_text, "writer": "director", "rows": p["rows"], "counts": p["counts"], "refusal": dict(sorted(p["refusal"].c.items()))}
        if size_of(doc) > DOC_CAP:
            doc["rows"] = []
            doc["refusal"] = dict(doc["refusal"], **{"panel:over-256KiB": 1})
        writes.append(put("set", "dash_panels", name, versions, doc))
    for name in PANELS:
        writes.append(put("set", "dash_daily", f"{name}-{today}", versions,
                          {"panel": name, "day": today, "counts": panels[name]["counts"]}))
    for day in expired:
        for name in PANELS:
            if f"dash_daily/{name}-{day}" in versions:
                writes.append(put("delete", "dash_daily", f"{name}-{day}", versions))
    meta = {"last_run": t_text, "runs": int(st.get("runs", 0)) + 1, "reader": READER, "checks": checks_of(data, t_now)}
    writes.append(put("set", "dash_meta", "writer", versions, meta))
    print(json.dumps({"writes": writes, "ack": {"at": t_text, "deleted": expired}}, ensure_ascii=False, indent=1))


def cmd_ack(at, deleted):
    """Record the run `at` named and the days it deleted; this process's own clock is never read."""
    day_re = r"\d{4}-\d\d-\d\d"
    try:
        t_now = datetime.datetime.strptime(at, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
    except ValueError:
        print("dash-writer: --at is the run's time, as printed in its ack field", file=sys.stderr)
        sys.exit(2)
    st = read_state()
    try:
        for d in deleted:
            datetime.datetime.strptime(d, "%Y-%m-%d")  # a real calendar day, not just a date-shaped string
    except ValueError:
        print("dash-writer: --deleted is a comma list of days, as printed in the run's ack field", file=sys.stderr)
        sys.exit(2)
    if not set(deleted) <= set(expired_days(st, t_now)):
        print("dash-writer: --deleted names a day the run did not report as expired", file=sys.stderr)
        sys.exit(2)
    days = sorted({d for d in st.get("days", []) if isinstance(d, str) and re.fullmatch(day_re, d)} - set(deleted)
                  | {t_now.strftime("%Y-%m-%d")})
    st = {"last_run": at, "runs": int(st.get("runs", 0)) + 1, "days": days}
    os.makedirs(STATE, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=STATE, prefix=".dash-writer.")
    with os.fdopen(fd, "w") as f:
        json.dump(st, f)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, state_path())
    print(f"recorded run {st['runs']} at {at}")


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("--help", "-h"):
        print(__doc__)
        return
    if a[0] == "run":
        rest, force, vpath = a[1:], False, None
        while rest:
            if rest[0] == "--force" and not force:
                force, rest = True, rest[1:]
            elif rest[0] == "--versions" and vpath is None and len(rest) > 1:
                vpath, rest = rest[1], rest[2:]
            else:
                print("usage: dash-writer run [--force] [--versions <file>] | ack --at <run time> [--deleted <days>] | --help", file=sys.stderr)
                sys.exit(2)
        cmd_run(force, vpath)
    elif a[0] == "ack" and len(a) in (3, 5) and a[1] == "--at" and (len(a) == 3 or a[3] == "--deleted"):
        cmd_ack(a[2], [d for d in (a[4].split(",") if len(a) == 5 else []) if d])
    else:
        print("usage: dash-writer run [--force] [--versions <file>] | ack --at <run time> [--deleted <days>] | --help", file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main()
