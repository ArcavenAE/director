#!/usr/bin/env python3
"""lane-ledger - render C1 of the fleet flow pages (the lane ledger) from director's own files.

Why: the first C1 was hand-built once from one cluster's CSVs, so it read nearly all GAP and
never changed. This page regenerates from what director already reads every sweep, so it fills
in as the sources do and says, cell by cell, what is still missing and what would fix it.

  lane-ledger [--out FILE] [--marry FILE]
  lane-ledger --help

Reads, all optional; a missing or unreadable source prints a GAP line and a GAP cell, never a 0:
  $DIRECTOR_STATE/freebusy/seats.jsonl   one row per seat, from freebusy (all clusters)
  $DIRECTOR_STATE/freebusy/lanes.jsonl   one row per lane, with its open asks, from freebusy
  $DIRECTOR_STATE/desk-snapshot.json     the operator's open Desk cards, from desk-snapshot
  --marry FILE                           a `marvel marry` output (MarryOutput JSON), for the
                                         "ready for the lane" column; default
                                         $DIRECTOR_STATE/freebusy/marry.json
Two local files the operator keeps, never in git, because no canonical source holds them:
  lane-ledger-show.txt   one "<workspace>/<team>" per line ("#" comments allowed): the teams the
                         page may name. Every other team prints as "team withheld", keeping only
                         its role word, cluster and counts. Absent: every team is withheld.
  dash-withhold.txt      the same private-name list dash-writer reads (whole words, any case). A
                         team, role or seat name that holds one is withheld even when listed above.

Writes FILE (default $DIRECTOR_STATE/flow/c1.html), atomically, mode 600. Its parent directory
must be outside any checkout. The page is a full document with the flow pages' navigation bar,
no external loads, no forms or scripts beyond its embedded JSON data, ASCII only.

Deterministic: the same inputs give the same bytes. The page's as-of times come from the inputs,
never from the clock. It sends nothing, injects nothing, writes no bd record and calls no gh or
marvel command: the caller runs `marvel marry` and passes its output.

A diagnostic, not a gate: it exits 0 whatever it finds; 2 for a usage error.
"""
import html
import json
import os
import re
import sys
import tempfile

HOME = os.path.expanduser("~")
STATE = os.environ.get("DIRECTOR_STATE") or os.path.join(HOME, ".director", "state")
STATES = ("free", "busy", "waiting", "unknown")
WITHHELD = "team withheld"

# What would fill each GAP, printed as a numbered footnote wherever the GAP shows.
FIX = {
    "seats": "freebusy writes freebusy/seats.jsonl on the sweep",
    "lanes": "freebusy writes freebusy/lanes.jsonl on the sweep",
    "asks": "the asks rollup from director-mcp asks --json, read by freebusy",
    "unread": "marvel exposes consumer pending per seat (S11)",
    "last_turn": "freebusy reads marvel's LAST-TURN column once it is deployed on the cluster",
    "runtime": "an idle signal for codex, opencode and crush seats; until then their free and busy read ACTIVE% only",
    "ready": "the M2 shadow run writes a marvel marry output (freebusy/marry.json)",
    "desk": "desk-snapshot writes desk-snapshot.json from a Desk read",
    "client": "a client-item count in the Desk snapshot",
    "host": "the team-to-host map in git, which places bd event writers",
    "show": "the operator lists the teams this page may name in lane-ledger-show.txt",
}


def usage(code):
    sys.stdout.write(__doc__ if code == 0 else "usage: lane-ledger [--out FILE] [--marry FILE]\n")
    sys.exit(code)


def args(argv):
    out = os.path.join(STATE, "flow", "c1.html")
    marry = os.path.join(STATE, "freebusy", "marry.json")
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            usage(0)
        if a in ("--out", "--marry") and i + 1 < len(argv) and argv[i + 1]:
            if a == "--out":
                out = argv[i + 1]
            else:
                marry = argv[i + 1]
            i += 2
            continue
        usage(2)
    return out, marry


def read_jsonl(path, gaps, name):
    try:
        with open(path, "rb") as f:
            raw = f.read().decode("utf-8")
    except FileNotFoundError:
        gaps.append("%s: %s not found" % (name, os.path.basename(path)))
        return None
    except (OSError, UnicodeDecodeError) as e:
        gaps.append("%s: %s unreadable (%s)" % (name, os.path.basename(path), type(e).__name__))
        return None
    rows = []
    for n, line in enumerate(raw.splitlines(), 1):
        if not line.strip():
            continue
        try:
            r = json.loads(line)
        except ValueError:
            gaps.append("%s: line %d is not JSON; the file is not used" % (name, n))
            return None
        if not isinstance(r, dict):
            gaps.append("%s: line %d is not an object; the file is not used" % (name, n))
            return None
        rows.append(r)
    return rows


def read_json(path, gaps, name):
    try:
        with open(path, "rb") as f:
            v = json.loads(f.read().decode("utf-8"))
    except FileNotFoundError:
        gaps.append("%s: %s not found" % (name, os.path.basename(path)))
        return None
    except (OSError, ValueError, UnicodeDecodeError) as e:
        gaps.append("%s: %s unreadable (%s)" % (name, os.path.basename(path), type(e).__name__))
        return None
    if not isinstance(v, dict):
        gaps.append("%s: %s is not an object" % (name, os.path.basename(path)))
        return None
    return v


def read_lines(path):
    """A local list file: None when absent, else its entries (no blanks, no # comments)."""
    try:
        with open(path, "rb") as f:
            raw = f.read().decode("utf-8")
    except FileNotFoundError:
        return None
    except (OSError, UnicodeDecodeError):
        return "unreadable"
    return [ln.strip() for ln in raw.splitlines() if ln.strip() and not ln.strip().startswith("#")]


def s(v):
    return v if isinstance(v, str) else ""


class Mask:
    """Decides which names the page may print. Withheld is the default."""

    def __init__(self, gaps):
        show = read_lines(os.path.join(STATE, "lane-ledger-show.txt"))
        hold = read_lines(os.path.join(STATE, "dash-withhold.txt"))
        self.refuse_all = False
        if show == "unreadable":
            gaps.append("show list: lane-ledger-show.txt unreadable; every team withheld")
            show = []
        elif show is None:
            gaps.append("show list: lane-ledger-show.txt not found; every team withheld")
            show = []
        if hold == "unreadable":
            gaps.append("withhold list: dash-withhold.txt unreadable; every name withheld")
            self.refuse_all = True
            hold = []
        self.show = set(show)
        self.hold = [re.compile(r"(?<![A-Za-z0-9])%s(?![A-Za-z0-9])" % re.escape(w), re.I) for w in (hold or [])]

    def held(self, text):
        return any(p.search(text) for p in self.hold)

    def team_shown(self, ws, team):
        if self.refuse_all:
            return False
        return (ws + "/" + team) in self.show and not self.held(ws) and not self.held(team)

    def word(self, text):
        """A role or seat name on a shown lane: printed unless a withhold word is in it."""
        return "withheld" if (self.refuse_all or self.held(text)) else text


def compute(marry_path):
    gaps = []
    mask = Mask(gaps)
    seats = read_jsonl(os.path.join(STATE, "freebusy", "seats.jsonl"), gaps, "seats")
    lanes_in = read_jsonl(os.path.join(STATE, "freebusy", "lanes.jsonl"), gaps, "lanes")
    desk = read_json(os.path.join(STATE, "desk-snapshot.json"), gaps, "desk")
    marry = read_json(marry_path, gaps, "marry")

    asks = {}
    asks_read = lanes_in is not None
    for r in lanes_in or []:
        asks[s(r.get("lane"))] = r

    # Would-pair rows from marvel marry, counted per seat address agent://<team>/<name>.
    ready = None
    unmatched = None
    if marry is not None:
        ready = {}
        for p in marry.get("pairs") or []:
            if isinstance(p, dict):
                ready[s(p.get("seat"))] = ready.get(s(p.get("seat")), 0) + 1
        c = marry.get("count") if isinstance(marry.get("count"), dict) else {}
        unmatched = {k: c.get(k, 0) if isinstance(c.get(k, 0), int) else 0
                     for k in ("ready", "eligible", "unmatched", "no_class", "no_component",
                               "no_eligible_seat", "operator_only", "client", "would_pair")}

    lanes = {}
    as_of = set()
    last_turn = 0
    for r in seats or []:
        cl, ws, team, role, name = (s(r.get(k)) for k in ("cluster", "workspace", "team", "role", "name"))
        st = s(r.get("state"))
        if st not in STATES:
            st = "unknown"
        if s(r.get("at")):
            as_of.add(s(r.get("at")))
        if r.get("last_turn") not in (None, ""):
            last_turn += 1
        shown = mask.team_shown(ws, team)
        key = (cl, ws, team, role) if shown else (cl, WITHHELD, WITHHELD, role)
        ln = lanes.setdefault(key, {"cluster": cl, "team": team if shown else WITHHELD, "workspace": ws if shown else "",
                                    "role": mask.word(role) if shown else role, "masked": not shown,
                                    "counts": dict.fromkeys(STATES, 0), "seats": [], "asks": [], "ready": 0})
        ln["counts"][st] += 1
        seat = {"state": st, "reason": s(r.get("reason")), "last_active": s(r.get("last_active")) or None}
        if shown:
            seat["name"] = mask.word(name)
        ln["seats"].append(seat)
        a = asks.get(team + "/" + role)
        if a is not None and (team + "/" + role) not in ln["asks"]:
            ln["asks"].append(team + "/" + role)
        if ready is not None:
            ln["ready"] += ready.get("agent://%s/%s" % (team, name), 0)

    out = []
    for key in sorted(lanes):
        ln = lanes[key]
        ln["seats"].sort(key=lambda x: (x.get("name", ""), x["state"], x["reason"], x["last_active"] or ""))
        if not asks_read:
            ln["asks_open"] = "GAP"
        else:
            vals = [asks[k].get("asks_open") for k in ln["asks"]]
            if not vals:
                ln["asks_open"] = 0
            elif any(not isinstance(v, int) for v in vals):
                ln["asks_open"] = "GAP"
            else:
                ln["asks_open"] = sum(vals)
        del ln["asks"]
        if ready is None:
            ln["ready"] = "GAP"
        out.append(ln)

    total = dict.fromkeys(STATES, 0)
    for ln in out:
        for k in STATES:
            total[k] += ln["counts"][k]
    op = None
    if desk is not None:
        bs = desk.get("by_status") if isinstance(desk.get("by_status"), dict) else {}
        op = {"open": len(desk.get("open")) if isinstance(desk.get("open"), list) else "GAP",
              "yours": bs.get("yours", 0) if isinstance(bs.get("yours", 0), int) else "GAP",
              "read_at": s(desk.get("read_at")) or "GAP"}
    clusters = sorted({ln["cluster"] for ln in out})
    return {"as_of": sorted(as_of), "clusters": clusters, "lanes": out, "total": total,
            "seats": sum(total.values()), "measured": total["free"] + total["busy"] + total["waiting"],
            "last_turn": last_turn, "seats_read": seats is not None, "asks_read": asks_read,
            "operator": op, "marry": unmatched, "masked_lanes": sum(1 for ln in out if ln["masked"]),
            "gaps": gaps}


CSS = """
:root{--bg:#fdfdfb;--ink:#1a1a1a;--ink2:#555;--ink3:#999;--accent:#a8551e}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#141414;--ink:#e6e6e6;--ink2:#aaa;--ink3:#666;--accent:#e0955f;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#141414;--ink:#e6e6e6;--ink2:#aaa;--ink3:#666;--accent:#e0955f;color-scheme:dark}
