"""

# The flow pages' bar, as the v2 build writes it for C1. Links reach sibling pages only.
NAV = ('<nav class="fn" aria-label="Flow pages"><ul><li><a href="index.html">All pages</a></li>'
       '<li><a href="c1.html" aria-current="page"><span class="c">C1</span><span class="t">Lane ledger</span></a></li>'
       '<li><a href="c2.html"><span class="c">C2</span><span class="t">Stuck now</span></a></li>'
       '<li><a href="c8.html"><span class="c">C8</span><span class="t">Stock line</span></a></li>'
       '<li><a href="c5.html"><span class="c">C5</span><span class="t">Fix tails</span></a></li>'
       '<li><a href="c7.html"><span class="c">C7</span><span class="t">Day ledger</span></a></li></ul>'
       '<div class="pn"><a href="index.html" rel="prev">Previous: Index</a><a href="c2.html" rel="next">Next: C2</a></div></nav>')

LEGEND = (("free", "free (ACTIVE% 0)"), ("busy", "busy (ACTIVE% above 0)"),
          ("waiting", "waiting (parked, or account limited)"), ("unknown", "unknown (not read)"))


def page(m):
    e = html.escape
    notes = []

    def fn(key):
        if FIX[key] not in notes:
            notes.append(FIX[key])
        return "<sup>(%d)</sup>" % (notes.index(FIX[key]) + 1)

    def cell(v, key):
        return "GAP" + fn(key) if v == "GAP" else str(v)

    asof = ("%s to %s" % (m["as_of"][0], m["as_of"][-1]) if len(m["as_of"]) > 1
            else (m["as_of"][0] if m["as_of"] else "GAP" + fn("seats")))
    P = ["<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">"
         "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
         "<title>Lane ledger</title><style>%s</style></head><body>" % CSS, NAV]
    P.append("<h1>Lane ledger: who is free now, and has work in their lane</h1>")
    P.append('<p class="prov">Read from director\'s freebusy files as of %s, clusters read: %s. '
             'Regenerated by lane-ledger on director\'s tick; every cell is derived, and anything not read prints GAP '
             'with what would fill it. Nothing here acts.</p>'
             % (e(asof), e(", ".join(m["clusters"])) if m["clusters"] else "none"))

    t = m["total"]
    P.append('<div class="cov"><div><span class="k">seats with a measured state</span>'
             '<span class="mb"><b style="width:%.1f%%"></b></span><span>%d of %d</span></div>'
             % (100.0 * m["measured"] / m["seats"] if m["seats"] else 0, m["measured"], m["seats"]))
    P.append('<div><span class="k">seats by state</span><span>%s</span></div>'
             % "; ".join("%s %d" % (k, t[k]) for k in STATES))
    P.append('<div><span class="k">seats with a last turn read</span><span>%d of %d%s</span></div></div>'
             % (m["last_turn"], m["seats"], fn("last_turn") if m["last_turn"] < m["seats"] else ""))

    P.append('<section aria-label="Seat board"><div class="lanes">')
    for ln in m["lanes"]:
        marks = "".join('<i class="sq %s" title="%s"></i>' % (x["state"], e(x["state"] + (", " + x["reason"] if x["reason"] else "")))
                        for x in ln["seats"])
        P.append('<div class="lr"><span class="lt">%s %s</span><span class="lw">%s</span><span class="sm">%s</span></div>'
                 % (e(ln["cluster"]), e(ln["team"]), e(ln["role"]), marks))
    P.append("</div>")
    P.append('<p class="leg">%s</p></section>' % "".join(
        '<span><i class="sq %s"></i>%s%s</span>' % (k, txt, "" if t[k] else " (none now)") for k, txt in LEGEND))

    P.append("<h2>By lane</h2>")
    P.append('<table class="l"><thead><tr><th>lane</th><th>free</th><th>busy</th><th>waiting</th><th>unknown</th>'
             '<th>asks open</th><th>unread</th><th>ready for the lane</th></tr></thead><tbody>')
    op = m["operator"]
    if op is None:
        P.append('<tr class="grp"><td>operator</td><td colspan="7">Desk GAP%s; client items GAP%s</td></tr>' % (fn("desk"), fn("client")))
    else:
        P.append('<tr class="grp"><td>operator</td><td colspan="7">Desk open %s, yours %s, as of %s; client items GAP%s</td></tr>'
                 % (cell(op["open"], "desk"), cell(op["yours"], "desk"), e(op["read_at"]), fn("client")))
    cur = None
    for ln in m["lanes"]:
        if ln["cluster"] != cur:
            cur = ln["cluster"]
            P.append('<tr class="grp"><td colspan="8">%s</td></tr>' % e(cur))
        c = ln["counts"]
        name = "%s %s" % (ln["team"], ln["role"])
        P.append('<tr><td>%s</td><td class="n" data-h="free">%d</td><td class="n" data-h="busy">%d</td>'
                 '<td class="n" data-h="waiting">%d</td><td class="n" data-h="unknown">%d</td>'
                 '<td class="n" data-h="asks open">%s</td><td data-h="unread">GAP%s</td><td class="n" data-h="ready">%s</td></tr>'
                 % (e(name), c["free"], c["busy"], c["waiting"], c["unknown"],
                    cell(ln["asks_open"], "asks"),
                    fn("unread"), cell(ln["ready"], "ready")))
    if not m["lanes"]:
        P.append('<tr><td colspan="8">no seats read: GAP%s</td></tr>' % fn("seats"))
    P.append('<tr class="grp"><td>host unknown</td><td colspan="7">bd event writers not placed GAP%s</td></tr>' % fn("host"))
    P.append("</tbody></table>")

    mr = m["marry"]
    if mr is None:
        P.append('<p class="under">Ready work: GAP%s.</p>' % fn("ready"))
    else:
        P.append('<p class="under">Ready work, from marvel marry (shadow, nothing sent): ready %d, eligible %d, would-pair %d; '
                 'unmatched %d (no class %d, no component %d, no eligible seat %d, operator-only %d); client %d, counted only.</p>'
                 % (mr["ready"], mr["eligible"], mr["would_pair"], mr["unmatched"], mr["no_class"], mr["no_component"],
                    mr["no_eligible_seat"], mr["operator_only"], mr["client"]))
    if m["masked_lanes"]:
        P.append('<p class="under">%d lanes print as "%s", with role, cluster and counts only%s.</p>'
                 % (m["masked_lanes"], WITHHELD, fn("show")))
    P.append('<p class="under">Free here means the seat\'s pane reads idle%s; it is not a claim that the seat has work '
             'waiting. A lane has work for a free seat only where "ready for the lane" is above 0.</p>' % fn("runtime"))
    if m["gaps"]:
        P.append('<p class="under">Not read: %s.</p>' % e("; ".join(m["gaps"])))
    P.append("<footer><ol>%s</ol>" % "".join("<li>fix: %s</li>" % e(n) for n in notes))
    P.append("<p>Sources: freebusy/seats.jsonl and freebusy/lanes.jsonl (one row per seat and per lane, replaced each "
             "sweep), desk-snapshot.json, and a marvel marry output when one is given. Presence and health set no state "
             "here; freebusy's own reason shows on hover. Nothing here ranks seats or acts.</p></footer>")
    data = json.dumps(m, sort_keys=True, separators=(",", ":"), ensure_ascii=True).replace("</", "<\\/")
    P.append('<script type="application/json" id="data">%s</script>' % data)
    P.append("</body></html>\n")
    return "".join(P)


def outside_checkout(path):
    p = os.path.realpath(os.path.dirname(os.path.abspath(path)) or ".")
    while not os.path.isdir(p) and p != "/":
        p = os.path.dirname(p)
    while True:
        if os.path.exists(os.path.join(p, ".git")):
            return False
        if p == "/":
            return True
        p = os.path.dirname(p)


def main():
    out, marry = args(sys.argv[1:])
    if not outside_checkout(out):
        print("lane-ledger: not written: %s is inside a checkout; the page stays outside any repository" % out)
        return 0
    m = compute(marry)
    body = page(m).encode("ascii", "xmlcharrefreplace")
    d = os.path.dirname(os.path.abspath(out))
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".c1.")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(body)
        os.chmod(tmp, 0o600)
        os.replace(tmp, out)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    for g in m["gaps"]:
        print("- GAP %s" % g)
    t = m["total"]
    print("lane-ledger: %d seats in %d lanes (%s); written %s"
          % (m["seats"], len(m["lanes"]), ", ".join("%s %d" % (k, t[k]) for k in STATES), out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
