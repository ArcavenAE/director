#!/usr/bin/env python3
"""desk-snapshot - write the local snapshot of the Desk's open cards.

K13 (sim/design/director-functions-redesign.md, section 6; ticket
aae-orc-eeb2v), under the operator's ruling on the snapshot writer. A script
cannot read the Desk (finding-director-glst), so a session reads it and hands
this helper the cards it got. The helper validates that input and writes one
file, which `dws` reads to decide whether `--blocked operator` names an open
card:

  $DIRECTOR_STATE/desk-snapshot.json
      {"read_at": T, "cards": N, "open": [ids, sorted], "by_status": {...}, "areas": [distinct card areas],
       "ids": {id: status, ...}, ["answered": [ids, sorted],] ["answered_at": {id: time},]
       ["intake": {id: ask id},] "source_sha256": H}

  desk-snapshot write --cards FILE --reported N [--limit 1000]
                      [--answers FILE --answers-reported N]
  desk-snapshot show

FILE is what the session's Desk read wrote: a JSON object of card id to card, or
a list of cards that each carry "id" or "doc_id". A card's status is its
"status", or its "data"."status". --reported is the count the Desk read itself
reported; the file must hold exactly that many cards, and a count at --limit (the
read limit) may be truncated, so it is refused. A card counts as open only when
its status is exactly "open"; relayed, closed, split, yours, withdrawn, resolved
and superseded are not open. The helper refuses on any doubt and writes nothing.
"ids" holds every card with its status (no card text), so a card that is relayed or
closed is told from one that never existed; card-ingest reads it to refuse a slug already
on the Desk. --answers is optional: a JSON list (or object of lists) of answer records,
each naming its card in "card" or "card_id" (both, only if they agree), with the same count and limit checks as the
cards; "answered" is then the sorted distinct cards that have an answer, and an empty list
means the answers were read and none were found. Without --answers there is no "answered"
key, which card-ingest reads as unknown. `dws` reads only "open", so it is unaffected.

"answered_at" keeps each answered card's answer time: the latest of the record's "answered_at",
"created_at" or "at" that is an RFC 3339 UTC stamp, with or without a fraction of a second (the Desk's
toISOString() carries milliseconds); the fraction is dropped, so the time reads to the second (a record with none adds no time, and the read row
below shows it as null). "intake" is a sibling of "ids": the card's intake id (I-<n>, from `dws intake`)
for every card that carries one in "intake", top level or under "data". Both keys are written only when
they have something to hold.

A write that read answers also appends one row to $DIRECTOR_STATE/desk-reads.jsonl, after the snapshot
is in place, under one flock on desk-reads.lock (a refused write appends none):
      {"read_at": T, "cards": N, "answered": [ids], "answered_not_relayed": [{"card": id, "answered_at": T|null}]}
A card is answered-not-relayed when it has an answer and its status is not one of CLOSING_STATUSES (the
relay moves a card to "relayed"). The standing hook reads the newest row.
Whoever runs it is a claim, as with dws --actor: the helper checks the input's
shape and completeness, not that a session really read the Desk.
"""
import argparse, datetime, fcntl, hashlib, json, os, re, sys, tempfile

HOME = os.path.expanduser("~")
STATE = os.environ.get("DIRECTOR_STATE") or f"{HOME}/.director/state"
SNAPSHOT = os.path.join(STATE, "desk-snapshot.json")
READS = os.path.join(STATE, "desk-reads.jsonl")
READS_LOCK = os.path.join(STATE, "desk-reads.lock")
ASK_ID = re.compile(r"^I-[0-9]+$")
STAMP = re.compile(r"^(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(\.\d+)?Z$")  # the Desk writes toISOString(), which carries milliseconds
# The statuses in which a card is no longer waiting for the relay (CLOSING_STATUSES in dws).
CLOSING_STATUSES = ("closed", "resolved", "withdrawn", "superseded", "relayed")


class Refused(Exception):
    pass


def now():
    """The clock. DWS_NOW overrides it only with DWS_TEST_CLOCK=1, as in dws."""
    fixed = os.environ.get("DWS_NOW") if os.environ.get("DWS_TEST_CLOCK") == "1" else None
    return fixed or datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def status_of(card):
    s = card.get("status")
    if s is None and isinstance(card.get("data"), dict):
        s = card["data"].get("status")
    return s


def areas_of(raw):
    """Sorted distinct printable `area` strings on the cards (top level or under data); anything else adds none."""
    cards = raw.values() if isinstance(raw, dict) else raw
    found = set()
    for c in cards:
        if not isinstance(c, dict):
            continue
        a = c.get("area")
        if a is None and isinstance(c.get("data"), dict):
            a = c["data"].get("area")
        if isinstance(a, str) and a.strip() and a.isprintable():
            found.add(a.strip())
    return sorted(found)


def intakes_of(raw):
    """{card id: intake id} for the cards that carry an I-<n> id in 'intake' (top level or under data)."""
    items = raw.items() if isinstance(raw, dict) else [(c.get("id", c.get("doc_id")), c) for c in raw if isinstance(c, dict)]
    out = {}
    for cid, c in items:
        if not isinstance(c, dict):
            continue
        v = c.get("intake")
        if v is None and isinstance(c.get("data"), dict):
            v = c["data"].get("intake")
        if isinstance(v, str) and ASK_ID.match(v):
            out[cid] = v
    return dict(sorted(out.items()))


def parse_cards(raw):
    """Returns {id: status}. Raises Refused on any shape it cannot trust."""
    items = []
    if isinstance(raw, dict):
        items = list(raw.items())
    elif isinstance(raw, list):
        for c in raw:
            if not isinstance(c, dict):
                raise Refused("a card in the list is not an object")
            cid = c.get("id", c.get("doc_id"))
            items.append((cid, c))
    else:
        raise Refused("the cards file is neither an object of cards nor a list of cards")
    out = {}
    for cid, card in items:
        if not isinstance(cid, str) or not cid.strip():
            raise Refused(f"a card has no usable id: {cid!r}")
        if not isinstance(card, dict):
            raise Refused(f"card {cid} is not an object")
        if cid in out:
            raise Refused(f"duplicate card id {cid}")
        st = status_of(card)
        if not isinstance(st, str) or not st:
            raise Refused(f"card {cid} has no status string")
        out[cid] = st
    return out


def parse_answers(raw, cards):
    """Returns (count, sorted distinct card ids, {card: latest answer time}). Raises Refused on a shape it cannot trust."""
    if not isinstance(raw, list):
        raise Refused("the answers file is not a list of answer records")
    answered = set()
    times = {}
    for r in raw:
        if not isinstance(r, dict):
            raise Refused("an answer in the list is not an object")
        if "card" in r and "card_id" in r and r["card"] != r["card_id"]:
            raise Refused(f"an answer names card {r['card']!r} in 'card' and {r['card_id']!r} in 'card_id'; give one card, or two that agree")
        cid = r.get("card", r.get("card_id"))
        if not isinstance(cid, str) or not cid.strip():
            raise Refused("an answer names no card (a 'card' or 'card_id' string)")
        if cid not in cards:
            raise Refused(f"an answer names card {cid}, which the cards read does not hold")
        answered.add(cid)
        for key in ("answered_at", "created_at", "at"):
            t = r.get(key)
            m = STAMP.match(t) if isinstance(t, str) else None
            if m:
                t = m.group(1) + "Z"  # an optional fraction is dropped, so the time reads to the second
                if cid not in times or t > times[cid]:
                    times[cid] = t
                break
    return len(raw), sorted(answered), dict(sorted(times.items()))


def cmd_write(a):
    try:
        with open(a.cards, "rb") as f:
            data = f.read()
    except OSError as err:
        raise Refused(f"cannot read the cards file {a.cards}: {err.strerror}")
    try:
        raw = json.loads(data)
    except ValueError as err:
        raise Refused(f"the cards file is not JSON: {err}")
    cards = parse_cards(raw)
    if not cards:
        raise Refused("the cards file holds no cards; an empty Desk read is not a snapshot")
    if len(cards) != a.reported:
        raise Refused(f"the Desk read reported {a.reported} cards and the file holds {len(cards)}; the read is incomplete or the wrong file")
    if a.reported >= a.limit:
        raise Refused(f"{a.reported} cards is at the read limit {a.limit}; the read may be truncated. Read again with a higher limit")
    answered = None
    answer_times = {}
    if a.answers is not None:
        if a.answers_reported is None:
            raise Refused("--answers needs --answers-reported, the count the answers read itself reported")
        try:
            with open(a.answers, "rb") as f:
                araw = json.loads(f.read())
        except OSError as err:
            raise Refused(f"cannot read the answers file {a.answers}: {err.strerror}")
        except ValueError as err:
            raise Refused(f"the answers file is not JSON: {err}")
        n, answered, answer_times = parse_answers(araw, cards)
        if n != a.answers_reported:
            raise Refused(f"the answers read reported {a.answers_reported} answers and the file holds {n}; the read is incomplete or the wrong file")
        if a.answers_reported >= a.limit:
            raise Refused(f"{a.answers_reported} answers is at the read limit {a.limit}; the read may be truncated. Read again with a higher limit")
    elif a.answers_reported is not None:
        raise Refused("--answers-reported needs --answers")
    by_status = {}
    for st in cards.values():
        by_status[st] = by_status.get(st, 0) + 1
    snap = {"read_at": now(), "cards": len(cards),
            "open": sorted(c for c, st in cards.items() if st == "open"),
            "by_status": by_status, "ids": dict(sorted(cards.items())),
            "areas": areas_of(raw),
            "source_sha256": hashlib.sha256(data).hexdigest()}
    if answered is not None:
        snap["answered"] = answered
    if answer_times:
        snap["answered_at"] = answer_times
    intakes = intakes_of(raw)
    if intakes:
        snap["intake"] = intakes
    os.makedirs(STATE, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=STATE, prefix=".desk-snapshot.")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(snap, f, indent=1)
            f.write("\n")
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, SNAPSHOT)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise
    if answered is not None:
        waiting = [{"card": c, "answered_at": answer_times.get(c)} for c in answered if cards[c] not in CLOSING_STATUSES]
        row = {"read_at": snap["read_at"], "cards": snap["cards"], "answered": answered, "answered_not_relayed": waiting}
        os.makedirs(STATE, exist_ok=True)
        fd = os.open(READS_LOCK, os.O_CREAT | os.O_RDWR, 0o600)
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)
            with open(READS, "ab") as f:
                if f.tell() > 0:
                    with open(READS, "rb") as r:
                        r.seek(-1, os.SEEK_END)
                        lead = b"" if r.read(1) == b"\n" else b"\n"
                else:
                    lead = b""
                f.write(lead + (json.dumps(row, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8"))
                f.flush()
                os.fsync(f.fileno())
        finally:
            os.close(fd)
    print(f"desk-snapshot: {snap['cards']} cards, {len(snap['open'])} open, read_at {snap['read_at']} -> {SNAPSHOT}")


def cmd_show(a):
    try:
        with open(SNAPSHOT) as f:
            s = json.load(f)
    except (OSError, ValueError):
        print("desk-snapshot: UNREAD (no readable snapshot)")
        return
    print(f"desk-snapshot: read_at {s.get('read_at')}, {s.get('cards')} cards, {len(s.get('open', []))} open")


def main(argv):
    p = argparse.ArgumentParser(prog="desk-snapshot")
    sub = p.add_subparsers(dest="cmd", required=True)
    w = sub.add_parser("write")
    w.add_argument("--cards", required=True)
    w.add_argument("--reported", type=int, required=True)
    w.add_argument("--limit", type=int, default=1000)
    w.add_argument("--answers")
    w.add_argument("--answers-reported", type=int)
    w.set_defaults(fn=cmd_write)
    s = sub.add_parser("show")
    s.set_defaults(fn=cmd_show)
    a = p.parse_args(argv)
    try:
        a.fn(a)
    except Refused as err:
        print(f"desk-snapshot: refused: {err}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
