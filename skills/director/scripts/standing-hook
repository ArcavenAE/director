#!/usr/bin/env python3
"""standing-hook - put drain age and the standing checklist in front of every answer.

Director's standing duties (drain the inbox, read answered cards) have no cue of
their own: they run only inside turns the operator starts, so a fast run of
questions crowds them out. This hook is the cue. Wired as a Claude Code
UserPromptSubmit hook, it prints, before each answer:

  drain age: <N>m since the last drain (<stamp>)
  Before you answer:
  1. ...three lines...

Subcommands:

  standing-hook           print the drain age and the checklist (the hook)
  standing-hook beat      record a drain: write the heartbeat from the clock
  standing-hook scan-beat record a stalled-ideas scan (the sweep runs `dbi --json`, then this)

The session runs `standing-hook beat` after each inbox drain. The heartbeat is
one line, an RFC 3339 UTC stamp, in $DIRECTOR_STATE/last-drain (default
$HOME/.director/state/last-drain). It is written to a temp file and renamed
into place, and the stamp is the clock's: there is no argument to set it. With
no heartbeat the hook says so rather than inventing an age. The first line is
the drain age and nothing else: inbox depth is not shown, because a number
nobody has checked teaches the reader to trust it.

The line before it says when the operations dashboard was last applied: `dash last applied: T`, the
`last_run` that `dash-writer ack` recorded in $DIRECTOR_STATE/dash-writer.json, so a sweep that never reached
step 5 shows in the next answer. It prompts; it gates nothing.

The last line is the age of the last stalled-ideas scan, read from
$DIRECTOR_STATE/last-stalled-scan the same way. The hook never runs the scan itself: dbi asks
each repo's remote, which takes seconds, and a prompt hook must not. It only shows how old the
last one is, so a sweep that skipped the block shows that in the next answer.

The line after it counts operator asks that never got a relay entry or a ledger row, only when there are some:

  asks in the last 24 h with no relay or row: <n> (oldest <id>)

It is the join `dws asks --json` already computes (asks.jsonl, the relay log, the ledger), read through that
command as a read-only subprocess with a short timeout (STANDING_HOOK_ASKS_TIMEOUT seconds, default 3, also used for any value that is not finite and above 0; no
network). An ask counts when its received_at is within 24 hours and its relay and row both read none; the
oldest is the earliest received. At 0 it prints nothing. When the join cannot be read, or the relay log it
needs could not be, it prints `asks in the last 24 h with no relay or row: UNKNOWN (<reason>)`, so a missing
log never reads as every ask unlinked. It is a diagnostic: it prompts and gates nothing.

One more line follows, last, only when something waits:

  waiting: <n> Desk answers not relayed (oldest <age>, ids <ids>); <m> approved PRs not merged (oldest <age>); Desk read <age> ago

Each clause appears only when its count is nonzero, and the Desk-read age is always there when the line
prints. When nothing waits it prints nothing, no empty line and no "0". When an input is missing,
unreadable, in the future or older than DIRECTOR_WAITING_MAX_HOURS (default 24), it prints
`waiting: UNKNOWN (<reason>)` naming the age of what it read, so a dead signal reads as dead. The
answers come from the newest row of $DIRECTOR_STATE/desk-reads.jsonl (desk-snapshot write --answers); the
PRs come from $DIRECTOR_STATE/waiting-prs.json, which `dws waiting write` writes in the sweep and which
is the only step that may call gh. A missing file is UNKNOWN, including when neither exists.

The hook never types into a pane and never reads the hub or the network; it reads files: the heartbeat,
the dash and scan stamps, and the two inputs above. The waiting line widens the contract the earlier
"reads one file" stated, on purpose.
"""
import datetime, json, math, os, subprocess, sys, tempfile

CHECKLIST = """Before you answer:
1. Drained, and answered Desk cards and page picks read, since my last answer? If not, do them first.
2. Does this answer or relay touch a standing ruling, or claim authority? Quote the ruling.
3. Where does this text land, and does that file or seat own it?"""

FMT = "%Y-%m-%dT%H:%M:%SZ"


def state_file():
    d = os.environ.get("DIRECTOR_STATE") or os.path.join(os.path.expanduser("~"), ".director", "state")
    return os.path.join(d, "last-drain")


def now():
    return datetime.datetime.now(datetime.timezone.utc)


def stamp(path):
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".stamp.")
    with os.fdopen(fd, "w") as f:
        f.write(now().strftime(FMT) + "\n")
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def beat():
    stamp(state_file())


def scan_beat():
    stamp(scan_file())


def scan_file():
    return os.path.join(os.path.dirname(state_file()), "last-stalled-scan")


def scan_line():
    try:
        with open(scan_file()) as f:
            raw = f.read().strip()
        t = datetime.datetime.strptime(raw, FMT).replace(tzinfo=datetime.timezone.utc)
    except (OSError, ValueError):
        return "stalled ideas: unknown, no scan recorded (the sweep runs `dbi --json`, then `standing-hook scan-beat`)"
    hours = int((now() - t).total_seconds() // 3600)
    if hours < 0:
        return f"stalled ideas: unknown, the last scan stamp ({raw}) is in the future"
    return f"stalled ideas: last scan {hours}h ago ({raw})"


def dash_line():
    try:
        with open(os.path.join(os.path.dirname(state_file()), "dash-writer.json")) as f:
            raw = json.load(f)["last_run"]
        datetime.datetime.strptime(raw, FMT)
    except (OSError, ValueError, KeyError, TypeError):
        return "dash last applied: unknown, no batch recorded (sweep step 5 runs `dash-writer`, then `dash-writer ack`)"
    return f"dash last applied: {raw}"


def age_line():
    try:
        with open(state_file()) as f:
            raw = f.read().strip()
        t = datetime.datetime.strptime(raw, FMT).replace(tzinfo=datetime.timezone.utc)
    except (OSError, ValueError):
        return "drain age: unknown, no drain recorded (run `standing-hook beat` after a drain)"
    mins = int((now() - t).total_seconds() // 60)
    if mins < 0:
        return f"drain age: unknown, the last drain stamp ({raw}) is in the future"
    return f"drain age: {mins}m since the last drain ({raw})"


WAIT_FMT = FMT


def state_dir():
    return os.path.dirname(state_file())


def max_hours():
    try:
        return float(os.environ.get("DIRECTOR_WAITING_MAX_HOURS", "24"))
    except ValueError:
        return 24.0


def age_text(seconds):
    m = int(seconds // 60)
    if m < 60:
        return f"{m}m"
    h = m // 60
    return f"{h}h" if h < 48 else f"{h // 24}d"


def parse_stamp(raw):
    return datetime.datetime.strptime(raw, WAIT_FMT).replace(tzinfo=datetime.timezone.utc)


def read_input(name, stamp_key, loader):
    """(data, age seconds, None) or (None, None, reason). A reason names the file and what is wrong with it."""
    path = os.path.join(state_dir(), name)
    if not os.path.exists(path):
        return None, None, "missing"
    try:
        data = loader(path)
        t = parse_stamp(data[stamp_key])
    except (OSError, ValueError, KeyError, TypeError, IndexError):
        return None, None, f"{name} unreadable"
    age = (now() - t).total_seconds()
    if age < 0:
        return None, None, f"{name} is stamped in the future ({data[stamp_key]})"
    if age > max_hours() * 3600:
        return None, None, f"{name} is {age_text(age)} old, over the {max_hours():g}h limit"
    return data, age, None


def last_row(path):
    with open(path, encoding="utf-8") as f:
        rows = [ln for ln in f.read().splitlines() if ln.strip()]
    row = json.loads(rows[-1])
    if not isinstance(row, dict) or not isinstance(row.get("answered_not_relayed"), list):
        raise ValueError("not a desk read row")
    return row


def whole(path):
    with open(path, encoding="utf-8") as f:
        d = json.load(f)
    if not isinstance(d, dict) or not isinstance(d.get("approved_not_merged"), list):
        raise ValueError("not a waiting cache")
    return d


def waiting_line():
    reads, read_age, why_reads = read_input("desk-reads.jsonl", "read_at", last_row)
    prs, _, why_prs = read_input("waiting-prs.json", "written_at", whole)
    why = []
    if why_reads:
        why.append("desk-reads.jsonl missing, desk-snapshot write --answers has not run" if why_reads == "missing" else why_reads)
    if why_prs:
        why.append("waiting-prs.json missing, `dws waiting write` has not run" if why_prs == "missing" else why_prs)
    if why:
        return f"waiting: UNKNOWN ({'; '.join(why)})"
    t_now = now()
    clauses = []
    answers = [r for r in reads["answered_not_relayed"] if isinstance(r, dict) and isinstance(r.get("card"), str)]
    if answers:
        ages = []
        for r in answers:
            try:
                ages.append((t_now - parse_stamp(r["answered_at"])).total_seconds())
            except (KeyError, TypeError, ValueError):
                pass
        oldest = age_text(max(ages)) if ages else "unknown"
        clauses.append(f"{len(answers)} Desk answers not relayed (oldest {oldest}, ids {', '.join(r['card'] for r in answers)})")
    waiting_prs = [r for r in prs["approved_not_merged"] if isinstance(r, dict)]
    if waiting_prs:
        ages = []
        for r in waiting_prs:
            try:
                ages.append((t_now - parse_stamp(r["approved_at"])).total_seconds())
            except (KeyError, TypeError, ValueError):
                pass
        clauses.append(f"{len(waiting_prs)} approved PRs not merged (oldest {age_text(max(ages)) if ages else 'unknown'})")
    if not clauses:
        return None
    clauses.append(f"Desk read {age_text(read_age)} ago")
    return "waiting: " + "; ".join(clauses)


ASKS_WINDOW_HOURS = 24
ASKS_PREFIX = "asks in the last 24 h with no relay or row: "


def asks_timeout():
    """Seconds to wait for the join. A value that is not finite and above 0 (inf, nan, 0, a negative, text) is
    the 3 s default, so the call stays bounded and the hook never raises past the asks line."""
    try:
        v = float(os.environ.get("STANDING_HOOK_ASKS_TIMEOUT", "3"))
    except ValueError:
        return 3.0
    return v if math.isfinite(v) and v > 0 else 3.0


def asks_line():
    """The unlinked-asks line, or None when nothing is unlinked. The join is dws's own, read through it."""
    dws = os.environ.get("STANDING_HOOK_DWS") or os.path.join(os.path.dirname(os.path.realpath(__file__)), "dws")
    try:
        p = subprocess.run([dws, "asks", "--json"], capture_output=True, text=True, timeout=asks_timeout(), stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        return f"{ASKS_PREFIX}UNKNOWN (dws asks did not answer in {asks_timeout():g}s)"
    except OSError as err:
        return f"{ASKS_PREFIX}UNKNOWN (dws asks could not run: {err.strerror or err})"
    if p.returncode != 0:
        return f"{ASKS_PREFIX}UNKNOWN (dws asks exited {p.returncode})"
    try:
        rows = json.loads(p.stdout)
        if not isinstance(rows, list):
            raise ValueError("not a list")
    except ValueError:
        return f"{ASKS_PREFIX}UNKNOWN (dws asks did not print JSON)"
    t_now = now()
    unlinked = []
    for r in rows:
        try:
            at = parse_stamp(r["received_at"])
            ask_id, relay, row = r["ask_id"], r["relay"], r["row"]
        except (KeyError, TypeError, ValueError):
            continue
        age = (t_now - at).total_seconds()
        if 0 <= age <= ASKS_WINDOW_HOURS * 3600 and relay == "none" and row == "none":
            unlinked.append((at, ask_id))
    if not unlinked:
        return None
    # dws prints a warning on stderr when the relay log was not read; then every ask would read unlinked.
    warn = p.stderr.strip().splitlines()
    if warn:
        return f"{ASKS_PREFIX}UNKNOWN ({warn[0][:120]})"
    return f"{ASKS_PREFIX}{len(unlinked)} (oldest {min(unlinked)[1]})"


def main():
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and sys.argv[1] not in ("beat", "scan-beat")):
        sys.exit("usage: standing-hook [beat|scan-beat]")
    if len(sys.argv) == 2:
        (beat if sys.argv[1] == "beat" else scan_beat)()
        return
    print(age_line())
    print(CHECKLIST)
    print(dash_line())
    print(scan_line())
    line = asks_line()
    if line:
        print(line)
    line = waiting_line()
    if line:
        print(line)


if __name__ == "__main__":
    main()
