#!/usr/bin/env python3
"""director-init: write director's operating profile and report what shadows the launcher.

  director-init [--profile FILE] [--entry-role ROLE] [--team GLOB=ROLE]... [--yes]
  director-init --check [--profile FILE]
  director-init --schedule [--scheduler launchd|cron] [--profile FILE] [--yes]

First build (aae-orc-d2sol, sim/design/director-bootstrap.md section 4a.2, and
director's rulings of 2026-11-12 recorded on that ticket). It does five things:

  1. detects marvel (`marvel config list`) and sideshow (`sideshow list`) and
     prints what it finds;
  2. takes the entry role, which it cannot detect, from flags only:
     --entry-role ROLE (one [[team]], match "*") and repeatable --team GLOB=ROLE.
     There is no prompt; with neither flag it writes the minimal profile and says
     that routing into a team is refused until an entry role is named;
  3. writes the profile atomically, after director-profile check passes on it. An
     existing profile is replaced only on --yes and a backup copy is kept first;
  4. prints the profile summary and the shadow scan: a function, an alias or an
     earlier PATH entry named director-session, as "file:line: kind". A function or
     alias that calls $DIRECTOR_HOME/bin/director-session is a wrapper, reported as
     "wraps", and is not drift. The scan edits nothing;
  5. --check re-reads all of it and prints one "drift:" line per fault, writing
     nothing. Exit 1 on drift, 0 when clean.

--schedule (slice 16 of sim/design/director-standing-loop.md, operator card i652r-2, choice 1) is
opt-in per install. It needs an existing profile. It prints the entry that would run `director-tick`
(the one beside this script) every [loop] tick_interval minutes (30 by default) on the host's
scheduler: launchd on Darwin (a user agent, StartInterval), cron elsewhere (one line marked
`# director-tick`), or the one --scheduler names. Without --yes that is all it does: it writes
nothing and calls no scheduler tool. With --yes it installs the entry (launchctl load -w, or
crontab with the old lines kept), then records [loop] scheduler in the profile atomically, with
the backup. A second --yes changes nothing; a different file at the plist path is refused. A
systemd timer is not built, and neither is an uninstall: the owner removes the plist or the cron line.

Plain director-init never installs a schedule: the launcher is install.sh's. Not in the first build, and
refused as such: --manifests.

Exit: 0 ok, 1 refused or drift, 2 usage or an interpreter that is too old.

This file is parsed by every python3 a host may have, so it uses no syntax newer
than 3.9 before the version check, and the whole file keeps to that.
"""
import os
import shutil
import sys

MIN = (3, 11)

if tuple(sys.version_info[:2]) < MIN:
    # A newer python3.N on PATH is used instead; with none, one clear line.
    for minor in range(15, MIN[1] - 1, -1):
        found = shutil.which("python3.%d" % minor)
        if found:
            try:
                os.execv(found, [found] + sys.argv)
            except OSError:
                continue  # not runnable: try the next, then the one-line refusal below
    sys.stderr.write(
        "director-init: needs python3 %d.%d or newer (this is python3 %s)\n"
        % (MIN[0], MIN[1], ".".join(str(p) for p in sys.version_info[:3]))
    )
    sys.exit(2)

import json  # noqa: E402
import re  # noqa: E402
import subprocess  # noqa: E402
import tempfile  # noqa: E402
import time  # noqa: E402
import tomllib  # noqa: E402

PROG = "director-init"
TOOL_TIMEOUT = 30  # seconds, for every tool this script runs
RC_FILES = (".zshrc", ".zprofile", ".zshenv", ".bashrc", ".bash_profile", ".profile")
FN_FORMS = (
    re.compile(r"^\s*function\s+director-session\b"),
    re.compile(r"^\s*director-session\s*\(\s*\)"),
)
ALIAS_FORM = re.compile(r"^\s*alias\s+director-session=")


def err(msg):
    sys.stderr.write("%s: %s\n" % (PROG, msg))


def home():
    return os.environ.get("HOME", "")


def dhome():
    return os.environ.get("DIRECTOR_HOME") or os.path.join(home(), ".director")


def state_dir():
    return os.environ.get("DIRECTOR_STATE") or os.path.join(home(), ".director", "state")


def profile_path(arg):
    return arg or os.environ.get("DIRECTOR_PROFILE") or os.path.join(state_dir(), "operating-profile.toml")


def run_tool(argv):
    """Run a tool; return its stdout lines, or None when it is missing or fails."""
    if not shutil.which(argv[0]):
        return None
    try:
        res = subprocess.run(argv, capture_output=True, text=True, timeout=TOOL_TIMEOUT)
    except (OSError, subprocess.SubprocessError):
        return None
    if res.returncode != 0:
        return None
    return [ln for ln in res.stdout.splitlines() if ln.strip()]


def detect():
    return {
        "marvel": run_tool(["marvel", "config", "list"]),
        "sideshow": run_tool(["sideshow", "list"]),
    }


def print_detection(found):
    print("marvel: %s" % ("found" if found["marvel"] is not None else "not found"))
    if found["sideshow"] is None:
        print("sideshow: not found")
    else:
        print("sideshow: found")
        for ln in found["sideshow"]:
            print("  %s" % ln)


def profile_tool():
    beside = os.path.join(os.path.dirname(os.path.realpath(__file__)), "director-profile")
    if os.path.isfile(beside):
        return beside
    return os.path.join(dhome(), "bin", "director-profile")


def check_profile(path):
    """Run director-profile check on path; return (ok, its output)."""
    try:
        res = subprocess.run([sys.executable, profile_tool(), "check", path], capture_output=True, text=True, timeout=TOOL_TIMEOUT)
    except subprocess.TimeoutExpired:
        return False, "director-profile check timed out after %d s\n" % TOOL_TIMEOUT
    return res.returncode == 0, (res.stdout + res.stderr)


# ---- the shadow scan: reads, never edits ----

def expand_text(text):
    h, dh = home(), dhome()
    text = text.replace("${DIRECTOR_HOME}", dh).replace("$DIRECTOR_HOME", dh)
    text = text.replace("${HOME}", h).replace("$HOME", h)
    return re.sub(r"(?<![\w$])~/", h + "/", text)


def wraps_launcher(text, launcher):
    """True when text names the launcher's exact path: not part of a longer path or name."""
    return re.search(r"(?<![\w./-])%s(?![\w./-])" % re.escape(launcher), text) is not None


def body_from(lines, start):
    """The function or alias text from lines[start]: to the brace that closes it, at most 40 lines.

    It counts braces line by line, so a function whose opening brace is on the
    next line (`director-session()` then `{`) ends at its first line and the
    body is not read: a wrapper written that way is reported as drift, not as
    wraps. Reading it properly is not in the first build.
    """
    depth, taken = 0, []
    for ln in lines[start:start + 40]:
        taken.append(ln)
        depth += ln.count("{") - ln.count("}")
        if depth <= 0:
            break
    return "\n".join(taken)


def shadow_scan():
    """Return [(where, kind)] with kind function, alias, wraps or path, in scan order."""
    launcher = os.path.join(dhome(), "bin", "director-session")
    found = []
    for name in RC_FILES:
        path = os.path.join(home(), name)
        if not os.path.isfile(path):
            continue
        try:
            with open(path, "r", errors="replace") as fh:
                lines = fh.read().splitlines()
        except OSError:
            continue
        for i, ln in enumerate(lines):
            kind = None
            if any(rx.match(ln) for rx in FN_FORMS):
                kind, text = "function", body_from(lines, i)
            elif ALIAS_FORM.match(ln):
                kind, text = "alias", ln
            if kind:
                if wraps_launcher(expand_text(text), launcher):
                    kind = "wraps"
                found.append(("%s:%d" % (path, i + 1), kind))
    for entry in os.environ.get("PATH", "").split(os.pathsep):
        cand = os.path.join(entry or ".", "director-session")
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            if os.path.realpath(cand) != os.path.realpath(launcher):
                found.append((cand, "path"))
            break
    return found


# ---- writing ----

def parse_teams(args):
    teams = []
    for flag, value in args:
        if flag == "--entry-role":
            if not value:
                return None, "--entry-role takes a role name, not an empty string"
            teams.append(("*", value))
        else:
            glob, sep, role = value.partition("=")
            if not sep or not glob or not role:
                return None, "--team takes GLOB=ROLE, got %r" % value
            teams.append((glob, role))
    return teams, None


def render(fleet, teams):
    out = ["# operating profile, written by director-init", "schema_version = 1",
           "fleet_sources = [%s]" % ", ".join(json.dumps(f) for f in fleet)]
    for glob, role in teams:
        out += ["", "[[team]]", "match = %s" % json.dumps(glob), "entry_role = %s" % json.dumps(role)]
    return "\n".join(out) + "\n"


def backup(path):
    ns = time.time_ns()
    dst = "%s.bak-%s.%09dZ" % (path, time.strftime("%Y%m%dT%H%M%S", time.gmtime(ns // 10**9)), ns % 10**9)
    with open(path, "rb") as src, open(dst, "xb") as out:
        shutil.copyfileobj(src, out)
    return dst


def do_init(opts):
    teams, bad = parse_teams(opts["teams"])
    if bad:
        err(bad)
        return 2
    target = profile_path(opts["profile"])
    found = detect()
    print_detection(found)
    if os.path.exists(target) and not opts["yes"]:
        err("%s already exists; pass --yes to replace it (a backup is kept)" % target)
        return 1
    fleet = ["marvel-register", "bus-presence"] if found["marvel"] is not None else ["bus-presence"]
    text = render(fleet, teams)
    os.makedirs(os.path.dirname(os.path.abspath(target)), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".operating-profile.", suffix=".tmp", dir=os.path.dirname(os.path.abspath(target)))
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        ok, shown = check_profile(tmp)
        if not ok:
            err("the profile it would write does not pass director-profile check:")
            sys.stderr.write(shown)
            return 1
        saved = backup(target) if os.path.exists(target) else None
        os.chmod(tmp, 0o644)
        os.replace(tmp, target)
        tmp = None
    finally:
        if tmp and os.path.exists(tmp):
            os.unlink(tmp)
    print("wrote %s" % target)
    if saved:
        print("backup kept: %s" % saved)
    if not teams:
        print("no entry role named: routing into a team is refused until an entry role is named")
    ok, shown = check_profile(target)
    sys.stdout.write(shown)
    if not ok:
        err("the profile just written does not pass director-profile check")
        return 1
    for where, kind in shadow_scan():
        print("%s: %s" % (where, kind) if kind == "wraps" else "shadow: %s: %s" % (where, kind))
    return 0


# ---- --check ----

def do_check(opts):
    target = profile_path(opts["profile"])
    drift = []
    fleet = None
    if not os.path.isfile(target):
        drift.append("no profile file at %s (run director-init)" % target)
    else:
        ok, shown = check_profile(target)
        if not ok:
            drift.append("the profile does not pass director-profile check:\n%s" % shown.rstrip())
        else:
            with open(target, "rb") as fh:
                fleet = tomllib.load(fh).get("fleet_sources", ["bus-presence"])
    if fleet is not None:
        marvel = detect()["marvel"] is not None
        if marvel and "marvel-register" not in fleet:
            drift.append("marvel is found but marvel-register is not in fleet_sources")
        if not marvel and "marvel-register" in fleet:
            drift.append("fleet_sources has marvel-register but marvel is not found")
    for label, name in (("the launcher", "director-session"), ("director-profile", "director-profile")):
        path = os.path.join(dhome(), "bin", name)
        if not (os.path.isfile(path) and os.access(path, os.X_OK)):
            drift.append("%s is missing: %s" % (label, path))
    infos = []
    for where, kind in shadow_scan():
        if kind == "wraps":
            infos.append("info: %s: wraps" % where)
        else:
            drift.append("%s: %s" % (where, kind))
    for ln in infos:
        print(ln)
    for d in drift:
        print("drift: %s" % d)
    if not drift:
        print("clean")
    return 1 if drift else 0


# ---- --schedule (slice 16) ----

SCHEDULE_LABEL = "com.arcaven.director-tick"
CRON_MARK = "# director-tick"
DEFAULT_TICK_MINUTES = 30


def tick_minutes(target):
    """tick_interval from the profile's [loop], else the default (director-profile check has passed it)."""
    with open(target, "rb") as fh:
        n = tomllib.load(fh).get("loop", {}).get("tick_interval", DEFAULT_TICK_MINUTES)
    return n


def plist_text(tick, minutes):
    return (
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
        '<plist version="1.0">\n<dict>\n'
        "  <key>Label</key>\n  <string>%s</string>\n"
        "  <key>ProgramArguments</key>\n  <array>\n    <string>%s</string>\n  </array>\n"
        "  <key>StartInterval</key>\n  <integer>%d</integer>\n"
        "</dict>\n</plist>\n" % (SCHEDULE_LABEL, tick, minutes * 60)
    )


def cron_line(tick, minutes):
    return "*/%d * * * * %s %s" % (minutes, tick, CRON_MARK)


def set_loop_scheduler(text, kind):
    """The profile text with [loop] scheduler set to kind: the line replaced, added under [loop], or a [loop] table appended."""
    line = 'scheduler = "%s"' % kind
    lines = text.splitlines()
    table, header_at = None, None
    for i, raw in enumerate(lines):
        stripped = raw.strip()
        if stripped.startswith("["):
            table = stripped
            if stripped == "[loop]":
                header_at = i
        elif table == "[loop]" and re.match(r"^scheduler\s*=", stripped):
            lines[i] = line
            return "\n".join(lines) + "\n"
    if header_at is not None:
        lines.insert(header_at + 1, line)
        return "\n".join(lines) + "\n"
    return "\n".join(lines) + "\n\n[loop]\n" + line + "\n"


def write_profile_scheduler(target, kind):
    """Atomically set scheduler in the profile, after check passes, keeping a backup. Returns (changed, backup)."""
    with open(target, encoding="utf-8") as fh:
        old = fh.read()
    new = set_loop_scheduler(old, kind)
    if new == old:
        return False, None
    fd, tmp = tempfile.mkstemp(prefix=".operating-profile.", suffix=".tmp", dir=os.path.dirname(os.path.abspath(target)))
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(new)
            fh.flush()
            os.fsync(fh.fileno())
        ok, shown = check_profile(tmp)
        if not ok:
            err("the profile with the scheduler set does not pass director-profile check:")
            sys.stderr.write(shown)
            return None, None
        saved = backup(target)
        os.chmod(tmp, 0o644)
        os.replace(tmp, target)
        tmp = None
    finally:
        if tmp and os.path.exists(tmp):
            os.unlink(tmp)
    return True, saved


def default_scheduler():
    return "launchd" if sys.platform == "darwin" else "cron"


def install_launchd(tick, minutes):
    path = os.path.join(home(), "Library", "LaunchAgents", SCHEDULE_LABEL + ".plist")
    want = plist_text(tick, minutes)
    if os.path.exists(path):
        with open(path, encoding="utf-8", errors="replace") as fh:
            have = fh.read()
        if have == want:
            print("already installed: %s" % path)
            return True
        err("a different file is already at %s; it is left alone (remove it first to install this entry)" % path)
        return False
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".plist.", suffix=".tmp", dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(want)
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
        tmp = None
    finally:
        if tmp and os.path.exists(tmp):
            os.unlink(tmp)
    try:
        res = subprocess.run(["launchctl", "load", "-w", path], capture_output=True, text=True, timeout=TOOL_TIMEOUT)
        loaded = res.returncode == 0
        why = (res.stderr or res.stdout).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        loaded, why = False, str(e)
    if not loaded:
        os.unlink(path)
        err("launchctl load -w %s failed (%s); the plist was removed again" % (path, why or "no message"))
        return False
    print("installed: %s" % path)
    return True


def install_cron(tick, minutes):
    line = cron_line(tick, minutes)
    try:
        res = subprocess.run(["crontab", "-l"], capture_output=True, text=True, timeout=TOOL_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as e:
        err("crontab -l failed: %s" % e)
        return False
    if res.returncode == 0:
        old = res.stdout
    elif "no crontab" in res.stderr.lower():
        old = ""
    else:
        err("crontab -l failed (exit %d): %s" % (res.returncode, res.stderr.strip()))
        return False
    marked = [l for l in old.splitlines() if CRON_MARK in l]
    if marked:
        if marked == [line]:
            print("already installed: one %s line in the crontab" % CRON_MARK)
            return True
        err("the crontab already has a %s line that differs from this entry; it is left alone" % CRON_MARK)
        return False
    new = old + ("" if old == "" or old.endswith("\n") else "\n") + line + "\n"
    try:
        res = subprocess.run(["crontab", "-"], input=new, capture_output=True, text=True, timeout=TOOL_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as e:
        err("crontab - failed: %s" % e)
        return False
    if res.returncode != 0:
        err("crontab - failed (exit %d): %s" % (res.returncode, res.stderr.strip()))
        return False
    print("installed: one %s line added to the crontab" % CRON_MARK)
    return True


def do_schedule(opts):
    target = profile_path(opts["profile"])
    if not os.path.isfile(target):
        err("no profile at %s (run director-init first)" % target)
        return 1
    ok, shown = check_profile(target)
    if not ok:
        err("the profile does not pass director-profile check:")
        sys.stderr.write(shown)
        return 1
    kind = opts["scheduler"] or default_scheduler()
    if kind not in ("launchd", "cron"):
        err("--scheduler must be launchd or cron (a systemd timer is not built)")
        return 2
    minutes = tick_minutes(target)
    if kind == "cron" and not 1 <= minutes <= 59:
        err("cron cannot run every %d minutes from tick_interval: it must be 1 to 59 (the limit of */N); nothing installed" % minutes)
        return 1
    tick = os.path.join(os.path.dirname(os.path.realpath(__file__)), "director-tick")
    entry = plist_text(tick, minutes) if kind == "launchd" else cron_line(tick, minutes) + "\n"
    print("scheduler: %s, every %d minutes, running %s" % (kind, minutes, tick))
    sys.stdout.write(entry)
    if not opts["yes"]:
        print("not installed: pass --yes to install this entry and record scheduler = \"%s\" in %s" % (kind, target))
        return 0
    if not (install_launchd(tick, minutes) if kind == "launchd" else install_cron(tick, minutes)):
        return 1
    changed, saved = write_profile_scheduler(target, kind)
    if changed is None:
        return 1
    if changed:
        print("profile: scheduler = \"%s\" in %s" % (kind, target))
        print("backup kept: %s" % saved)
    return 0


def usage():
    err("usage: director-init [--profile FILE] [--entry-role ROLE] [--team GLOB=ROLE]... [--yes] | --check [--profile FILE] | --schedule [--scheduler launchd|cron] [--profile FILE] [--yes]")
    return 2


def main(argv):
    opts = {"profile": None, "teams": [], "yes": False, "check": False, "schedule": False, "scheduler": None}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            sys.stdout.write(__doc__)
            return 0
        if a == "--check":
            opts["check"] = True
        elif a == "--yes":
            opts["yes"] = True
        elif a == "--schedule":
            opts["schedule"] = True
        elif a in ("--profile", "--scheduler", "--entry-role", "--team", "--manifests"):
            if a == "--manifests":
                err("not in the first build: --manifests")
                return 2
            if i + 1 >= len(argv):
                return usage()
            i += 1
            if a == "--profile":
                opts["profile"] = argv[i]
            elif a == "--scheduler":
                opts["scheduler"] = argv[i]
            else:
                opts["teams"].append((a, argv[i]))
        else:
            return usage()
        i += 1
    if opts["scheduler"] and not opts["schedule"]:
        return usage()
    if opts["schedule"]:
        return do_schedule(opts)
    return do_check(opts) if opts["check"] else do_init(opts)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
