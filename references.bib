% References for director/_kos findings.
% Format follows the orchestrator's references.bib: a note field states what
% the source contributes, in my own words. External sources are quarantined
% data, cited and summarized, never pasted wholesale.

@article{simon1962architecture,
  author = {Simon, Herbert A.},
  title = {The Architecture of Complexity},
  journal = {Proceedings of the American Philosophical Society},
  volume = {106},
  number = {6},
  year = {1962},
  url = {https://faculty.sites.iastate.edu/tesfatsi/archive/tesfatsi/ArchitectureOfComplexity.HSimon1962.pdf},
  note = {Hierarchy and near-decomposability as the common properties of complex systems: interactions within a subsystem exceed interactions between subsystems. The watchmaker parable argues that systems built from stable subassemblies evolve faster than monolithic ones. Supplies the test for where to cut a fleet into teams, and, with bounded rationality, the reason a coordination hierarchy exists at all.}
}

@book{ashby1956cybernetics,
  author = {Ashby, W. Ross},
  title = {An Introduction to Cybernetics},
  publisher = {Chapman and Hall},
  year = {1956},
  note = {The law of requisite variety: a regulator must command at least as much variety as the system it regulates. Read against a fleet, staffing a role with more workers is variety amplification and is the structural answer to a saturated role.}
}

@book{beer1979heart,
  author = {Beer, Stafford},
  title = {The Heart of Enterprise},
  publisher = {John Wiley and Sons},
  year = {1979},
  url = {https://metaphorum.org/staffords-work/viable-system-model},
  note = {The Viable System Model: System 1 operations, System 2 coordination, System 3 control with the 3* audit channel, System 4 intelligence, System 5 policy and identity. Recursive, so a team is a viable system inside a larger one, matching director/supervisor/worker nesting. System 3* is the warrant for auditing actual pane state rather than trusting reported presence. Separating System 3 (inside and now) from System 4 (outside and future) is the prior-art form of the director boundary.}
}

@techreport{usarmy2019adp60,
  author = {{Headquarters, Department of the Army}},
  title = {{ADP 6-0}: Mission Command: Command and Control of Army Forces},
  institution = {United States Army},
  year = {2019},
  url = {https://irp.fas.org/doddir/army/adp6_0.pdf},
  note = {Mission command is the exercise of authority using mission orders to enable disciplined initiative within the commander's intent. Six principles: cohesive teams built on mutual trust, shared understanding, clear commander's intent, disciplined initiative, mission orders, prudent risk. Commander's intent states purpose and desired end state so subordinates can act when the plan does not survive contact. Doctrine traces to Auftragstaktik. This is the delegation contract for director-to-supervisor tasking.}
}

@article{graicunas1933relationship,
  author = {Graicunas, V. A.},
  title = {Relationship in Organisation},
  journal = {Bulletin of the International Management Institute},
  year = {1933},
  url = {https://www.nickols.us/graicunas.pdf},
  note = {Counts direct, cross, and group relationships a superior must hold, giving R = n(2^(n-1) + n - 1). Five subordinates yield 100 relationships, six yield 244. Recommended a maximum of five; Urwick popularized five or six. Not empirical, and it ignores interaction frequency; later studies found working medians nearer ten with maxima around fourteen. The number is soft but the shape holds: attention cost grows faster than headcount.}
}

@book{baldwin2000designrules,
  author = {Baldwin, Carliss Y. and Clark, Kim B.},
  title = {Design Rules, Volume 1: The Power of Modularity},
  publisher = {MIT Press},
  year = {2000},
  url = {https://direct.mit.edu/books/monograph/1856/Design-Rules-Volume-1The-Power-of-Modularity},
  note = {Modularity's value is option value: hidden modules can be replaced independently with superior later solutions, while visible design rules are what hidden-module designers must obey. Formalized with the design structure matrix and a net option value calculation, and connected to Parnas information hiding. Mapped to a fleet, the design rules are the addressing scheme, the envelope, and the grant model; teams are the hidden modules.}
}

@article{conway1968committees,
  author = {Conway, Melvin E.},
  title = {How Do Committees Invent?},
  journal = {Datamation},
  volume = {14},
  number = {4},
  year = {1968},
  note = {Organizations produce designs that copy their own communication structures. Read forward rather than backward, a fleet whose addressing is ambiguous and whose teams cannot route to each other will grow an organization shaped by those two defects.}
}
