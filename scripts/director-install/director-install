#!/usr/bin/env bash
# Install director components from a commit, not from a working tree, so a merge
# becomes live on a host with one command and no checkout.
#
#   director-install cast-launch [--ref REF]   install the launcher at REF
#                                              (default origin/main)
#   director-install cast-launch --rollback    switch back to the previous install
#   director-install director-mcp --ref REF    build the shim at REF and install it
#   director-install director-mcp --release TAG|latest-alpha
#                                              install a published release, no Go needed
#   director-install director-mcp --rollback   switch the shim back to the previous install
#   director-install --status                  what is installed and how far behind
#   director-install -h | --help
#
# How an install works (design: the launcher distribution recommendation of
# 2026-09-27, ruling L1):
#   1. fetch into a bare mirror at $DIRECTOR_HOME/src/director.git;
#   2. write `git archive REF sim/twin` into $DIRECTOR_HOME/lib/cast-launch/<sha>/
#      with a STAMP recording sha, ref, source URL and install time;
#   3. run that directory's verify-cast-launch.sh against that directory's
#      launcher;
#   4. only if the verify passes, switch $DIRECTOR_HOME/bin/cast-launch to it:
#      a new symlink under a temporary name, then a rename over the old one, so
#      a spawn never runs a mix of two versions.
# The previous version directory stays, and --rollback switches back to it.
# git archive reads the commit, so a dirty working tree cannot leak in.
#
# The shim, director-mcp, installs the same way from a commit: the recipe at that
# commit (scripts/build-director-mcp) builds it from `git archive`, stamped with
# the commit, into $DIRECTOR_HOME/lib/director-mcp/<sha>/. Two checks run on the
# built file before the switch, which starts no shim (it would join
# the bus): `director-mcp --version`, run guarded (it exits before any config
# or connection), must report rev <sha>. $DIRECTOR_HOME/bin/director-mcp then switches
# atomically. A binary or symlink already there that this installer did not put
# there is kept under lib/director-mcp/legacy-<time>/, and --rollback returns to
# the one that was live before.
#
# A published release installs with curl and gh, and no Go: --release TAG fetches
# the host's binary, checksums.txt and the attestation bundle from the release,
# then, in order and stopping at the first failure with nothing switched:
#   1. the binary's sha256 must match its line in checksums.txt (the bytes arrived
#      whole; both files come from one place, so this proves nothing about origin);
#   2. `gh attestation verify` must accept the binary against this repository, the
#      release workflow run from refs/heads/main (the workflow runs only on a push to
#      main, so another ref is refused) and the bundle (the origin). With no gh the install stops
#      and says so; nothing weaker is offered;
#   3. the guarded --version run as above, which must report a full rev, and for
#      an alpha tag the commit the tag names.
# The STAMP records the tag, the commit, the channel and origin=verified, and
# --status shows them. `latest-alpha` resolves once, to the newest alpha tag in
# the releases listing, and the STAMP keeps that tag. Nothing upgrades by itself.
#
# The release also carries the seat wrapper, director-mcp-seat, covered by the same
# checksum and attestation checks (a failure of either, for either file, refuses the
# whole install). It is installed beside the shim, under lib/director-mcp/<sha>/, and
# $DIRECTOR_HOME/bin/director-mcp-seat is a link into it that moves with the shim,
# --rollback included. Three rules for that link:
#   - A release from before the wrapper installs the shim, records seat=absent, and
#     keeps the seat link where it is, saying which release the live wrapper is
#     from; with no seat link, none is made and the output says none is installed.
#   - A seat link this installer did not make (a symlink into a checkout, say) is
#     left alone, though the shim's own foreign link is kept and replaced. The two
#     differ on purpose: the shim is what this installer exists to install, while a
#     seat wrapper that a person pointed somewhere is theirs until they ask for it
#     (an opt-in --seat is deferred, not built, so no output names it).
#   - A later prune of old lib/director-mcp/<sha>/ directories must never remove one
#     that a live seat link points into, even when the shim link has moved on.
#
# --status is a diagnostic, not a gate (diagnostic-not-gate.md): it always exits
# 0. The one pass/fail step is the verify before the switch, which is a
# structural check on the artifact being installed.
#
# Environment:
#   DIRECTOR_HOME           default ~/.director
#   DIRECTOR_SRC_URL        default https://github.com/ArcavenAE/director.git
#                           (used only to create the mirror)
#   DIRECTOR_MANIFESTS_DIR  default ~/.marvel/manifests (--status wrapper check)
#   DIRECTOR_REPO           default ArcavenAE/director (the repository --release verifies against)
#   DIRECTOR_RELEASE_BASE   default https://github.com/ArcavenAE/director/releases/download
#   DIRECTOR_RELEASES_API   default https://api.github.com/repos/ArcavenAE/director/releases?per_page=30
set -euo pipefail

DIRECTOR_HOME="${DIRECTOR_HOME:-$HOME/.director}"
SRC_URL="${DIRECTOR_SRC_URL:-https://github.com/ArcavenAE/director.git}"
MANIFESTS="${DIRECTOR_MANIFESTS_DIR:-$HOME/.marvel/manifests}"
REPO="${DIRECTOR_REPO:-ArcavenAE/director}"
RELEASE_BASE="${DIRECTOR_RELEASE_BASE:-https://github.com/$REPO/releases/download}"
RELEASES_API="${DIRECTOR_RELEASES_API:-https://api.github.com/repos/$REPO/releases?per_page=30}"
RELEASE_WORKFLOW=".github/workflows/release-director-mcp.yml"
MIRROR="$DIRECTOR_HOME/src/director.git"
LIB="$DIRECTOR_HOME/lib/cast-launch"
BIN="$DIRECTOR_HOME/bin"
LINK="$BIN/cast-launch"
MLIB="$DIRECTOR_HOME/lib/director-mcp"
MLINK="$BIN/director-mcp"

die() { echo "director-install: $*" >&2; exit 1; }
usage() { sed -n '5,13p' "$0" | sed 's/^# \{0,1\}//'; }

# Create the mirror on first use; fetch it otherwise.
sync_mirror() {
  if [[ -d "$MIRROR" ]]; then
    git -C "$MIRROR" fetch -q --prune origin
  else
    mkdir -p "$(dirname "$MIRROR")"
    git clone -q --mirror "$SRC_URL" "$MIRROR"
  fi
}

# REF as the operator says it (origin/main, a branch, a tag, a sha) -> a commit
# in the mirror. A mirror has no remote-tracking refs, so origin/X is refs/heads/X.
resolve() {
  local ref="$1" try="$1"
  [[ "$ref" == origin/* ]] && try="refs/heads/${ref#origin/}"
  git -C "$MIRROR" rev-parse -q --verify "$try^{commit}" 2>/dev/null \
    || git -C "$MIRROR" rev-parse -q --verify "refs/heads/$ref^{commit}" 2>/dev/null \
    || die "cannot resolve ref $ref in $MIRROR"
}

# The sha the link points at now, or empty.
current_sha() {
  local t
  t="$(readlink "$LINK" 2>/dev/null)" || return 0
  basename "$(dirname "$t")"
}

# Point $LINK at a version directory atomically, and remember the one it left.
switch_to() {
  local sha="$1" prev tmp
  prev="$(current_sha)"
  mkdir -p "$BIN"
  tmp="$BIN/.cast-launch.new.$$"
  ln -sfn "$LIB/$sha/cast-launch.sh" "$tmp"
  mv -f "$tmp" "$LINK"
  if [[ -n "$prev" && "$prev" != "$sha" ]]; then
    printf '%s\n' "$prev" > "$LIB/.previous.new.$$"
    mv -f "$LIB/.previous.new.$$" "$LIB/.previous"
  fi
}

install_cast_launch() {
  local ref="$1" sha stage log
  sync_mirror
  sha="$(resolve "$ref")"
  mkdir -p "$LIB"
  if [[ ! -d "$LIB/$sha" ]]; then
    stage="$(mktemp -d "$LIB/.stage.XXXXXX")"
    trap 'rm -rf "$stage"' EXIT
    git -C "$MIRROR" archive "$sha" sim/twin | tar -x -C "$stage" --strip-components 2
    [[ -x "$stage/cast-launch.sh" ]] || die "$ref ($sha) has no executable sim/twin/cast-launch.sh"
    [[ -f "$stage/verify-cast-launch.sh" ]] || die "$ref ($sha) has no sim/twin/verify-cast-launch.sh; refusing an unverified install"
    {
      echo "sha=$sha"
      echo "ref=$ref"
      echo "source=$(git -C "$MIRROR" config --get remote.origin.url)"
      echo "installed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } > "$stage/STAMP"
    log="$stage/verify.log"
    if ! CAST_LAUNCH="$stage/cast-launch.sh" bash "$stage/verify-cast-launch.sh" >"$log" 2>&1; then
      echo "director-install: verify-cast-launch failed for $ref ($sha); nothing was switched. Last lines:" >&2
      tail -5 "$log" >&2
      exit 1
    fi
    mv "$stage" "$LIB/$sha"
    trap - EXIT
    echo "director-install: verified $sha ($(tail -1 "$LIB/$sha/verify.log"))"
  else
    echo "director-install: $sha is already installed and verified"
  fi
  switch_to "$sha"
  echo "director-install: cast-launch -> $sha ($ref)"
}

rollback_cast_launch() {
  local prev
  prev="$(cat "$LIB/.previous" 2>/dev/null || true)"
  [[ -n "$prev" && -d "$LIB/$prev" ]] || die "no previous install to roll back to"
  switch_to "$prev"
  echo "director-install: cast-launch rolled back -> $prev"
}

# --- director-mcp, the shim --------------------------------------------------
# The sha (or legacy-<time>) directory the shim link points at now, or empty.
# Only a link into $MLIB is ours; anything else reads as empty here.
current_mcp() {
  local t
  t="$(readlink "$MLINK" 2>/dev/null)" || return 0
  [[ "$t" == "$MLIB"/*/director-mcp ]] || return 0
  basename "$(dirname "$t")"
}

# Keep what is at the link now when it is not one of ours, as a legacy
# directory, and print its name. A regular file is copied and a foreign
# symlink is recreated, never followed.
keep_legacy_mcp() {
  local name
  [[ -e "$MLINK" || -L "$MLINK" ]] || return 0
  [[ -n "$(current_mcp)" ]] && return 0
  name="legacy-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  mkdir -p "$MLIB/$name"
  cp -P "$MLINK" "$MLIB/$name/director-mcp"
  {
    echo "sha=unknown"
    echo "source=found at $MLINK, not installed by director-install"
    echo "installed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$MLIB/$name/STAMP"
  printf '%s\n' "$name"
}

SLINK="$BIN/director-mcp-seat"

# The sha directory the seat link points into, when this installer made it.
current_seat() {
  local t
  t="$(readlink "$SLINK" 2>/dev/null)" || return 0
  [[ "$t" == "$MLIB"/*/director-mcp-seat ]] || return 0
  basename "$(dirname "$t")"
}

# Move the seat link to this version's wrapper, unless a person made the link.
switch_seat() {
  local sha="$1" tmp
  [[ -e "$MLIB/$sha/director-mcp-seat" ]] || return 0
  if [[ -e "$SLINK" || -L "$SLINK" ]] && [[ -z "$(current_seat)" ]]; then
    echo "director-install: $SLINK was not installed by director-install; left in place"
    return 0
  fi
  tmp="$BIN/.director-mcp-seat.new.$$"
  ln -sfn "$MLIB/$sha/director-mcp-seat" "$tmp"
  mv -f "$tmp" "$SLINK"
}

switch_mcp() {
  local sha="$1" prev tmp
  mkdir -p "$BIN" "$MLIB"
  prev="$(current_mcp)"
  [[ -n "$prev" ]] || prev="$(keep_legacy_mcp)"
  tmp="$BIN/.director-mcp.new.$$"
  ln -sfn "$MLIB/$sha/director-mcp" "$tmp"
  mv -f "$tmp" "$MLINK"
  if [[ -n "$prev" && "$prev" != "$sha" ]]; then
    printf '%s\n' "$prev" > "$MLIB/.previous.new.$$"
    mv -f "$MLIB/.previous.new.$$" "$MLIB/.previous"
  fi
  switch_seat "$sha"
}

install_director_mcp() {
  local ref="$1" sha stage recipe built info version
  command -v go >/dev/null 2>&1 || die "go is not on PATH; the shim is built from source (--ref)"
  sync_mirror
  sha="$(resolve "$ref")"
  mkdir -p "$MLIB"
  if [[ -d "$MLIB/$sha" ]]; then
    echo "director-install: $sha is already installed and checked"
  else
    stage="$(mktemp -d "$MLIB/.stage.XXXXXX")"
    trap 'rm -rf "$stage"' EXIT
    recipe="$stage/build-director-mcp"
    git -C "$MIRROR" show "$sha:scripts/build-director-mcp" > "$recipe" 2>/dev/null \
      || die "$ref ($sha) has no scripts/build-director-mcp; refusing an unstamped build. Nothing was switched."
    built="$stage/director-mcp"
    bash "$recipe" --git-dir "$MIRROR" --sha "$sha" --out "$built" >"$stage/build.log" 2>&1 \
      || { echo "director-install: the build failed for $ref ($sha); nothing was switched. Last lines:" >&2; tail -5 "$stage/build.log" >&2; exit 1; }
    [[ -x "$built" ]] || die "the build wrote no executable for $ref ($sha); nothing was switched"
    # --version prints one line and exits before any config or connection, so
    # this run cannot join the bus. A guard anyway: stdin from /dev/null, a
    # 5-second alarm, and a broker address nobody listens on.
    info="$(env -i PATH="$PATH" NATS_URL=nats://127.0.0.1:1 perl -e 'alarm 5; exec @ARGV or die "exec $ARGV[0]: $!\n"' "$built" --version </dev/null 2>&1)" \
      || die "the built shim did not run --version cleanly for $ref ($sha); nothing was switched. Output: $info"
    [[ "$info" == "director-mcp "*" rev $sha channel "* ]] \
      || die "the built shim does not report rev $sha (it said: $info); nothing was switched"
    version="$(awk '{print $2}' <<<"$info")"
    {
      echo "sha=$sha"
      echo "version=${version:-unknown}"
      echo "ref=$ref"
      echo "source=$(git -C "$MIRROR" config --get remote.origin.url)"
      echo "installed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } > "$stage/STAMP"
    rm -f "$recipe"
    mv "$stage" "$MLIB/$sha"
    trap - EXIT
    echo "director-install: built and checked $sha (${version:-unknown})"
  fi
  switch_mcp "$sha"
  echo "director-install: director-mcp -> $sha ($ref)"
}

# --- director-mcp from a published release ------------------------------------
sha256_of() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  else sha256sum "$1" | awk '{print $1}'; fi
}

# The newest alpha tag in the releases listing, chosen by its stamp and by
# nothing else: not by position, and not a stable tag or another project's.
latest_alpha_tag() {
  local listing tag
  listing="$(curl -fsSL --max-time 30 "$RELEASES_API")" \
    || die "could not read the releases listing at $RELEASES_API; nothing was switched"
  tag="$(printf '%s\n' "$listing" | grep -o '"tag_name": *"director-mcp-alpha-[0-9]\{8\}-[0-9]\{6\}-[0-9a-f]\{7\}"' \
    | sed 's/.*"\(director-mcp-alpha-[^"]*\)"/\1/' | LC_ALL=C sort | tail -n 1 || true)"
  [[ -n "$tag" ]] || die "no director-mcp alpha release in the listing at $RELEASES_API; nothing was switched"
  printf '%s\n' "$tag"
}

install_director_mcp_release() {
  local tag="$1" os arch asset stage want got info rc rev version channel t7 seat_state=absent code subj live
  command -v curl >/dev/null 2>&1 || die "curl is not on PATH; a release is downloaded with curl. Nothing was switched."
  command -v shasum >/dev/null 2>&1 || command -v sha256sum >/dev/null 2>&1 \
    || die "neither shasum nor sha256sum is on PATH; a download is checked against checksums.txt. Nothing was switched."
  # The origin check needs gh with its attestation command (gh 2.49 or later); say which
  # is missing before anything is downloaded.
  command -v gh >/dev/null 2>&1 \
    || die "gh is not on PATH, so the origin of a release cannot be verified. Install gh (https://cli.github.com), or build from source with --ref. Nothing was switched."
  gh attestation --help >/dev/null 2>&1 \
    || die "this gh has no attestation command (gh 2.49 or later is needed to verify where a release came from). Update gh, or build from source with --ref. Nothing was switched."
  if [[ "$tag" == latest-alpha ]]; then tag="$(latest_alpha_tag)"; fi
  [[ "$tag" =~ ^director-mcp-[A-Za-z0-9._-]+$ ]] \
    || die "release tag '$tag' is not a director-mcp tag name (director-mcp-<channel>-...); nothing was downloaded"
  case "$(uname -s)" in Darwin) os=darwin ;; Linux) os=linux ;; *) die "no release binary for $(uname -s)" ;; esac
  case "$(uname -m)" in arm64|aarch64) arch=arm64 ;; x86_64|amd64) arch=amd64 ;; *) die "no release binary for $(uname -m)" ;; esac
  asset="director-mcp-$os-$arch"
  mkdir -p "$MLIB"
  stage="$(mktemp -d "$MLIB/.stage.XXXXXX")"
  trap 'rm -rf "$stage"' EXIT
  for t7 in "$asset" checksums.txt attestations.sigstore.json; do
    curl -fsSL --max-time 300 -o "$stage/$t7" "$RELEASE_BASE/$tag/$t7" \
      || die "download of $t7 from $RELEASE_BASE/$tag failed; nothing was switched"
  done
  # The seat wrapper is part of a release from the wrapper's own release on; an older
  # release answers 404 and installs without it.
  code="$(curl -sSL --max-time 300 -o "$stage/director-mcp-seat" -w '%{http_code}' "$RELEASE_BASE/$tag/director-mcp-seat")" || code=000
  case "$code" in
    200) seat_state=included ;;
    404) rm -f "$stage/director-mcp-seat" ;;
    *) die "download of director-mcp-seat from $RELEASE_BASE/$tag failed (HTTP $code); nothing was switched" ;;
  esac
  # 1. the bytes arrived whole.
  want="$(awk -v n="$asset" '$2 == n {print $1}' "$stage/checksums.txt")"
  [[ -n "$want" ]] || die "checksums.txt of $tag has no line for $asset; nothing was switched"
  got="$(sha256_of "$stage/$asset")"
  [[ "$got" == "$want" ]] || die "checksum mismatch for $asset of $tag (checksums.txt says $want, the download is $got); nothing was switched"
  if [[ "$seat_state" == included ]]; then
    want="$(awk '$2 == "director-mcp-seat" {print $1}' "$stage/checksums.txt")"
    [[ -n "$want" ]] || die "checksums.txt of $tag has no line for director-mcp-seat; nothing was switched"
    got="$(sha256_of "$stage/director-mcp-seat")"
    [[ "$got" == "$want" ]] || die "checksum mismatch for director-mcp-seat of $tag (checksums.txt says $want, the download is $got); nothing was switched"
  fi
  # 2. the bytes came from this repository's release workflow.
  for subj in "$asset" director-mcp-seat; do
    [[ "$subj" == director-mcp-seat && "$seat_state" != included ]] && continue
    gh attestation verify "$stage/$subj" --repo "$REPO" --signer-workflow "$REPO/$RELEASE_WORKFLOW" \
        --source-ref refs/heads/main --bundle "$stage/attestations.sigstore.json" >"$stage/verify.log" 2>&1 \
      || { echo "director-install: the origin check (gh attestation verify) rejected $subj of $tag; nothing was switched. Last lines:" >&2; tail -5 "$stage/verify.log" >&2; exit 1; }
  done
  # 3. the first run, guarded as --ref's is, only after the origin is shown.
  chmod +x "$stage/$asset"
  rc=0
  info="$(env -i PATH="$PATH" NATS_URL=nats://127.0.0.1:1 perl -e 'alarm 5; exec @ARGV or die "exec $ARGV[0]: $!\n"' "$stage/$asset" --version </dev/null 2>&1)" || rc=$?
  if [[ $rc -eq 142 ]]; then die "the shim timed out on --version (stopped after 5 seconds) for $tag; nothing was switched"; fi
  [[ $rc -eq 0 ]] || die "the shim did not run --version cleanly for $tag; nothing was switched. Output: $info"
  [[ "$info" =~ ^director-mcp\ ([^\ ]+)\ rev\ ([0-9a-f]{40})\ channel\ ([^\ ]+)$ ]] \
    || die "the shim's --version line is not 'director-mcp <version> rev <sha> channel <channel>' (it said: $info); nothing was switched"
  version="${BASH_REMATCH[1]}" rev="${BASH_REMATCH[2]}" channel="${BASH_REMATCH[3]}"
  if [[ "$tag" =~ ^director-mcp-alpha-[0-9]{8}-[0-9]{6}-([0-9a-f]{7})$ && "${rev:0:7}" != "${BASH_REMATCH[1]}" ]]; then
    die "the shim reports rev $rev but $tag names commit ${BASH_REMATCH[1]}; nothing was switched"
  fi
  if [[ -d "$MLIB/$rev" ]]; then
    echo "director-install: $rev is already installed and checked"
  else
    mv "$stage/$asset" "$stage/director-mcp"
    [[ "$seat_state" == included ]] && chmod +x "$stage/director-mcp-seat"
    rm -f "$stage/checksums.txt" "$stage/attestations.sigstore.json" "$stage/verify.log"
    {
      echo "sha=$rev"
      echo "version=$version"
      echo "channel=$channel"
      echo "ref=$tag"
      echo "release=$tag"
      echo "origin=verified"
      echo "seat=$seat_state"
      echo "origin_check=gh attestation verify, repo $REPO, workflow $RELEASE_WORKFLOW, ref refs/heads/main"
      echo "source=$RELEASE_BASE/$tag"
      echo "installed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    } > "$stage/STAMP"
    mv "$stage" "$MLIB/$rev"
    echo "director-install: fetched and checked $rev ($version) from $tag"
  fi
  trap - EXIT
  rm -rf "$stage" 2>/dev/null || true
  switch_mcp "$rev"
  echo "director-install: director-mcp -> $rev ($tag)"
  if [[ ! -e "$MLIB/$rev/director-mcp-seat" ]]; then
    live="$(current_seat)"
    if [[ -n "$live" ]]; then
      echo "director-install: $tag has no director-mcp-seat; the live director-mcp-seat is from $(sed -n 's/^release=//p' "$MLIB/$live/STAMP" 2>/dev/null) (${live:0:12})"
    elif [[ -e "$SLINK" || -L "$SLINK" ]]; then
      echo "director-install: $tag has no director-mcp-seat; the one at $SLINK was not installed by director-install and is left in place"
    else
      echo "director-install: $tag has no director-mcp-seat and none is installed"
    fi
  fi
}

rollback_director_mcp() {
  local prev
  prev="$(cat "$MLIB/.previous" 2>/dev/null || true)"
  [[ -n "$prev" && -e "$MLIB/$prev/director-mcp" ]] || die "no previous director-mcp install to roll back to"
  switch_mcp "$prev"
  echo "director-install: director-mcp rolled back -> $prev"
}

# --- status: a diagnostic; every path below exits 0 --------------------------
status() {
  set +e  # a diagnostic reports what it cannot read; it never stops on it
  local sha stamp installed ref behind fetched=yes
  if [[ -d "$MIRROR" ]]; then
    git -C "$MIRROR" fetch -q --prune origin 2>/dev/null || fetched=no
  fi
  sha="$(current_sha)"
  if [[ -z "$sha" ]]; then
    echo "cast-launch: not installed (install: director-install cast-launch --ref origin/main)"
  else
    stamp="$LIB/$sha/STAMP"
    installed="$(sed -n 's/^installed_at=//p' "$stamp" 2>/dev/null)"
    ref="$(sed -n 's/^ref=//p' "$stamp" 2>/dev/null)"
    if [[ -d "$MIRROR" ]] && behind="$(git -C "$MIRROR" rev-list --count "$sha..refs/heads/main" -- sim/twin/ 2>/dev/null)"; then
      echo "cast-launch: ${sha:0:12} (ref ${ref:-?}) installed ${installed:-?}; $behind sim/twin/ commits behind main"
    else
      echo "cast-launch: ${sha:0:12} (ref ${ref:-?}) installed ${installed:-?}; lag unknown (no mirror, or main not in it)"
    fi
    [[ "$fetched" == no ]] && echo "WARN: fetch failed; the count is against the mirror as last fetched"
  fi
  local msha
  msha="$(current_mcp)"
  if [[ -n "$msha" ]]; then
    local rel org
    rel="$(sed -n 's/^release=//p' "$MLIB/$msha/STAMP" 2>/dev/null)"
    org="$(sed -n 's/^origin=//p' "$MLIB/$msha/STAMP" 2>/dev/null)"
    echo "director-mcp: ${msha:0:12} ($(sed -n 's/^version=//p' "$MLIB/$msha/STAMP" 2>/dev/null)) installed $(sed -n 's/^installed_at=//p' "$MLIB/$msha/STAMP" 2>/dev/null)${rel:+, release $rel, origin ${org:-not recorded}}"
  elif [[ -e "$MLINK" || -L "$MLINK" ]]; then
    echo "WARN: $MLINK was not installed by director-install; install: director-install director-mcp --ref origin/main"
  else
    echo "director-mcp: not installed (install: director-install director-mcp --ref origin/main)"
  fi
  local ssha
  ssha="$(current_seat)"
  if [[ -n "$ssha" ]]; then
    echo "director-mcp-seat: ${ssha:0:12} (release $(sed -n 's/^release=//p' "$MLIB/$ssha/STAMP" 2>/dev/null))${msha:+$([[ "$ssha" == "$msha" ]] || echo "; from a different release than the shim")}"
  fi
  # Wrappers that still exec a checkout are how staleness hides.
  if [[ -d "$MANIFESTS" ]]; then
    local f
    while IFS= read -r f; do
      echo "WARN: $f execs a checkout path (sim/twin/cast-launch.sh), not $LINK"
    done < <(grep -l 'sim/twin/cast-launch\.sh' "$MANIFESTS"/*.sh 2>/dev/null || true)
  fi
  return 0
}

case "${1:-}" in
  cast-launch)
    shift
    ref="origin/main" action=install
    while (($#)); do
      case "$1" in
        --ref) [[ $# -ge 2 ]] || die "--ref needs a value"; ref="$2"; shift ;;
        --rollback) action=rollback ;;
        *) die "unknown argument: $1" ;;
      esac
      shift
    done
    if [[ "$action" == rollback ]]; then rollback_cast_launch; else install_cast_launch "$ref"; fi
    ;;
  director-mcp)
    shift
    ref="origin/main" action=install release="" ref_given=""
    while (($#)); do
      case "$1" in
        --ref) [[ $# -ge 2 ]] || die "--ref needs a value"; ref="$2"; ref_given=1; shift ;;
        --release) [[ $# -ge 2 ]] || die "--release needs a value"; release="$2"; shift ;;
        --rollback) action=rollback ;;
        *) die "unknown argument: $1" ;;
      esac
      shift
    done
    [[ -z "$release" || -z "$ref_given" ]] || die "--release and --ref are not both allowed: a release is downloaded, a ref is built"
    if [[ "$action" == rollback ]]; then rollback_director_mcp
    elif [[ -n "$release" ]]; then install_director_mcp_release "$release"
    else install_director_mcp "$ref"; fi
    ;;
  --status) status || true; exit 0 ;;
  -h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
