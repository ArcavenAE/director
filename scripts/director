#!/usr/bin/env bash
# director start [--cluster <name>] [--resume <session name>] [--seat-file <path>]
# director env [--seat-file <path>]
#
# Starts a Claude Code session as the director, on purpose. The director MCP
# server comes from config/director-mcp.json in this repo, handed to claude with
# --mcp-config, so a session is a director only when it was started here and not
# because of the folder it opened in.
#
# Identity (agent id, cluster, global domain and role, team, workspace, broker
# url) is never in the repo and never in the session folder. It comes from a
# small per-host file, ${DIRECTOR_HOME:-$HOME/.director}/seat.env, or from flags.
# The file is data: only the allowed KEY=value lines are read, and nothing in it
# is executed.
#
#   first start   director start
#   restart       director start --resume director
#   other cluster director start --cluster <name>
#
# The same file also carries three optional settings for the hub observer, which lets a
# plain shell read hub mail with no `director start` session: DIRECTOR_HUB_OBSERVER_URL,
# DIRECTOR_HUB_OBSERVER_NKEY (the absolute path of the seed file, never the seed) and
# DIRECTOR_HUB_OBSERVER_CA (an absolute path). With the URL unset the observer is off.
# `director env` prints the validated KEY=value lines that are set, from the same reader
# as `start`, and starts nothing; it reads no config, so it works from a copy of this
# file with no repo beside it. Exit 3 on a line that is not allowed, naming file and line.
#
# director prove, run inside a session this launcher started, checks that the
# director MCP server is up under that session with the launch id, and writes the
# proof the operator step needs before it removes the old project-local entry.
#
# Exit: 0 claude ran and exited 0 (the exit status of claude is passed through),
# 2 usage, 3 STOP (a required value is missing, the seat file is not valid, or the repo's
# config is not beside this file).
set -euo pipefail

# Where this file really is: installed as a link in $DIRECTOR_HOME/bin, the repo is
# beside the link's target. A readlink loop, since the macOS system bash has no
# readlink -f. A copy has no repo beside it, which `start` reports and `env` does not need.
src="${BASH_SOURCE[0]}"
while [[ -L "$src" ]]; do
  d="$(cd "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" == /* ]] || src="$d/$src"
done
here="$(cd "$(dirname "$src")/.." && pwd)"
config="$here/config/director-mcp.json"
keys=(DIRECTOR_AGENT_ID DIRECTOR_CLUSTER DIRECTOR_GLOBAL_DOMAIN DIRECTOR_GLOBAL_ROLE DIRECTOR_TEAM DIRECTOR_WORKSPACE NATS_URL DIRECTOR_HUB_OBSERVER_URL DIRECTOR_HUB_OBSERVER_NKEY DIRECTOR_HUB_OBSERVER_CA)
required=(DIRECTOR_AGENT_ID DIRECTOR_TEAM DIRECTOR_WORKSPACE)
absolute_paths=(DIRECTOR_HUB_OBSERVER_NKEY DIRECTOR_HUB_OBSERVER_CA)
observer_keys=(DIRECTOR_HUB_OBSERVER_URL DIRECTOR_HUB_OBSERVER_NKEY DIRECTOR_HUB_OBSERVER_CA)

usage() { printf 'usage: director start [--cluster <name>] [--resume <session name>] [--seat-file <path>]\n       director env [--seat-file <path>]\n       director prove\n       director hub user|settings ...   (run on the hub host; see sim/design/hub-user-lifecycle.md)\n' >&2; exit 2; }
stop() { printf 'STOP: %s\n' "$*" >&2; exit 3; }

dhome="${DIRECTOR_HOME:-$HOME/.director}"
state="${DIRECTOR_STATE:-$dhome/state}"
sha() { shasum -a 256 "$1" | cut -d' ' -f1; }

# (Reading another process's environment works for the director-mcp binary, which
# is an ordinary executable. macOS hides it for system-protected binaries.)
# prove: this session was started by `director start`, and the director MCP
# server is running under it with the config's own launch variable. A server the old
# project-local entry started has no launch id, so it cannot satisfy this.
prove() {
  local id="${DIRECTOR_LAUNCH_ID:-}" rec pid rsha cand p found=0
  [[ -n "$id" ]] || stop "no launch id: run this inside a session started by director start"
  [[ "$id" =~ ^[A-Za-z0-9._-]+$ && "$id" != *..* ]] || stop "the launch id is not a plain name"
  rec="$state/launches/$id"
  [[ -f "$rec" ]] || stop "no launch record for this session"
  pid="$(sed -n 's/^pid=//p' "$rec")"; rsha="$(sed -n 's/^config_sha256=//p' "$rec")"
  [[ "$rsha" == "$(sha "$config")" ]] || stop "the MCP config changed since this session started"
  p=$$
  while [[ -n "$p" && "$p" -gt 1 ]]; do
    if [[ "$p" == "$pid" ]]; then found=1; break; fi
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d '[:space:]')"
  done
  [[ "$found" == 1 ]] || stop "this shell is not inside the session the launcher started"
  # Every descendant of the session is a candidate; director-procmatch decides. It reads
  # each process's arguments and environment as separate lists and wants the config's own
  # variable, DIRECTOR_LAUNCH_VIA_CONFIG=<id>. The launch id the session carries itself
  # is inherited by every child, so a server the old project-local entry started would
  # have it too; only the config's env block sets the other.
  command -v python3 >/dev/null 2>&1 || stop "python3 is needed to read a process's environment"
  cand="$(ps -axo pid=,ppid= | awk -v root="$pid" '
    { pp[$1]=$2 }
    END { for (q in pp) { a=q; while (a != "" && a != 0 && a != 1) { if (a == root) { print q; break } a=pp[a] } } }')"
  local q ok=""
  for q in $cand; do
    if "$here/scripts/director-procmatch" --id "$id" --pid "$q" 2>/dev/null; then ok="$q"; break; fi
  done
  [[ -n "$ok" ]] || stop "no director MCP server running under this session with launch id $id"
  mkdir -p "$state"
  printf 'id=%s\nproved=%s\nmcp_pid=%s\nconfig_sha256=%s\n' "$id" "$(date +%s)" "$ok" "$rsha" >"$state/launch-proof.tmp.$$"
  mv "$state/launch-proof.tmp.$$" "$state/launch-proof"
  printf 'PASS the director MCP server (pid %s) is up under this launcher-started session; proof written\n' "$ok"
}

allowed() { local k; for k in "${keys[@]}"; do [[ "$k" == "$1" ]] && return 0; done; return 1; }
is_absolute_path_key() { local k; for k in "${absolute_paths[@]}"; do [[ "$k" == "$1" ]] && return 0; done; return 1; }

# values live in V_<KEY> variables, since the macOS system bash has no associative arrays
get() { local n="V_$1"; printf %s "${!n:-}"; }
put() { printf -v "V_$1" %s "$2"; }
# The one reader of the seat file, shared by `start` and `env`: only allowed KEY=value lines,
# nothing executed, and an observer path must be absolute.
read_seat_file() { # $1 = path
  local seat_file="$1" k n line
  for k in "${keys[@]}"; do unset "V_$k"; done  # nothing the caller exported is identity
  [[ -f "$seat_file" ]] || return 0
  n=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n+1))
    [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]] && continue
    if [[ "$line" =~ ^([A-Z_]+)=([A-Za-z0-9._:/@+-]*)$ ]] && allowed "${BASH_REMATCH[1]}"; then
      if is_absolute_path_key "${BASH_REMATCH[1]}" && [[ -n "${BASH_REMATCH[2]}" && "${BASH_REMATCH[2]}" != /* ]]; then
        stop "$seat_file line $n: ${BASH_REMATCH[1]} must be an absolute path; nothing was run"
      fi
      put "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    else
      stop "$seat_file line $n is not an allowed KEY=value line (keys: ${keys[*]}); nothing was run"
    fi
  done <"$seat_file"
}

case "${1:-}" in
  prove) prove; exit 0 ;;
  env)
    shift
    seat_file="${DIRECTOR_HOME:-$HOME/.director}/seat.env"
    while (($#)); do
      case "$1" in
        --seat-file) [[ $# -ge 2 ]] || usage; seat_file="$2"; shift 2 ;;
        *) usage ;;
      esac
    done
    read_seat_file "$seat_file"
    for k in "${keys[@]}"; do [[ -z "$(get "$k")" ]] || printf '%s=%s\n' "$k" "$(get "$k")"; done
    exit 0 ;;
  hub)
    shift
    [[ -x "$dhome/bin/director-mcp" ]] || stop "no installed director-mcp at $dhome/bin/director-mcp; run director-install first"
    exec "$dhome/bin/director-mcp" hub "$@" ;;
  start) shift ;;
  *) usage ;;
esac

cluster_flag="" resume="" seat_file="${DIRECTOR_HOME:-$HOME/.director}/seat.env"
while (($#)); do
  case "$1" in
    --cluster)   [[ $# -ge 2 ]] || usage; cluster_flag="$2"; shift 2 ;;
    --resume)    [[ $# -ge 2 ]] || usage; resume="$2"; shift 2 ;;
    --seat-file) [[ $# -ge 2 ]] || usage; seat_file="$2"; shift 2 ;;
    *) usage ;;
  esac
done

# A copy of this file with no repo beside it can read a seat file but cannot start a session.
[[ -f "$config" ]] || stop "no director MCP config at $config: this copy has no repo beside it; run director start from the repo's scripts/director or a link to it"

read_seat_file "$seat_file"

if [[ -n "$cluster_flag" ]]; then put DIRECTOR_CLUSTER "$cluster_flag"; fi
if [[ -z "$(get NATS_URL)" ]]; then put NATS_URL nats://127.0.0.1:4222; fi

missing=()
for k in "${required[@]}"; do [[ -n "$(get "$k")" ]] || missing+=("$k"); done
if ((${#missing[@]})); then
  stop "missing ${missing[*]}; put them in $seat_file as KEY=value lines or pass them by flag (--cluster covers DIRECTOR_CLUSTER only)"
fi

for k in "${keys[@]}"; do
  # the observer settings are optional: an unset one is not exported at all
  if [[ " ${observer_keys[*]} " == *" $k "* && -z "$(get "$k")" ]]; then continue; fi
  export "$k=$(get "$k")"
done

export DIRECTOR_MCP_SEAT="$dhome/bin/director-mcp-seat"
id="$(date +%s)-$$"
export DIRECTOR_LAUNCH_ID="$id"
# The role mark (aae-orc-20062): this pid survives the exec below, so it is the
# parent pid of the shim claude starts, and the shim holds the director identity
# only with it.
export DIRECTOR_ROLE_MARK=$$
mkdir -p "$state/launches"
printf 'id=%s\npid=%s\nstarted=%s\nconfig_sha256=%s\nsession=%s\n' "$id" "$$" "$(date +%s)" "$(sha "$config")" "${resume:-director}" >"$state/launches/$id.tmp"
mv "$state/launches/$id.tmp" "$state/launches/$id"

args=(--mcp-config "$config")
if [[ -n "$resume" ]]; then args+=(--resume "$resume"); else args+=(-n director); fi

exec "${CLAUDE_BIN:-claude}" "${args[@]}"
