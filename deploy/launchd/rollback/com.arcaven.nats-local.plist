<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Kept rollback copy of kinu's OLD local broker service file (design KN-4).
  Bead aae-orc-5jpjc.

  At the cutover the old file is moved out of LaunchAgents into a rollback
  directory and booted out, then the marvel-managed broker takes port 4222.
  Rollback reverses those steps. This copy keeps the old restart rule on
  purpose (RunAtLoad, KeepAlive SuccessfulExit=false): it is what rollback
  puts back, not a recommendation. After the cutover kinu's local broker has
  no service file, like mokuzai and corporate.

  RECONSTRUCTED from the facts the design records (label, ports, restart
  rule); the program and conf paths are placeholders. A kinu seat replaces
  them with the exact installed file before the cutover window. Nothing here
  is installed or loaded by this repository.

  Local broker facts (design section 1): client 127.0.0.1:4222, monitor
  127.0.0.1:8222, server_name director-phase0, leaf remote on loopback 7442.
  __HUB_HOME__ stands for the account home and is replaced at install.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.arcaven.nats-local</string>
	<key>ProgramArguments</key>
	<array>
		<string>__LOCAL_NATS_SERVER__</string>
		<string>-c</string>
		<string>__HUB_HOME__/.director/nats-local/nats-server.conf</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>__HUB_HOME__/.director/nats-local/log/local.out.log</string>
	<key>StandardErrorPath</key>
	<string>__HUB_HOME__/.director/nats-local/log/local.err.log</string>
</dict>
</plist>
